{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run env:sync && vite",
    "env:sync": "bash scripts/sync-env-from-gcloud.sh",
    "gen:schemas": "cd ../backend/internal/tools/schemagen && go run .",
    "gen:types": "node scripts/generate-types.mjs",
    "gen:taxonomy:export": "cd ../agents/shared/agenthorde_common && python3 -m scripts.export_taxonomy --out ../../../shared/taxonomy/taxonomy.json",
    "gen:taxonomy": "node scripts/generate-taxonomy.mjs",
    "gen:taxonomy:check": "node scripts/generate-taxonomy.mjs --check",
    "gen:all": "npm run gen:schemas && npm run gen:types && npm run gen:taxonomy:export && npm run gen:taxonomy",
    "build": "npm run env:sync && npm run gen:schemas && npm run gen:types && npm run gen:taxonomy && tsc -b && vite build",
    "build:ci": "tsc -b && vite build",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:only": "firebase deploy --only hosting",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:graph-views": "tsx --test src/lib/graphViews/**/*.test.ts src/lib/materializedPayload.test.ts src/lib/taxonomy.test.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.11",
    "@deck.gl/layers": "^9.2.11",
    "@deck.gl/mapbox": "^9.2.11",
    "@deck.gl/react": "^9.2.11",
    "@fontsource/inter": "^5.2.6",
    "@react-sigma/core": "^5.0.4",
    "@reactflow/controls": "^11.2.14",
    "@reactflow/core": "^11.11.4",
    "@reactflow/minimap": "^11.7.14",
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.83.0",
    "@types/supercluster": "^7.1.3",
    "axios": "^1.11.0",
    "country-flag-icons": "^1.6.4",
    "deck.gl": "^9.2.11",
    "elkjs": "^0.11.0",
    "firebase": "^12.0.0",
    "i18next": "^25.5.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "maplibre-gl": "^5.18.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^16.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.4",
    "react-use-websocket": "^4.13.0",
    "reactflow": "^11.11.4",
    "recharts": "^2.15.4",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "supercluster": "^8.0.1",
    "topojson-client": "^3.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "json-schema-to-typescript": "^13.1.2",
    "msw": "^2.10.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "searoute-js": "^0.1.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
