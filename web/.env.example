# Optional: override API/WS URLs (defaults come from web/scripts/sync-env-from-gcloud.sh or Vite env).
# VITE_API_BASE_URL=https://...
# VITE_WS_BROKER_URL=https://...

# Firebase Web SDK — populate from: firebase apps:sdkconfig WEB (project prevalent-horizon-test)
VITE_FIREBASE_PROJECT_ID=prevalent-horizon-test
VITE_FIREBASE_AUTH_DOMAIN=prevalent-horizon-test.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=prevalent-horizon-test.firebasestorage.app
VITE_FIREBASE_API_KEY=YOUR_WEB_API_KEY
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
