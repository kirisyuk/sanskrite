    "ingestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "vertexSearchIndexedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "sourceId",
    "externalId",
    "documentPath",
    "fullText",
    "status",
    "contentHash",
    "ingestedAt",
    "createdAt",
    "updatedAt"
