{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/igorkirisyuk/sanskrite/internal/models/document",
  "properties": {
    "id": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "externalId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "documentPath": {
      "type": "string"
    },
    "fullText": {
      "type": "string"
    },
    "storagePath": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "contentType": {
      "type": "string"
    },
    "documentType": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
