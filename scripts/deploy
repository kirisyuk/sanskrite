create_indexes() {
  echo -e "${BLUE}[firestore] Creating composite indexes (idempotent)...${NC}"
  local sync_script="$ROOT_DIR/scripts/sync-firestore-indexes.py"
  if [[ -f "$sync_script" ]]; then
    echo -e "${BLUE}[firestore] Syncing composite indexes from web/firestore.indexes.json via gcloud...${NC}"
    if python3 "$sync_script" --project "$PROJECT_ID" --database="(default)" --apply; then
      echo -e "${GREEN}[firestore] ✓${NC} JSON-defined composite indexes submitted"
    else
      echo -e "${YELLOW}[firestore] Warning: JSON-defined composite index sync reported failures${NC}"
    fi
  else
    echo -e "${YELLOW}[firestore] Warning: sync script not found at $sync_script${NC}"
  fi

  # Projects: tenantId + view + lastInteractionAt desc
  gcloud firestore indexes composite create --async \
    --collection-group=core_projects \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=view,order=ASCENDING \
    --field-config field-path=lastInteractionAt,order=DESCENDING \
    --quiet || true
  # DataSources suggestions (uri canonical, channel username)
  gcloud firestore indexes composite create --async \
    --collection-group=core_datasources \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=sourceDetails.uri,order=ASCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=core_datasources \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=sourceDetails.channelUsername,order=ASCENDING \
    --quiet || true
  # Interactions: projectId + createdAt asc (for listing by project with ordering)
  gcloud firestore indexes composite create --async \
    --collection-group=core_interactions \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=createdAt,order=ASCENDING \
    --quiet || true

  # Core docs: tenant+project for quick listing within project, newest first
  gcloud firestore indexes composite create --async \
    --collection-group=core_docs \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true

  # Core docs: lookup by external provider+resource id (optional future use)
  gcloud firestore indexes composite create --async \
    --collection-group=core_docs \
    --field-config field-path=external.provider,order=ASCENDING \
    --field-config field-path=external.resourceId,order=ASCENDING \
    --quiet || true

  # RAG: sourceProjects composites
  gcloud firestore indexes composite create --async \
    --collection-group=rag_source_projects \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=rag_source_projects \
    --field-config field-path=sourceId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --quiet || true

  # RAG: documents lookups
  gcloud firestore indexes composite create --async \
    --collection-group=rag_documents \
    --field-config field-path=sourceId,order=ASCENDING \
    --field-config field-path=originPublishedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=rag_documents \
    --field-config field-path=sourceId,order=ASCENDING \
    --field-config field-path=externalId,order=ASCENDING \
    --quiet || true

  # Meta analyses: events by project (latest first)
  gcloud firestore indexes composite create --async \
    --collection-group=meta_analyses \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true
  # Meta analyses: events by user within tenant (latest first)
  gcloud firestore indexes composite create --async \
    --collection-group=meta_analyses \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=userId,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true

  # Subscriptions: status + currentPeriodEnd for billing queries
  gcloud firestore indexes composite create --async \
    --collection-group=subscriptions \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=currentPeriodEnd,order=ASCENDING \
    --quiet || true

  # Vouchers: tier + isActive + createdAt for admin filtering
  gcloud firestore indexes composite create --async \
    --collection-group=vouchers \
    --field-config field-path=tier,order=ASCENDING \
    --field-config field-path=isActive,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true

  # Horizon strategic recommendations inbox/filtering
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=lensId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=lensId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=lensId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=lensId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true

  # Horizon simulation MVP indexes
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_simulation_runs \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_simulation_worlds \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=runId,order=ASCENDING \
    --field-config field-path=worldIndex,order=ASCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_simulation_worlds \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=runId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_simulation_agents \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=runId,order=ASCENDING \
    --field-config field-path=worldId,order=ASCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_simulation_events \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=runId,order=ASCENDING \
    --field-config field-path=createdAt,order=ASCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_simulation_events \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=runId,order=ASCENDING \
    --field-config field-path=worldId,order=ASCENDING \
    --field-config field-path=createdAt,order=ASCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_simulation_artifacts \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=runId,order=ASCENDING \
    --field-config field-path=createdAt,order=ASCENDING \
    --quiet || true

  # Horizon signal landing summaries: tenant + scopeRef for scope-local Home/Lens retrieval.
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_signal_landing_summaries \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=scopeRef,order=ASCENDING \
    --quiet || true

  # Vector index for rag_chunks.embedding (dimension=1536)
  # Vector fields are created as composite indexes with vector-config
  echo -e "${BLUE}[firestore] Ensuring vector index for rag_chunks.embedding...${NC}"
  # Check if vector index already exists (check for any index with vectorConfig in fields for rag_chunks)
  local has_vector_index=false
  if command -v jq >/dev/null 2>&1; then
    # Get all indexes and filter for rag_chunks with vectorConfig
    local vector_index_count
    vector_index_count=$(gcloud firestore indexes composite list --format=json 2>/dev/null | jq '[.[] | select(.fields[]?.vectorConfig != null and (.name | contains("rag_chunks")))] | length' 2>/dev/null || echo "0")
    if [ "$vector_index_count" -gt 0 ] 2>/dev/null; then
      has_vector_index=true
    fi
  else
    # Fallback: check if any index contains "rag_chunks", "embedding" and "vectorConfig" in JSON
    if gcloud firestore indexes composite list --format=json 2>/dev/null | grep -q 'rag_chunks.*embedding.*vectorConfig' 2>/dev/null; then
      has_vector_index=true
    fi
  fi
  
  if [ "$has_vector_index" = true ]; then
    echo -e "${GREEN}  ✓${NC} Vector index already exists for rag_chunks.embedding"
  else
    echo -e "${BLUE}  Creating vector index...${NC}"
    if gcloud firestore indexes composite create --async \
      --collection-group=rag_chunks \
      --query-scope=COLLECTION \
      --field-config='field-path=embedding,vector-config={"dimension":"1536", "flat": "{}"}' \
      --database="(default)" \
      --project="$PROJECT_ID" \
      --quiet 2>/dev/null; then
      echo -e "${GREEN}  ✓${NC} Vector index created successfully"
      echo -e "${YELLOW}  ⚠${NC} Note: Vector index propagation may take several minutes"
    else
      echo -e "${YELLOW}  ⚠${NC} Failed to create vector index (may require permissions)"
      echo -e "${YELLOW}  ⚠${NC} Create manually: gcloud firestore indexes composite create \\"
      echo -e "${YELLOW}     --collection-group=rag_chunks --query-scope=COLLECTION \\"
      echo -e "${YELLOW}     --field-config='field-path=embedding,vector-config={\"dimension\":\"1536\", \"flat\": \"{}\"}' \\"
      echo -e "${YELLOW}     --database=\"(default)\" --project=$PROJECT_ID"
    fi
  fi

  # Vector index for horizon_fragments.vectorEmbedding (same dimension as rag_chunks)
  echo -e "${BLUE}[firestore] Ensuring vector index for horizon_fragments.vectorEmbedding...${NC}"
  local has_hf_vector=false
  if command -v jq >/dev/null 2>&1; then
    local hf_count
    hf_count=$(gcloud firestore indexes composite list --project="$PROJECT_ID" --format=json 2>/dev/null | jq '[.[] | select(.fields[]?.vectorConfig != null and (.name | contains("horizon_fragments")))] | length' 2>/dev/null || echo "0")
    if [ "$hf_count" -gt 0 ] 2>/dev/null; then
      has_hf_vector=true
    fi
  fi
  if [ "$has_hf_vector" = true ]; then
    echo -e "${GREEN}  ✓${NC} Vector index already exists for horizon_fragments.vectorEmbedding"
  else
    if gcloud firestore indexes composite create --async \
      --collection-group=horizon_fragments \
      --query-scope=COLLECTION \
      --field-config='field-path=vectorEmbedding,vector-config={"dimension":"1536", "flat": "{}"}' \
      --database="(default)" \
      --project="$PROJECT_ID" \
      --quiet 2>/dev/null; then
      echo -e "${GREEN}  ✓${NC} Submitted horizon_fragments vector index (propagation may take minutes)"
    else
      echo -e "${YELLOW}  ⚠${NC} horizon_fragments vector index not created (may already exist or need retry)"
    fi
  fi
  
  # Deploy firestore rules and composite indexes via Firebase CLI.
  # Vector fieldOverrides in firestore.indexes.json break `firebase deploy` (CLI schema); vectors are via gcloud above.
  echo -e "${BLUE}[firestore] Deploying rules and indexes (firestore)...${NC}"
  if [[ -f "$WEB_DIR/firestore.indexes.json" ]] && [[ -f "$WEB_DIR/firestore.rules" ]]; then
    if command -v firebase >/dev/null 2>&1 && [[ -f "$WEB_DIR/firebase.json" ]]; then
      cd "$WEB_DIR"
      local rules_ok=0
      if firebase deploy --only firestore:rules --project "$PROJECT_ID" --non-interactive --force 2>/dev/null; then
        echo -e "${GREEN}  ✓${NC} Firestore rules deployed via Firebase CLI"
        rules_ok=1
      else
        echo -e "${YELLOW}  ⚠${NC} Firebase rules deploy failed"
      fi
      local indexes_ok=0
      if command -v jq >/dev/null 2>&1; then
        local idx_bak idx_tmp
        idx_bak=$(mktemp)
        idx_tmp=$(mktemp)
        cp firestore.indexes.json "$idx_bak"
        jq 'del(.fieldOverrides)' firestore.indexes.json > "$idx_tmp" && cp "$idx_tmp" firestore.indexes.json
        if firebase deploy --only firestore:indexes --project "$PROJECT_ID" --non-interactive --force 2>/dev/null; then
          echo -e "${GREEN}  ✓${NC} Firestore composite indexes deployed via Firebase CLI (vector overrides omitted; use gcloud for vectors)"
          indexes_ok=1
        else
          echo -e "${YELLOW}  ⚠${NC} Firebase indexes deploy failed or partial (idempotent re-run is safe)"
        fi
        mv "$idx_bak" firestore.indexes.json
        rm -f "$idx_tmp"
      else
        echo -e "${YELLOW}  ⚠${NC} jq not installed; skipping Firebase index deploy (install jq or deploy indexes manually)"
      fi
      cd "$ROOT_DIR"
      if [[ "$rules_ok" -eq 0 ]]; then
        echo -e "${BLUE}  Retry:${NC} cd web && firebase deploy --only firestore:rules --project $PROJECT_ID"
      fi
    else
      echo -e "${YELLOW}  ⚠${NC} Firebase CLI not found or firebase.json missing"
      echo -e "${YELLOW}  ⚠${NC} Deploy manually: cd web && firebase deploy --only firestore --project $PROJECT_ID"
    fi
    echo -e "${BLUE}  Rules:${NC} $WEB_DIR/firestore.rules"
    echo -e "${BLUE}  Indexes:${NC} $WEB_DIR/firestore.indexes.json"
  else
    [[ ! -f "$WEB_DIR/firestore.rules" ]] && echo -e "${YELLOW}  ⚠${NC} firestore.rules not found at $WEB_DIR/firestore.rules"
    [[ ! -f "$WEB_DIR/firestore.indexes.json" ]] && echo -e "${YELLOW}  ⚠${NC} firestore.indexes.json not found at $WEB_DIR/firestore.indexes.json"
  fi

  # Verify meta_analyses indexes presence (best-effort)
  echo -e "${BLUE}[firestore] Verifying meta_analyses composite indexes...${NC}"
  local meta_list_json
  if meta_list_json=$(gcloud firestore indexes composite list --filter='COLLECTION_GROUP:meta_analyses' --project="$PROJECT_ID" --format=json 2>/dev/null); then
    local has_proj
    local has_user
    has_proj=$(echo "$meta_list_json" | grep -c '"projectId"' || true)
    has_user=$(echo "$meta_list_json" | grep -c '"userId"' || true)
    if [[ "$has_proj" -gt 0 && "$has_user" -gt 0 ]]; then
      echo -e "${GREEN}  ✓${NC} meta_analyses indexes detected"
    else
      echo -e "${YELLOW}  ⚠${NC} meta_analyses indexes not fully visible yet (Firestorm propagation may take minutes)."
    fi
  else
    echo -e "${YELLOW}  ⚠${NC} Unable to list composite indexes for meta_analyses (insufficient permissions or API)."
  fi
}

create_agentmesh_indexes() {
  echo -e "${BLUE}[agentmesh] Ensuring Firestore composite indexes...${NC}"
  gcloud firestore indexes composite create --async \
    --collection-group=agentmesh_tasks \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet >/dev/null 2>&1 || true
  gcloud firestore indexes composite create --async \
    --collection-group=agentmesh_tasks \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=routedAgentId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet >/dev/null 2>&1 || true
  gcloud firestore indexes composite create --async \
    --collection-group=agentmesh_tasks \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=lease.dedupKey,order=ASCENDING \
    --quiet >/dev/null 2>&1 || true
  gcloud firestore indexes composite create --async \
    --collection-group=agentmesh_traces \
    --field-config field-path=taskId,order=ASCENDING \
    --field-config field-path=startedAt,order=ASCENDING \
    --quiet >/dev/null 2>&1 || true
  gcloud firestore indexes composite create --async \
    --collection-group=agentmesh_artifacts \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=taskId,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet >/dev/null 2>&1 || true
  echo -e "${GREEN}[agentmesh] ✓${NC} Firestore composite indexes submitted"
}

agentmesh_access_token() {
  gcloud auth print-access-token --project "$PROJECT_ID"
}

wait_agentmesh_vertex_operation() {
  local operation_name="$1"
  local deadline=$((SECONDS + 300))
  while (( SECONDS < deadline )); do
    local response
    response=$(curl -fsS -H "Authorization: Bearer $(agentmesh_access_token)" "https://aiplatform.googleapis.com/v1beta1/${operation_name}")
    if python3 - <<'PY' "$response"
import json, sys
body=json.loads(sys.argv[1])
sys.exit(0 if body.get("done") else 1)
PY
    then
      echo "$response"
      return 0
    fi
    sleep 3
  done
  echo -e "${RED}[agentmesh] Vertex operation timed out:${NC} $operation_name" >&2
  return 1
}

ensure_agentmesh_reasoning_engine() {
  local secret_name="agentmesh_reasoning_engine_name"
  local engine_name=""

  if gcloud secrets describe "$secret_name" --project "$PROJECT_ID" >/dev/null 2>&1; then
    engine_name=$(gcloud secrets versions access latest --secret="$secret_name" --project "$PROJECT_ID" 2>/dev/null || true)
    if [[ -n "$engine_name" ]]; then
      if curl -fsS -H "Authorization: Bearer $(agentmesh_access_token)" "https://aiplatform.googleapis.com/v1beta1/${engine_name}" >/dev/null 2>&1; then
        AGENTMESH_REASONING_ENGINE="$engine_name"
        echo -e "${GREEN}[agentmesh] Using existing Reasoning Engine:${NC} $AGENTMESH_REASONING_ENGINE"
        return 0
      fi
    fi
  fi

  local location="${AGENTMESH_VERTEX_LOCATION:-$REGION}"
  local payload
  payload=$(python3 - <<'PY' "$SA_AGENTMESH"
import json, sys
sa=sys.argv[1]
body={
  "displayName":"AgentMesh Runtime",
  "description":"Managed Vertex substrate for AgentMesh sessions, memories, and A2A interoperability",
  "labels":{"managed_by":"agentmesh","subsystem":"agentmesh"},
  "contextSpec":{"memoryBankConfig":{"ttlConfig":{"defaultTtl":"2592000s","memoryRevisionDefaultTtl":"2592000s"}}},
  "spec":{"serviceAccount":sa,"agentFramework":"custom"}
}
print(json.dumps(body))
PY
)

  echo -e "${BLUE}[agentmesh] Creating Vertex Reasoning Engine...${NC}"
  local op_response
  op_response=$(curl -fsS -X POST \
    -H "Authorization: Bearer $(agentmesh_access_token)" \
    -H "Content-Type: application/json" \
    -d "$payload" \
    "https://aiplatform.googleapis.com/v1beta1/projects/${PROJECT_ID}/locations/${location}/reasoningEngines")
  local op_name
  op_name=$(python3 - <<'PY' "$op_response"
import json, sys
print(json.loads(sys.argv[1])["name"])
PY
)
  local final_response
  final_response=$(wait_agentmesh_vertex_operation "$op_name")
  engine_name=$(python3 - <<'PY' "$final_response"
import json, sys
body=json.loads(sys.argv[1])
print(((body.get("response") or {}).get("name")) or "")
PY
)
  if [[ -z "$engine_name" ]]; then
    echo -e "${RED}[agentmesh] Failed to obtain Reasoning Engine name from Vertex operation${NC}" >&2
    exit 1
  fi
  if ! gcloud secrets describe "$secret_name" --project "$PROJECT_ID" >/dev/null 2>&1; then
    echo -n "$engine_name" | gcloud secrets create "$secret_name" --project "$PROJECT_ID" --data-file=-
  else
    echo -n "$engine_name" | gcloud secrets versions add "$secret_name" --project "$PROJECT_ID" --data-file=- >/dev/null
  fi
  AGENTMESH_REASONING_ENGINE="$engine_name"
  echo -e "${GREEN}[agentmesh] Created Reasoning Engine:${NC} $AGENTMESH_REASONING_ENGINE"
}

smoke_agentmesh_deploy() {
  if [[ -z "${AGENTMESH_URL:-}" ]]; then
    return 0
  fi
  echo -e "${BLUE}[agentmesh] Running post-deploy smoke check...${NC}"
  local token=""
  token=$(gcloud auth print-identity-token --audiences="$AGENTMESH_URL" --project "$PROJECT_ID" 2>/dev/null || true)
  if [[ -z "$token" ]]; then
    echo -e "${YELLOW}[agentmesh] Skipping authenticated readiness probe: unable to mint identity token${NC}"
    return 0
  fi
  local response
  response=$(curl -fsS -H "Authorization: Bearer ${token}" "${AGENTMESH_URL}/readyz")
  if ! python3 - <<'PY' "$response"
import json, sys
body=json.loads(sys.argv[1])
sys.exit(0 if body.get("ok") else 1)
PY
  then
    echo -e "${RED}[agentmesh] Readiness probe failed:${NC} $response" >&2
    exit 1
  fi
  echo -e "${GREEN}[agentmesh] Smoke check passed${NC}"
}

setup_agentmesh_infrastructure() {
  echo -e "${BLUE}[agentmesh] Ensuring infrastructure...${NC}"
  for api in \
    firestore.googleapis.com \
    run.googleapis.com \
    cloudbuild.googleapis.com \
    iam.googleapis.com \
    secretmanager.googleapis.com \
    cloudkms.googleapis.com \
    cloudtasks.googleapis.com \
    aiplatform.googleapis.com \
    discoveryengine.googleapis.com; do
    gcloud services enable "$api" --project "$PROJECT_ID" >/dev/null 2>&1 || true
  done

  if ! gcloud firestore databases describe --project="$PROJECT_ID" --database="(default)" >/dev/null 2>&1; then
    gcloud firestore databases create \
      --project="$PROJECT_ID" \
      --database="(default)" \
      --location="${FIRESTORE_LOCATION}" \
      --type=firestore-native \
      --quiet
  fi

  if ! gcloud iam service-accounts describe "$SA_AGENTMESH" --project="$PROJECT_ID" >/dev/null 2>&1; then
    gcloud iam service-accounts create agentmesh --display-name "AgentMesh Runtime" --project "$PROJECT_ID"
    echo -e "${GREEN}[agentmesh] Created service account:${NC} $SA_AGENTMESH"
  fi

  for role in \
    roles/datastore.user \
    roles/aiplatform.user \
    roles/discoveryengine.user \
    roles/secretmanager.secretAccessor \
    roles/storage.objectAdmin \
    roles/logging.logWriter \
    roles/cloudtasks.enqueuer \
    roles/cloudkms.signerVerifier; do
    if ! gcloud projects add-iam-policy-binding "$PROJECT_ID" \
      --member="serviceAccount:$SA_AGENTMESH" \
      --role="$role" \
      --condition=None \
      --quiet >/dev/null 2>&1; then
      echo -e "${YELLOW}[agentmesh] Warning: IAM bind failed or redundant:${NC} $role (check permissions / policy)"
    fi
  done

  if ! gcloud kms keyrings describe "$AGENTMESH_KMS_KEYRING" --location "$AGENTMESH_KMS_LOCATION" --project "$PROJECT_ID" >/dev/null 2>&1; then
    gcloud kms keyrings create "$AGENTMESH_KMS_KEYRING" --location "$AGENTMESH_KMS_LOCATION" --project "$PROJECT_ID" >/dev/null
    echo -e "${GREEN}[agentmesh] Created KMS keyring:${NC} $AGENTMESH_KMS_KEYRING"
  fi
  if ! gcloud kms keys describe "$AGENTMESH_KMS_KEY" --keyring "$AGENTMESH_KMS_KEYRING" --location "$AGENTMESH_KMS_LOCATION" --project "$PROJECT_ID" >/dev/null 2>&1; then
    gcloud kms keys create "$AGENTMESH_KMS_KEY" \
      --keyring "$AGENTMESH_KMS_KEYRING" \
      --location "$AGENTMESH_KMS_LOCATION" \
      --purpose asymmetric-signing \
      --default-algorithm ec-sign-p256-sha256 \
      --project "$PROJECT_ID" >/dev/null
    echo -e "${GREEN}[agentmesh] Created KMS key:${NC} $AGENTMESH_KMS_KEY"
  fi
  AGENTMESH_AGENT_CARD_KMS_KEY_VERSION=$(gcloud kms keys versions list \
    --key "$AGENTMESH_KMS_KEY" \
    --keyring "$AGENTMESH_KMS_KEYRING" \
    --location "$AGENTMESH_KMS_LOCATION" \
    --project "$PROJECT_ID" \
    --filter='state=ENABLED' \
    --limit=1 \
    --format='value(name)')

  local bucket="gs://${PROJECT_ID}-agentmesh-artifacts"
  if ! gcloud storage buckets describe "$bucket" --project "$PROJECT_ID" >/dev/null 2>&1; then
    gcloud storage buckets create "$bucket" --location=US --uniform-bucket-level-access --project "$PROJECT_ID"
    echo -e "${GREEN}[agentmesh] Created bucket:${NC} $bucket"
  fi

  local queue="${AGENTMESH_TASKS_QUEUE:-nv-horizon-agentmesh}"
  if ! gcloud tasks queues describe "$queue" --location="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
    gcloud tasks queues create "$queue" --location="$REGION" --project="$PROJECT_ID" --quiet >/dev/null 2>&1 || true
    echo -e "${GREEN}[agentmesh] Created Cloud Tasks queue:${NC} $queue"
  fi
  gcloud tasks queues update "$queue" \
    --location="$REGION" \
    --project="$PROJECT_ID" \
    --max-attempts=5 \
    --min-backoff=10s \
    --max-backoff=600s \
    --max-retry-duration=3600s \
    --max-dispatches-per-second="${AGENTMESH_MAX_DISPATCHES_PER_SECOND:-8}" \
    --max-concurrent-dispatches="${AGENTMESH_MAX_CONCURRENT_DISPATCHES:-16}" \
    --quiet >/dev/null 2>&1 || true

  ensure_agentmesh_reasoning_engine
  create_agentmesh_indexes
}

deploy_agentmesh() {
  echo -e "${BLUE}[agentmesh] Ensuring Artifact Registry repo (cloud-run-source-deploy)...${NC}"
  gcloud services enable artifactregistry.googleapis.com --project="$PROJECT_ID" >/dev/null 2>&1 || true
  if ! gcloud artifacts repositories describe cloud-run-source-deploy --location="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
    gcloud artifacts repositories create cloud-run-source-deploy \
      --repository-format=docker \
      --location="$REGION" \
      --project="$PROJECT_ID" \
      --description="Cloud Run deploy images" \
      --quiet >/dev/null 2>&1 || {
      echo -e "${RED}[agentmesh] Failed to create Artifact Registry repo cloud-run-source-deploy${NC}" >&2
      exit 1
    }
    echo -e "${GREEN}[agentmesh] Created Artifact Registry repo:${NC} cloud-run-source-deploy"
  fi

  echo -e "${BLUE}[agentmesh] Building container image...${NC}"
  local service="nv-horizon-agentmesh"
  local image_tag
  image_tag=$(date +%s)
  local image="us-central1-docker.pkg.dev/$PROJECT_ID/cloud-run-source-deploy/${service}:${image_tag}"
  local latest_image="us-central1-docker.pkg.dev/$PROJECT_ID/cloud-run-source-deploy/${service}:latest"
  gcloud builds submit "$API_DIR" \
    --project "$PROJECT_ID" \
    --config="$API_DIR/cmd/agentmesh/cloudbuild.yaml" \
    --substitutions=_IMAGE_TAG="$image_tag" \
    --quiet

  local existing_url=""
  existing_url=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)' 2>/dev/null || true)
  if [[ -z "${AGENTMESH_AGENT_CARD_KMS_KEY_VERSION:-}" ]]; then
    AGENTMESH_AGENT_CARD_KMS_KEY_VERSION=$(gcloud kms keys versions list \
      --key "$AGENTMESH_KMS_KEY" \
      --keyring "$AGENTMESH_KMS_KEYRING" \
      --location "$AGENTMESH_KMS_LOCATION" \
      --project "$PROJECT_ID" \
      --filter='state=ENABLED' \
      --limit=1 \
      --format='value(name)' 2>/dev/null || true)
  fi
  if [[ -z "${AGENTMESH_AGENT_CARD_KMS_KEY_VERSION:-}" ]]; then
    echo -e "${RED}[agentmesh] Failed to resolve AGENTMESH_AGENT_CARD_KMS_KEY_VERSION${NC}" >&2
    exit 1
  fi
  local public_base_url="${AGENTMESH_PUBLIC_BASE_URL:-$existing_url}"
  local oidc_audience="${AGENTMESH_TASKS_OIDC_AUDIENCE:-$public_base_url}"
  local target_url=""
  if [[ -n "$public_base_url" ]]; then
    target_url="${public_base_url}/api/v1/internal/tasks/agentmesh/run"
  fi
  # Reasoning Engine is created in AGENTMESH_VERTEX_LOCATION or REGION (see ensure_agentmesh_reasoning_engine); keep defaults aligned.
  local agentmesh_vertex_loc="${AGENTMESH_VERTEX_LOCATION:-$REGION}"
  local env_vars="GCP_PROJECT_ID=$PROJECT_ID,GOOGLE_CLOUD_PROJECT=$PROJECT_ID,AGENTMESH_VERTEX_LOCATION=${agentmesh_vertex_loc},AGENTMESH_VERTEX_REASONING_ENGINE=${AGENTMESH_REASONING_ENGINE},AGENTMESH_PUBLIC_BASE_URL=${public_base_url},AGENTMESH_TASK_TARGET_URL=${target_url},AGENTMESH_TASKS_LOCATION=${AGENTMESH_TASKS_LOCATION:-$REGION},AGENTMESH_TASKS_QUEUE=${AGENTMESH_TASKS_QUEUE:-nv-horizon-agentmesh},AGENTMESH_TASKS_OIDC_SERVICE_ACCOUNT=$SA_BACKEND,AGENTMESH_TASKS_OIDC_AUDIENCE=${oidc_audience},AGENTMESH_TASKS_DISABLE_OIDC=${AGENTMESH_TASKS_DISABLE_OIDC:-1},AGENTMESH_ALLOW_UNAUTH_INTERNAL_TASKS=${AGENTMESH_ALLOW_UNAUTH_INTERNAL_TASKS:-1},AGENTMESH_RUNTIME_LEASE_OWNER=${AGENTMESH_RUNTIME_LEASE_OWNER:-${service}},AGENTMESH_ARTIFACT_BUCKET=${PROJECT_ID}-agentmesh-artifacts,AGENTMESH_AGENT_CARD_KMS_KEY_VERSION=${AGENTMESH_AGENT_CARD_KMS_KEY_VERSION},AGENTMESH_AGENT_CARD_KEY_ID=${AGENTMESH_AGENT_CARD_KMS_KEY_VERSION},AGENTMESH_MODEL_FLASH=${AGENTMESH_MODEL_FLASH:-gemini-3-flash-preview},AGENTMESH_MODEL_PRO=${AGENTMESH_MODEL_PRO:-gemini-3-pro-preview},VERTEX_SEARCH_DATA_STORE_ID=${VERTEX_SEARCH_DATA_STORE_ID:-rag-documents-store},AGENTMESH_VERTEX_SESSION_TTL=${AGENTMESH_VERTEX_SESSION_TTL:-86400s}"

  echo -e "${BLUE}[agentmesh] Deploying to Cloud Run...${NC}"
  gcloud run deploy "$service" \
    --image "$image" \
    --region "$REGION" \
    --service-account "$SA_AGENTMESH" \
    --min-instances="${AGENTMESH_CLOUD_RUN_MIN_INSTANCES:-0}" \
    --max-instances="${AGENTMESH_CLOUD_RUN_MAX_INSTANCES:-4}" \
    --concurrency="${AGENTMESH_CLOUD_RUN_CONCURRENCY:-8}" \
    --cpu="${AGENTMESH_CLOUD_RUN_CPU:-1}" \
    --memory="${AGENTMESH_CLOUD_RUN_MEMORY:-1Gi}" \
    --timeout=3600 \
    --set-env-vars "$env_vars" \
    --project "$PROJECT_ID" \
    --quiet
  gcloud run services update-traffic "$service" --region "$REGION" --to-latest --quiet >/dev/null 2>&1 || true
  AGENTMESH_URL=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)')
  echo -e "${GREEN}[agentmesh] Deployed successfully${NC}"
  echo -e "${BLUE}[agentmesh] URL:${NC} $AGENTMESH_URL"

  gcloud run services add-iam-policy-binding "$service" \
    --region "$REGION" \
    --member="serviceAccount:$SA_AGENTMESH" \
    --role="roles/run.invoker" \
    --project "$PROJECT_ID" \
    --quiet >/dev/null 2>&1 || true
  # Cloud Tasks (and API) call AgentMesh with OIDC from backend@ — must be allowed to invoke.
  gcloud run services add-iam-policy-binding "$service" \
    --region "$REGION" \
    --member="serviceAccount:$SA_BACKEND" \
    --role="roles/run.invoker" \
    --project "$PROJECT_ID" \
    --quiet >/dev/null 2>&1 || true

  gcloud run services update "$service" \
    --region "$REGION" \
    --update-env-vars "AGENTMESH_PUBLIC_BASE_URL=$AGENTMESH_URL,AGENTMESH_TASK_TARGET_URL=${AGENTMESH_URL}/api/v1/internal/tasks/agentmesh/run,AGENTMESH_TASKS_OIDC_AUDIENCE=$AGENTMESH_URL" \
    --project "$PROJECT_ID" \
    --quiet >/dev/null 2>&1 || true
  smoke_agentmesh_deploy
}

# Setup infrastructure only on full deploy or explicit check.
# Individual service deploys (--api, --ws, --verified-proxy, --py) usually skip infra checks for speed,
# BUT some flags (e.g. --nv-horizon-watchdog) require infra steps (Cloud Scheduler jobs, env vars).
if [[ "$TARGET_CHECK_INFRA" -eq 1 ]]; then
  setup_infrastructure
  create_indexes
  echo -e "${GREEN}[infra] Infrastructure checks completed${NC}"
  exit 0
elif [[ "$TARGET_AGENTMESH" -eq 1 ]]; then
  setup_agentmesh_infrastructure
elif [[ "$TARGET_NV_HORIZON_WATCHDOG" -eq 1 ]]; then
  # Minimal infra needed for watchdog Cloud Scheduler job creation/update.
  setup_infrastructure
elif [[ "$TARGET_WEB" -eq 1 && "$TARGET_API" -eq 1 && "$TARGET_PY" -eq 0 && "$TARGET_VERIFIED_PROXY" -eq 0 ]]; then
  # Full deploy: run infrastructure checks
  setup_infrastructure
elif [[ "$TARGET_SETUP_NV_HORIZON_INFRA" -eq 1 ]]; then
  # Deploy nv-horizon-ws: ensure Pub/Sub topics and subscriptions exist
  # Call the same setup function but only for nv-horizon-ws infrastructure
  echo -e "${BLUE}[infra] Setting up infrastructure for nv-horizon-ws...${NC}"
  # Ensure aggregated topics and subscriptions (reuse logic from setup_infrastructure)
  agg_topics=(
    "nv_horizon.genai.streams"
    "nv_horizon.discovery.events"
    "nv_horizon.artifact.events"
    "nv_horizon.interaction.events"
    "nv_horizon.analysis.events"
    "nv_horizon.verified.streams"
    "nv_horizon.horizon.events"
    "nv_horizon.operations.events"
  )
  # 4.1 Ensure aggregated topics
  echo -e "${BLUE}[infra] Ensuring Pub/Sub aggregated topics for nv-horizon-ws...${NC}"
  for topic in "${agg_topics[@]}"; do
    if ! gcloud pubsub topics describe "$topic" --project="$PROJECT_ID" >/dev/null 2>&1; then
      gcloud pubsub topics create "$topic" --project="$PROJECT_ID" --quiet || true
      echo -e "${GREEN}  ✓${NC} Created topic: $topic"
    else
      echo -e "${GREEN}  ✓${NC} $topic exists"
    fi
  done
  # 4.2 Ensure nv-horizon-ws subscriptions
  echo -e "${BLUE}[infra] Ensuring Pub/Sub subscriptions for nv-horizon-ws...${NC}"
  for topic in "${agg_topics[@]}"; do
    sub_id="${topic}-ws-broker"
    if gcloud pubsub subscriptions describe "$sub_id" --project="$PROJECT_ID" >/dev/null 2>&1; then
      ordering=$(gcloud pubsub subscriptions describe "$sub_id" --project="$PROJECT_ID" --format="value(enableMessageOrdering)" 2>/dev/null || echo "False")
      if [[ "$ordering" != "True" ]]; then
        echo -e "${YELLOW}[infra] Recreating subscription with ordering enabled:${NC} $sub_id"
        gcloud pubsub subscriptions delete "$sub_id" --project="$PROJECT_ID" --quiet >/dev/null 2>&1 || true
        gcloud pubsub subscriptions create "$sub_id" \
          --project="$PROJECT_ID" \
          --topic="$topic" \
          --enable-message-ordering \
          --quiet >/dev/null 2>&1 || true
      fi
      echo -e "${GREEN}  ✓${NC} $sub_id exists"
    else
      gcloud pubsub subscriptions create "$sub_id" \
        --project="$PROJECT_ID" \
        --topic="$topic" \
        --enable-message-ordering \
        --quiet >/dev/null 2>&1 || true
      echo -e "${GREEN}  ✓${NC} Created subscription: $sub_id"
    fi
  done
fi

if [[ "$TARGET_API" -eq 1 ]]; then
  deploy_api
fi

if [[ "$TARGET_NV_HORIZON_WS" -eq 1 ]]; then
  deploy_nv_horizon_ws
fi

if [[ "$TARGET_VERIFIED_PROXY" -eq 1 ]]; then
  deploy_verified_proxy
fi

if [[ "$TARGET_WEB" -eq 1 ]]; then
  # Build web last so it can pick up freshly deployed API/WS/proxy URLs.
  deploy_web
fi

if [[ "$TARGET_PY" -eq 1 ]]; then
  deploy_py
fi

if [[ "$TARGET_EVENT_GATE" -eq 1 ]]; then
  deploy_event_gate
fi

if [[ "$TARGET_ENTITY_EXTRACT" -eq 1 ]]; then
  deploy_entity_extract
fi

if [[ "$TARGET_AGENTMESH" -eq 1 ]]; then
  deploy_agentmesh
fi

# Firestore indexes are only relevant for backend; skip for web-only
# Create indexes only on full deploy (already handled in --check-infra path above)
if [[ "$TARGET_WEB" -eq 1 && "$TARGET_API" -eq 1 && "$TARGET_PY" -eq 0 && "$TARGET_VERIFIED_PROXY" -eq 0 ]]; then
  if [[ "$TARGET_API" -eq 1 || "$TARGET_PY" -eq 1 ]]; then
    create_indexes
  fi
fi

# Cleanup old revisions (manual operation, separate from deployment)
if [[ "$TARGET_CLEANUP_REVISIONS" -eq 1 ]]; then
  echo ""
  echo -e "${BLUE}═══════════════════════════════════════════════════════${NC}"
  echo -e "${BLUE}Cleaning up old Cloud Run revisions...${NC}"
  echo -e "${BLUE}═══════════════════════════════════════════════════════${NC}"
  
  # Clean up revisions for all services (keep last 10 per service)
  services=("nv-horizon-api" "nv-horizon-telegram" "nv-horizon-event-gate" "nv-horizon-entity-extract" "nv-horizon-ws" "verified-proxy")
  if [[ "$TARGET_AGENTMESH" -eq 1 ]]; then
    services+=("nv-horizon-agentmesh")
  fi
  for service in "${services[@]}"; do
    if gcloud run services describe "$service" --region "$REGION" --project "$PROJECT_ID" >/dev/null 2>&1; then
      cleanup_old_revisions "$service" "$REGION" 10
    else
      echo -e "${YELLOW}[cleanup] Service $service not found, skipping${NC}"
    fi
  done
  
  echo ""
  echo -e "${GREEN}✓ Cleanup Complete${NC}"
fi

echo ""
echo -e "${GREEN}═══════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}✓ Deployment Complete${NC}"
echo -e "${GREEN}═══════════════════════════════════════════════════════${NC}"

# Summary
if [[ "$TARGET_API" -eq 1 ]] && [[ -n "${API_URL:-}" ]]; then
  echo -e "${BLUE}Backend API:${NC} $API_URL"
fi
if [[ "$TARGET_VERIFIED_PROXY" -eq 1 ]] && [[ -n "${VERIFIED_PROXY_URL:-}" ]]; then
  echo -e "${BLUE}Verified Proxy:${NC} $VERIFIED_PROXY_URL"
fi
if [[ "$TARGET_NV_HORIZON_WS" -eq 1 ]] && [[ -n "${NV_HORIZON_WS_URL:-}" ]]; then
  echo -e "${BLUE}WS Broker:${NC} $NV_HORIZON_WS_URL"
fi
if [[ "$TARGET_PY" -eq 1 ]] && [[ -n "${TG_URL:-}" ]]; then
  echo -e "${BLUE}Telegram Service:${NC} $TG_URL"
fi
if [[ "$TARGET_EVENT_GATE" -eq 1 ]] && [[ -n "${EVENT_GATE_URL:-}" ]]; then
  echo -e "${BLUE}Event Gate Service:${NC} $EVENT_GATE_URL"
fi
if [[ "$TARGET_ENTITY_EXTRACT" -eq 1 ]] && [[ -n "${ENTITY_EXTRACT_URL:-}" ]]; then
  echo -e "${BLUE}Entity Extract Service:${NC} $ENTITY_EXTRACT_URL"
fi
if [[ "$TARGET_AGENTMESH" -eq 1 ]] && [[ -n "${AGENTMESH_URL:-}" ]]; then
  echo -e "${BLUE}AgentMesh:${NC} $AGENTMESH_URL"
fi
if [[ "$TARGET_WEB" -eq 1 ]]; then
  echo -e "${BLUE}Web Static:${NC} gs://${PROJECT_ID}-web-static"
fi

echo ""
echo -e "${YELLOW}Post-deployment checklist:${NC}"
echo -e "  ☐ Verify secrets have real API keys (not placeholders)"
if [[ "$TARGET_API" -eq 1 ]]; then
