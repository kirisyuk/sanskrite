#!/usr/bin/env bash
set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)
WEB_DIR="$ROOT_DIR/web"
API_DIR="$ROOT_DIR/backend"

TARGET_WEB=1
TARGET_API=1
TARGET_ETIGRAM_WS=0
TARGET_VERIFIED_PROXY=0
TARGET_CHECK_INFRA=0
TARGET_SETUP_ETIGRAM_INFRA=0
TARGET_ETIGRAM_WATCHDOG=0
TARGET_ETIGRAM_WATCHDOG_ONLY=0
TARGET_CLEANUP_REVISIONS=0
TARGET_EVENT_GATE=0
TARGET_ENTITY_EXTRACT=0

REGION=${REGION:-us-central1}
FIRESTORE_LOCATION=${FIRESTORE_LOCATION:-$REGION}
PROJECT_ID=$(gcloud config get-value project 2>/dev/null || true)
if [[ -z "$PROJECT_ID" || "$PROJECT_ID" == "(unset)" ]]; then
  echo -e "${RED}GCP project is not set. Run: gcloud config set project <ID>${NC}" >&2
  exit 1
fi

# Service account for backend
SA_BACKEND="backend@${PROJECT_ID}.iam.gserviceaccount.com"

# Secret for Cloud Scheduler secured endpoints (X-Job-Token header)
SECRET_ADMIN_JOB_TOKEN="admin_job_token"

usage() {
  echo "Usage: scripts/deploy [--web] [--api] [--py] [--event-gate] [--entity-extract] [--etigram-ws] [--verified-proxy] [--check-infra] [--etigram-watchdog] [--etigram-watchdog-only] [--cleanup-revisions]"
  echo "If none specified, deploy web+api. REGION env var supported (default: us-central1)."
  echo ""
  echo "Flags:"
  echo "  --web           Deploy frontend only"
  echo "  --api           Deploy backend API only (skips infra checks)"
  echo "  --py            Deploy Telegram service only (skips infra checks)"
  echo "  --event-gate    Deploy event gate NLP service only (skips infra checks)"
  echo "  --entity-extract Deploy entity extraction NLP service only (skips infra checks)"
  echo "  --etigram-ws    Deploy WS broker only (skips infra checks)"
  echo "  --verified-proxy Deploy verified-proxy only (skips infra checks)"
  echo "  --check-infra   Run infrastructure checks only (no deployments)"
  echo "  --etigram-watchdog Ensure Cloud Scheduler job for Etigram Watchdog (calls API cron endpoint)"
  echo "  --etigram-watchdog-only Only ensure Etigram Watchdog infra/job/env (no API build/deploy)"
  echo "  --cleanup-revisions Clean up old Cloud Run revisions (keeps last 10 per service, manual operation)"
}

TARGET_PY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --web) TARGET_API=0 ;;
    --api) TARGET_WEB=0; TARGET_CHECK_INFRA=0 ;;
    --py) TARGET_WEB=0; TARGET_API=0; TARGET_PY=1; TARGET_CHECK_INFRA=0 ;;
    --event-gate) TARGET_WEB=0; TARGET_API=0; TARGET_PY=0; TARGET_EVENT_GATE=1; TARGET_CHECK_INFRA=0 ;;
    --entity-extract) TARGET_WEB=0; TARGET_API=0; TARGET_PY=0; TARGET_ENTITY_EXTRACT=1; TARGET_CHECK_INFRA=0 ;;
    --etigram-ws) TARGET_WEB=0; TARGET_API=0; TARGET_PY=0; TARGET_ETIGRAM_WS=1; TARGET_CHECK_INFRA=0; TARGET_SETUP_ETIGRAM_INFRA=1 ;;
    --verified-proxy) TARGET_WEB=0; TARGET_API=0; TARGET_PY=0; TARGET_ETIGRAM_WS=0; TARGET_VERIFIED_PROXY=1; TARGET_CHECK_INFRA=0 ;;
    --check-infra) TARGET_WEB=0; TARGET_API=0; TARGET_PY=0; TARGET_ETIGRAM_WS=0; TARGET_VERIFIED_PROXY=0; TARGET_CHECK_INFRA=1 ;;
    --etigram-watchdog) TARGET_ETIGRAM_WATCHDOG=1 ;;
    --etigram-watchdog-only) TARGET_ETIGRAM_WATCHDOG=1; TARGET_ETIGRAM_WATCHDOG_ONLY=1; TARGET_WEB=0; TARGET_API=0; TARGET_PY=0; TARGET_ETIGRAM_WS=0; TARGET_VERIFIED_PROXY=0; TARGET_CHECK_INFRA=0 ;;
    --cleanup-revisions) TARGET_CLEANUP_REVISIONS=1; TARGET_WEB=0; TARGET_API=0; TARGET_PY=0; TARGET_ETIGRAM_WS=0; TARGET_VERIFIED_PROXY=0; TARGET_CHECK_INFRA=0 ;;
    -h|--help) usage; exit 0 ;;
    *) echo -e "${YELLOW}Unknown arg: $1${NC}"; usage; exit 1 ;;
  esac
  shift
done

echo -e "${BLUE}Project:${NC} $PROJECT_ID\n${BLUE}Region:${NC} $REGION"

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo -e "${RED}Missing required command: $1${NC}" >&2
    exit 1
  fi
}

require gcloud
## gsutil not required; use gcloud storage to avoid Python dependency

# Get Firebase Project ID from env, with safe defaults.
# IMPORTANT: for API-only deploys, auth tokens should usually match the active GCP project.
# Reading web/.firebaserc here can accidentally bind API auth to a different Firebase project.
FIREBASE_PROJECT_ID="${FIREBASE_PROJECT_ID:-}"
if [[ -z "$FIREBASE_PROJECT_ID" ]]; then
  if [[ "$TARGET_API" -eq 1 && "$TARGET_WEB" -eq 0 ]]; then
    FIREBASE_PROJECT_ID="$PROJECT_ID"
  elif [[ -f "$WEB_DIR/.firebaserc" ]]; then
    FIREBASE_PROJECT_ID=$(grep -o '"default": "[^"]*' "$WEB_DIR/.firebaserc" | cut -d'"' -f4 || echo "")
  fi
fi
if [[ -z "$FIREBASE_PROJECT_ID" ]]; then
  FIREBASE_PROJECT_ID="$PROJECT_ID"
fi
echo -e "${BLUE}Firebase Project ID:${NC} $FIREBASE_PROJECT_ID"

deploy_web() {
  echo -e "${BLUE}[web] Starting frontend deployment...${NC}"
  require firebase
  require npm
  
  # Check if web directory exists
  if [[ ! -d "$WEB_DIR" ]]; then
    echo -e "${RED}[web] Error: Web directory not found at $WEB_DIR${NC}" >&2
    exit 1
  fi
  
  # Try to resolve WS broker URL for Vite env (etigram-ws)
  local API_BASE_URL="${VITE_API_BASE_URL:-}"
  if [[ -z "$API_BASE_URL" ]]; then
    if gcloud run services describe etigram-api --region "$REGION" >/dev/null 2>&1; then
      API_BASE_URL=$(gcloud run services describe etigram-api --region "$REGION" --format='value(status.url)')
      echo -e "${GREEN}[web] Found etigram-api URL:${NC} $API_BASE_URL"
    else
      echo -e "${YELLOW}[web] API service (etigram-api) not found (will use default from env if set)${NC}"
    fi
  fi

  # Try to resolve WS broker URL for Vite env (etigram-ws)
  local WS_URL="${WS_URL:-}"
  if [[ -z "$WS_URL" ]]; then
    if gcloud run services describe etigram-ws --region "$REGION" >/dev/null 2>&1; then
      WS_URL=$(gcloud run services describe etigram-ws --region "$REGION" --format='value(status.url)')
      echo -e "${GREEN}[web] Found etigram-ws URL:${NC} $WS_URL"
    else
      echo -e "${YELLOW}[web] WS broker (etigram-ws) not found (will use default from env if set)${NC}"
    fi
  fi
  
  # Try to resolve verified-proxy URL for Vite env
  local VERIFIED_PROXY_URL="${VERIFIED_PROXY_URL:-}"
  if [[ -z "$VERIFIED_PROXY_URL" ]]; then
    if gcloud run services describe verified-proxy --region "$REGION" >/dev/null 2>&1; then
      VERIFIED_PROXY_URL=$(gcloud run services describe verified-proxy --region "$REGION" --format='value(status.url)')
      echo -e "${GREEN}[web] Found verified-proxy URL:${NC} $VERIFIED_PROXY_URL"
    else
      echo -e "${YELLOW}[web] verified-proxy service not found (will use default from env if set)${NC}"
    fi
  fi
  
  # Build with environment variables
  echo -e "${BLUE}[web] Installing dependencies...${NC}"
  cd "$WEB_DIR"
  
  # Install dependencies
  # Try npm ci first, fallback to npm install if it fails (e.g., locked files on Windows)
  if ! npm ci --no-audit --no-fund 2>/dev/null; then
    echo -e "${YELLOW}[web] npm ci failed, trying npm install...${NC}"
    if ! npm install --no-audit --no-fund; then
      echo -e "${RED}[web] Error: npm install failed${NC}" >&2
      exit 1
    fi
  fi
  
  # Build with environment variables
  echo -e "${BLUE}[web] Building Vite app...${NC}"
  local build_env_vars=()
  # Firebase config for etigram (created via firebase apps:create WEB)
  if [[ -n "$API_BASE_URL" ]]; then
    build_env_vars+=("VITE_API_BASE_URL=$API_BASE_URL")
    echo -e "${BLUE}[web] Using API base URL for build:${NC} $API_BASE_URL"
  fi
  build_env_vars+=("VITE_FIREBASE_PROJECT_ID=$FIREBASE_PROJECT_ID")
  build_env_vars+=("VITE_FIREBASE_AUTH_DOMAIN=${FIREBASE_PROJECT_ID}.firebaseapp.com")
  build_env_vars+=("VITE_FIREBASE_STORAGE_BUCKET=${FIREBASE_PROJECT_ID}.firebasestorage.app")
  build_env_vars+=("VITE_FIREBASE_API_KEY=AIzaSyAJDpTQvYQJPpTFCN9droNmUoWZNJ0JUc0")
  build_env_vars+=("VITE_FIREBASE_MESSAGING_SENDER_ID=844185759625")
  build_env_vars+=("VITE_FIREBASE_APP_ID=1:844185759625:web:fa13be4a45bc39da397b58")
  if [[ -n "$WS_URL" ]]; then
    build_env_vars+=("VITE_WS_BROKER_URL=$WS_URL")
    echo -e "${BLUE}[web] Using WS broker URL for build:${NC} $WS_URL"
  fi
  if [[ -n "$VERIFIED_PROXY_URL" ]]; then
    build_env_vars+=("VITE_VERIFIED_PROXY_URL=$VERIFIED_PROXY_URL")
    echo -e "${BLUE}[web] Using verified-proxy URL for build:${NC} $VERIFIED_PROXY_URL"
  fi
  
  # Build with env vars if any are set
  if [[ ${#build_env_vars[@]} -gt 0 ]]; then
    export "${build_env_vars[@]}"
    if ! npm run build; then
      echo -e "${RED}[web] Error: npm run build failed${NC}" >&2
      exit 1
    fi
    # Unset variables (extract variable names only)
    for env_var in "${build_env_vars[@]}"; do
      var_name="${env_var%%=*}"
      unset "$var_name"
    done
  else
    if ! npm run build; then
      echo -e "${RED}[web] Error: npm run build failed${NC}" >&2
      exit 1
    fi
  fi
  
  # Verify build output exists
  if [[ ! -d "$WEB_DIR/dist" ]]; then
    echo -e "${RED}[web] Error: Build output directory 'dist' not found${NC}" >&2
    exit 1
  fi
  
  echo -e "${GREEN}[web] Build completed successfully${NC}"

  # Deploy to Firebase Hosting
  echo -e "${BLUE}[web] Deploying to Firebase Hosting...${NC}"
  local FB_ARGS=("--only" "hosting" "--project" "$PROJECT_ID" "--non-interactive" "--force")
  if [[ -n "${FIREBASE_TOKEN:-}" ]]; then
    FB_ARGS+=("--token" "$FIREBASE_TOKEN")
    echo -e "${BLUE}[web] Using Firebase token from environment${NC}"
  else
    echo -e "${YELLOW}[web] No FIREBASE_TOKEN found, will use interactive authentication${NC}"
  fi
  
  if ! firebase deploy "${FB_ARGS[@]}"; then
    echo -e "${RED}[web] Error: Firebase deployment failed${NC}" >&2
    exit 1
  fi

  echo -e "${GREEN}[web] ✓ Firebase Hosting deploy completed successfully${NC}"
  
  # Get hosting URL
  local hosting_url=$(firebase hosting:sites:list --project "$PROJECT_ID" --json 2>/dev/null | grep -o '"defaultHostingSite": "[^"]*' | cut -d'"' -f4 || echo "")
  if [[ -n "$hosting_url" ]]; then
    echo -e "${BLUE}[web] Frontend URL:${NC} https://$hosting_url"
  fi
}

setup_infrastructure() {
  echo -e "${BLUE}[infra] Ensuring required APIs...${NC}"
  
  # Ensure APIs
  enable_api() {
    local api=$1
    gcloud services enable "$api" >/dev/null && echo -e "${GREEN}API enabled:${NC} $api" || true
  }
  
  enable_api firestore.googleapis.com
  enable_api run.googleapis.com
  enable_api cloudbuild.googleapis.com
  enable_api iam.googleapis.com
  enable_api secretmanager.googleapis.com
  enable_api pubsub.googleapis.com
  # Optional but recommended for future features
  enable_api aiplatform.googleapis.com
  enable_api generativelanguage.googleapis.com
  enable_api discoveryengine.googleapis.com  # Vertex AI Search API
  enable_api geocoding-backend.googleapis.com  # Google Geocoding API
  enable_api bigquery.googleapis.com  # BigQuery API
  enable_api bigqueryconnection.googleapis.com  # BigQuery Connections API (for Object Tables and ML)
  enable_api apikeys.googleapis.com
  enable_api cloudscheduler.googleapis.com
  enable_api cloudtasks.googleapis.com
  enable_api cloudresourcemanager.googleapis.com
  enable_api redis.googleapis.com
  enable_api vpcaccess.googleapis.com
  enable_api compute.googleapis.com

  # Best-effort: ensure Google-managed service identities for Vertex services exist.
  # Some IAM bindings fail in fresh projects until these identities are provisioned.
  if gcloud beta services identity create --help >/dev/null 2>&1; then
    echo -e "${BLUE}[infra] Ensuring Vertex service identities...${NC}"
    for svc in aiplatform.googleapis.com discoveryengine.googleapis.com; do
      gcloud beta services identity create --service="$svc" --project="$PROJECT_ID" >/dev/null 2>&1 || true
    done
  fi

  # Ensure Firestore default database exists before any index operations.
  # Fresh GCP projects may have Firestore API enabled but no "(default)" database.
  echo -e "${BLUE}[infra] Ensuring Firestore default database...${NC}"
  if gcloud firestore databases describe --project="$PROJECT_ID" --database="(default)" >/dev/null 2>&1; then
    local fs_location
    fs_location=$(gcloud firestore databases describe --project="$PROJECT_ID" --database="(default)" --format='value(locationId)' 2>/dev/null || echo "")
    echo -e "${GREEN}[infra] Firestore (default) exists${NC}${fs_location:+ (${fs_location})}"
  else
    echo -e "${BLUE}[infra] Creating Firestore (default) in location:${NC} ${FIRESTORE_LOCATION}"
    if gcloud firestore databases create \
      --project="$PROJECT_ID" \
      --database="(default)" \
      --location="${FIRESTORE_LOCATION}" \
      --type=firestore-native \
      --quiet; then
      echo -e "${GREEN}[infra] Created Firestore (default) database${NC}"
    else
      echo -e "${RED}[infra] Failed to create Firestore (default) database${NC}" >&2
      echo -e "${YELLOW}[infra] Create manually:${NC} gcloud firestore databases create --project=${PROJECT_ID} --database='(default)' --location=${FIRESTORE_LOCATION} --type=firestore-native" >&2
      exit 1
    fi
  fi
  
  echo -e "${BLUE}[infra] Setting up service accounts and permissions...${NC}"
  
  # 1. Ensure SA exists
  if ! gcloud iam service-accounts describe "$SA_BACKEND" >/dev/null 2>&1; then
    gcloud iam service-accounts create backend --display-name "Sanskrite Backend"
    echo -e "${GREEN}[infra] Created service account:${NC} $SA_BACKEND"
  fi
  
  # 2. Grant required roles (idempotent)
  echo -e "${BLUE}[infra] Ensuring IAM permissions...${NC}"
  for role in \
    roles/datastore.user \
    roles/aiplatform.user \
    roles/secretmanager.secretAccessor \
    roles/pubsub.admin \
    roles/pubsub.publisher \
    roles/pubsub.subscriber \
    roles/cloudtasks.enqueuer \
    roles/logging.logWriter \
    roles/storage.objectViewer \
    roles/storage.objectCreator \
    roles/storage.objectAdmin; do
    gcloud projects add-iam-policy-binding "$PROJECT_ID" \
      --member="serviceAccount:$SA_BACKEND" \
      --role="$role" \
      --condition=None \
      --quiet >/dev/null 2>&1 || true
    echo -e "${GREEN}  ✓${NC} $role"
  done
  
  # 3. Ensure secrets exist (create if missing with placeholder)
  echo -e "${BLUE}[infra] Ensuring secrets exist...${NC}"
  local known_secrets=(
    gemini_api_key openai_api_key anthropic_api_key deepseek_api_key grok_api_key tavily_api_key
    vertex_api_key
    ANTHROPIC_API_KEY ANTHROPIC_API_KEY_TEST DEEPSEEK_API_KEY DEEPSEEK_API_KEY_TEST
    GROK_API_KEY GROK_API_KEY_TEST OPENAI_API_KEY_TEST VERTEX_API_KEY VERTEX_API_KEY_TEST
    TELEGRAM_API_ID TELEGRAM_API_HASH TELEGRAM_BOT_TOKEN TELEGRAM_SESSION_STRING
    paypal_client_id paypal_secret paypal_webhook_id
    google-custom-search-api-key google_maps_api_key
    GEONAMES_USERNAME functions-key
    ACLED_ACCESS_TOKEN NASA_FIRMS_API_KEY FRED_API_KEY EIA_API_KEY FINNHUB_API_KEY
    CLOUDFLARE_API_TOKEN OPENSKY_USERNAME OPENSKY_PASSWORD
  )
  for secret in "${known_secrets[@]}"; do
    if ! gcloud secrets describe "$secret" >/dev/null 2>&1; then
      echo "PLACEHOLDER_UPDATE_ME" | gcloud secrets create "$secret" --data-file=-
      echo -e "${YELLOW}  ⚠${NC} Created placeholder for: $secret (update with real value!)"
    else
      echo -e "${GREEN}  ✓${NC} $secret exists"
    fi
  done

  # 3.1 Ensure ADMIN_JOB_TOKEN secret exists (stable token for Cloud Scheduler secured endpoints).
  if ! gcloud secrets describe "$SECRET_ADMIN_JOB_TOKEN" >/dev/null 2>&1; then
    local admin_token_seed
    admin_token_seed=$(openssl rand -hex 12 2>/dev/null || echo dev-admin-token)
    echo -n "$admin_token_seed" | gcloud secrets create "$SECRET_ADMIN_JOB_TOKEN" --data-file=-
    echo -e "${GREEN}  ✓${NC} Created $SECRET_ADMIN_JOB_TOKEN secret"
  else
    echo -e "${GREEN}  ✓${NC} $SECRET_ADMIN_JOB_TOKEN exists"
  fi

  # 3.2 Ensure Cloud Tasks queue for Scout exists and is configured (managed retries).
  # NOTE: Queue name "etigram-scout" may be temporarily unavailable after deletion.
  local scout_queue="${CLOUD_TASKS_SCOUT_QUEUE:-etigram-scout}"
  local scout_background_queue="${CLOUD_TASKS_SCOUT_BACKGROUND_QUEUE:-etigram-scout-bg}"
  if gcloud tasks queues describe "$scout_queue" --location="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
    echo -e "${GREEN}[infra] Cloud Tasks queue exists:${NC} $scout_queue"
  else
    gcloud tasks queues create "$scout_queue" --location="$REGION" --project="$PROJECT_ID" --quiet || true
    echo -e "${GREEN}[infra] Created Cloud Tasks queue:${NC} $scout_queue"
  fi
  if gcloud tasks queues describe "$scout_background_queue" --location="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
    echo -e "${GREEN}[infra] Cloud Tasks background queue exists:${NC} $scout_background_queue"
  else
    gcloud tasks queues create "$scout_background_queue" --location="$REGION" --project="$PROJECT_ID" --quiet || true
    echo -e "${GREEN}[infra] Created Cloud Tasks background queue:${NC} $scout_background_queue"
  fi
  # Configure poison semantics via max-attempts (5), and reasonable backoff.
  gcloud tasks queues update "$scout_queue" \
    --location="$REGION" \
    --project="$PROJECT_ID" \
    --max-attempts=5 \
    --min-backoff=10s \
    --max-backoff=600s \
    --max-retry-duration=3600s \
    --max-dispatches-per-second="${CLOUD_TASKS_SCOUT_MAX_DISPATCHES_PER_SECOND:-6}" \
    --max-concurrent-dispatches="${CLOUD_TASKS_SCOUT_MAX_CONCURRENT_DISPATCHES:-12}" \
    --quiet >/dev/null 2>&1 || true
  echo -e "${GREEN}[infra] ✓${NC} Configured Cloud Tasks queue $scout_queue (maxAttempts=5)"
  gcloud tasks queues update "$scout_background_queue" \
    --location="$REGION" \
    --project="$PROJECT_ID" \
    --max-attempts=5 \
    --min-backoff=20s \
    --max-backoff=900s \
    --max-retry-duration=3600s \
    --max-dispatches-per-second="${CLOUD_TASKS_SCOUT_BACKGROUND_MAX_DISPATCHES_PER_SECOND:-3}" \
    --max-concurrent-dispatches="${CLOUD_TASKS_SCOUT_BACKGROUND_MAX_CONCURRENT_DISPATCHES:-8}" \
    --quiet >/dev/null 2>&1 || true
  echo -e "${GREEN}[infra] ✓${NC} Configured Cloud Tasks background queue $scout_background_queue"

  # 3.3 Ensure Cloud Tasks queue for per-source polling exists and is configured.
  local source_queue="${CLOUD_TASKS_SOURCE_QUEUE:-etigram-source-poll}"
  if gcloud tasks queues describe "$source_queue" --location="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
    echo -e "${GREEN}[infra] Cloud Tasks queue exists:${NC} $source_queue"
  else
    gcloud tasks queues create "$source_queue" --location="$REGION" --project="$PROJECT_ID" --quiet || true
    echo -e "${GREEN}[infra] Created Cloud Tasks queue:${NC} $source_queue"
  fi
  gcloud tasks queues update "$source_queue" \
    --location="$REGION" \
    --project="$PROJECT_ID" \
    --max-attempts=5 \
    --min-backoff=30s \
    --max-backoff=1800s \
    --max-retry-duration=7200s \
    --max-dispatches-per-second=5 \
    --max-concurrent-dispatches=25 \
    --quiet >/dev/null 2>&1 || true
  echo -e "${GREEN}[infra] ✓${NC} Configured Cloud Tasks queue $source_queue (maxConcurrentDispatches=25)"

  # 3.4.1 Ensure Cloud Tasks queue for Profile refresh exists
  local profile_queue="${CLOUD_TASKS_PROFILE_QUEUE:-etigram-profile-refresh}"
  if gcloud tasks queues describe "$profile_queue" --location="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
    echo -e "${GREEN}[infra] Cloud Tasks queue exists:${NC} $profile_queue"
  else
    gcloud tasks queues create "$profile_queue" --location="$REGION" --project="$PROJECT_ID" --quiet || true
    echo -e "${GREEN}[infra] Created Cloud Tasks queue:${NC} $profile_queue"
  fi
  # Configure for profile refresh (higher concurrency for parallel profile updates)
  gcloud tasks queues update "$profile_queue" \
    --location="$REGION" \
    --project="$PROJECT_ID" \
    --max-attempts=5 \
    --min-backoff=10s \
    --max-backoff=600s \
    --max-retry-duration=3600s \
    --max-dispatches-per-second=100 \
    --max-concurrent-dispatches=1000 \
    --quiet >/dev/null 2>&1 || true
  echo -e "${GREEN}[infra] ✓${NC} Configured Cloud Tasks queue $profile_queue (maxConcurrentDispatches=1000)"

  # 3.4.2 Ensure Cloud Tasks queue for Risk pipeline exists
  local risk_queue="${CLOUD_TASKS_RISK_QUEUE:-etigram-risk}"
  if gcloud tasks queues describe "$risk_queue" --location="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
    echo -e "${GREEN}[infra] Cloud Tasks queue exists:${NC} $risk_queue"
  else
    gcloud tasks queues create "$risk_queue" --location="$REGION" --project="$PROJECT_ID" --quiet || true
    echo -e "${GREEN}[infra] Created Cloud Tasks queue:${NC} $risk_queue"
  fi
  # Configure for risk pipeline (separate from scout/profile).
  gcloud tasks queues update "$risk_queue" \
    --location="$REGION" \
    --project="$PROJECT_ID" \
    --max-attempts=5 \
    --min-backoff=10s \
    --max-backoff=600s \
    --max-retry-duration=3600s \
    --max-dispatches-per-second=20 \
    --max-concurrent-dispatches=100 \
    --quiet >/dev/null 2>&1 || true
  echo -e "${GREEN}[infra] ✓${NC} Configured Cloud Tasks queue $risk_queue (maxConcurrentDispatches=100)"

  # 3.5 Ensure GCS bucket for core docs exists
  local docs_bucket="gs://${PROJECT_ID}-core-docs"
  if gcloud storage buckets describe "$docs_bucket" >/dev/null 2>&1; then
    echo -e "${GREEN}[infra] Core docs bucket exists:${NC} $docs_bucket"
  else
    gcloud storage buckets create "$docs_bucket" --location=US --uniform-bucket-level-access
    echo -e "${GREEN}[infra] Created core docs bucket:${NC} $docs_bucket"
  fi
  
  # 3.6 Ensure GCS bucket for RAG documents exists
  local rag_docs_bucket="${PROJECT_ID}-rag-documents"
  if gcloud storage buckets describe "gs://${rag_docs_bucket}" >/dev/null 2>&1; then
    echo -e "${GREEN}[infra] RAG documents bucket exists:${NC} gs://${rag_docs_bucket}"
  else
    gcloud storage buckets create "gs://${rag_docs_bucket}" --location=US --uniform-bucket-level-access
    echo -e "${GREEN}[infra] Created RAG documents bucket:${NC} gs://${rag_docs_bucket}"
  fi
  
  # 3.6.1 Ensure GCS bucket for Etigram fragments exists
  local etigram_fragments_bucket="${PROJECT_ID}-etigram-fragments"
  if gcloud storage buckets describe "gs://${etigram_fragments_bucket}" >/dev/null 2>&1; then
    echo -e "${GREEN}[infra] Etigram fragments bucket exists:${NC} gs://${etigram_fragments_bucket}"
  else
    gcloud storage buckets create "gs://${etigram_fragments_bucket}" --location=US --uniform-bucket-level-access
    echo -e "${GREEN}[infra] Created Etigram fragments bucket:${NC} gs://${etigram_fragments_bucket}"
  fi
  
  # 3.6.2 Ensure GCS bucket for web static files exists (optional, may be created by Firebase Hosting)
  local web_static_bucket="${PROJECT_ID}-web-static"
  if gcloud storage buckets describe "gs://${web_static_bucket}" >/dev/null 2>&1; then
    echo -e "${GREEN}[infra] Web static bucket exists:${NC} gs://${web_static_bucket}"
  else
    # Only create if explicitly requested via env var
    if [[ "${CREATE_WEB_STATIC_BUCKET:-0}" == "1" ]]; then
      gcloud storage buckets create "gs://${web_static_bucket}" --location=US --uniform-bucket-level-access
      echo -e "${GREEN}[infra] Created web static bucket:${NC} gs://${web_static_bucket}"
    else
      echo -e "${BLUE}[infra] Web static bucket not created (set CREATE_WEB_STATIC_BUCKET=1 to create)${NC}"
    fi
  fi
  
  # 3.7 Setup Vertex AI Search permissions and Data Store
  echo -e "${BLUE}[infra] Setting up Vertex AI Search...${NC}"
  
  # Verify Vertex AI APIs are enabled
  echo -e "${BLUE}[infra] Verifying Vertex AI APIs...${NC}"
  local discovery_api_enabled=$(gcloud services list --enabled --filter="name:discoveryengine.googleapis.com" --format="value(name)" --project="$PROJECT_ID" 2>/dev/null | grep -q "discoveryengine" && echo "yes" || echo "no")
  local aiplatform_api_enabled=$(gcloud services list --enabled --filter="name:aiplatform.googleapis.com" --format="value(name)" --project="$PROJECT_ID" 2>/dev/null | grep -q "aiplatform" && echo "yes" || echo "no")
  
  if [[ "$discovery_api_enabled" == "yes" ]]; then
    echo -e "${GREEN}[infra] Discovery Engine API is enabled${NC}"
  else
    echo -e "${YELLOW}[infra] Warning: Discovery Engine API not enabled, enabling...${NC}"
    gcloud services enable discoveryengine.googleapis.com --project="$PROJECT_ID" 2>/dev/null || true
  fi
  
  if [[ "$aiplatform_api_enabled" == "yes" ]]; then
    echo -e "${GREEN}[infra] Vertex AI Platform API is enabled${NC}"
  else
    echo -e "${YELLOW}[infra] Warning: Vertex AI Platform API not enabled, enabling...${NC}"
    gcloud services enable aiplatform.googleapis.com --project="$PROJECT_ID" 2>/dev/null || true
  fi
  
  # Check Vertex AI API keys (for Vertex AI Platform, not public endpoints)
  echo -e "${BLUE}[infra] Checking Vertex AI API keys...${NC}"
  local vertex_keys=$(gcloud services api-keys list --project="$PROJECT_ID" \
    --filter="restrictions.apiTargets.service:aiplatform.googleapis.com OR restrictions.apiTargets.service:discoveryengine.googleapis.com" \
    --format="value(name)" 2>/dev/null | wc -l | tr -d ' ')
  
  if [[ "$vertex_keys" -gt 0 ]]; then
    echo -e "${GREEN}[infra] Found ${vertex_keys} Vertex AI Platform API key(s)${NC}"
  else
    echo -e "${YELLOW}[infra] Note: No Vertex AI Platform API keys found${NC}"
    echo -e "${YELLOW}[infra] Note: Vertex AI Platform typically uses service account auth, not API keys${NC}"
    echo -e "${YELLOW}[infra] API keys are used for public endpoints (Gemini API), not Vertex AI Platform${NC}"
  fi
  
  # Verify GEMINI_API_KEY secret exists (for Gemini/public endpoints)
  if gcloud secrets describe gemini_api_key --project="$PROJECT_ID" >/dev/null 2>&1; then
    echo -e "${GREEN}[infra] GEMINI_API_KEY secret exists (for Gemini/public endpoints)${NC}"
  else
    echo -e "${YELLOW}[infra] Warning: gemini_api_key secret not found${NC}"
  fi

  # Verify Google Geocoding API + key secret (required for paid geocoding fallback).
  if gcloud services list --enabled --project="$PROJECT_ID" --format='value(config.name)' 2>/dev/null | grep -q '^geocoding-backend.googleapis.com$'; then
    echo -e "${GREEN}[infra] Google Geocoding API is enabled${NC}"
  else
    echo -e "${YELLOW}[infra] Warning: Google Geocoding API not enabled${NC}"
  fi
  if gcloud secrets describe google_maps_api_key --project="$PROJECT_ID" >/dev/null 2>&1; then
    local google_maps_key
    google_maps_key=$(gcloud secrets versions access latest --secret=google_maps_api_key --project="$PROJECT_ID" 2>/dev/null || echo "")
    if [[ -n "$google_maps_key" && "$google_maps_key" != "PLACEHOLDER_UPDATE_ME" ]]; then
      echo -e "${GREEN}[infra] google_maps_api_key secret exists${NC}"
    else
      echo -e "${YELLOW}[infra] Warning: google_maps_api_key secret is empty or placeholder${NC}"
    fi
  else
    echo -e "${YELLOW}[infra] Warning: google_maps_api_key secret not found${NC}"
  fi
  
  # Get project number for Google-managed Vertex/Discovery service accounts
  local PROJECT_NUMBER=$(gcloud projects describe "$PROJECT_ID" --format="value(projectNumber)" 2>/dev/null || echo "")
  if [[ -n "$PROJECT_NUMBER" ]]; then
    local VERTEX_AI_SA="service-${PROJECT_NUMBER}@gcp-sa-aiplatform.iam.gserviceaccount.com"
    local DISCOVERY_ENGINE_SA="service-${PROJECT_NUMBER}@gcp-sa-discoveryengine.iam.gserviceaccount.com"
    echo -e "${BLUE}[infra] Vertex AI service account:${NC} $VERTEX_AI_SA"
    echo -e "${BLUE}[infra] Discovery Engine service account:${NC} $DISCOVERY_ENGINE_SA"

    grant_bucket_viewer_access() {
      local bucket_name="$1"
      local service_account="$2"
      local service_label="$3"
      local member="serviceAccount:${service_account}"
      local has_access="no"
      has_access=$(gcloud storage buckets get-iam-policy "gs://${bucket_name}" --format=json 2>/dev/null | grep -q "\"${member}\"" && echo "yes" || echo "no")

      if [[ "$has_access" == "yes" ]]; then
        echo -e "${GREEN}[infra] ${service_label} already has access:${NC} gs://${bucket_name}"
        return 0
      fi

      echo -e "${BLUE}[infra] Granting ${service_label} access to:${NC} gs://${bucket_name}"
      gcloud storage buckets add-iam-policy-binding "gs://${bucket_name}" \
        --member="${member}" \
        --role="roles/storage.objectViewer" 2>/dev/null || {
        gsutil iam ch "${member}:objectViewer" "gs://${bucket_name}" || {
          echo -e "${YELLOW}[infra] Warning: Failed to grant bucket access${NC}"
          echo -e "${YELLOW}[infra] Run manually: gcloud storage buckets add-iam-policy-binding gs://${bucket_name} --member='${member}' --role='roles/storage.objectViewer'${NC}"
        }
      }
    }

    if gcloud iam service-accounts describe "$VERTEX_AI_SA" --project="$PROJECT_ID" >/dev/null 2>&1; then
      grant_bucket_viewer_access "$rag_docs_bucket" "$VERTEX_AI_SA" "Vertex AI SA"
      grant_bucket_viewer_access "$etigram_fragments_bucket" "$VERTEX_AI_SA" "Vertex AI SA"
    else
      echo -e "${YELLOW}[infra] Warning: Vertex AI service account not found yet (skip bucket IAM for now)${NC}"
      echo -e "${YELLOW}[infra] Retry check-infra later after Vertex services fully provision${NC}"
    fi

    if gcloud iam service-accounts describe "$DISCOVERY_ENGINE_SA" --project="$PROJECT_ID" >/dev/null 2>&1; then
      grant_bucket_viewer_access "$rag_docs_bucket" "$DISCOVERY_ENGINE_SA" "Discovery Engine SA"
      grant_bucket_viewer_access "$etigram_fragments_bucket" "$DISCOVERY_ENGINE_SA" "Discovery Engine SA"
      # Discovery Engine import jobs can request temporary bucket creation in the project.
      # Without storage.buckets.create, imports fail with PERMISSION_DENIED.
      gcloud projects add-iam-policy-binding "$PROJECT_ID" \
        --member="serviceAccount:${DISCOVERY_ENGINE_SA}" \
        --role="roles/storage.admin" \
        --condition=None 2>/dev/null || {
        echo -e "${YELLOW}[infra] Warning: Failed to grant roles/storage.admin to Discovery Engine SA${NC}"
      }
    else
      echo -e "${YELLOW}[infra] Warning: Discovery Engine service account not found yet (skip bucket IAM for now)${NC}"
      echo -e "${YELLOW}[infra] Retry check-infra later after Discovery Engine services fully provision${NC}"
    fi
  else
    echo -e "${YELLOW}[infra] Warning: Could not determine project number, skipping Vertex/Discovery SA setup${NC}"
  fi
  
  # Grant backend service account access to Vertex AI / Vertex AI Search
  echo -e "${BLUE}[infra] Granting backend SA access to Vertex AI / Vertex AI Search...${NC}"
  # roles/aiplatform.user allows publisher model predict calls via Vertex AI
  # roles/discoveryengine.editor allows import/export operations
  # roles/discoveryengine.user allows API access (search)
  for role in roles/aiplatform.user roles/discoveryengine.editor roles/discoveryengine.user; do
    gcloud projects add-iam-policy-binding "$PROJECT_ID" \
      --member="serviceAccount:${SA_BACKEND}" \
      --role="$role" \
      --condition=None 2>/dev/null || {
      echo -e "${YELLOW}[infra] Warning: Failed to grant $role (may already exist)${NC}"
    }
  done
  
  # Ensure Vertex AI Search Data Stores exist (global/default_collection).
  echo -e "${BLUE}[infra] Checking/creating Vertex AI Search Data Stores...${NC}"
  local datastore_id=""
  local rag_datastore_id="rag-documents-store"
  local rag_datastore_display_name="${VERTEX_SEARCH_DATA_STORE_DISPLAY_NAME:-RAG Documents Store}"
  local etigram_fragments_datastore_id="${VERTEX_SEARCH_ETIGRAM_DATA_STORE_ID:-etigram-fragments-store}"
  local etigram_fragments_display_name="${VERTEX_SEARCH_ETIGRAM_DATA_STORE_DISPLAY_NAME:-Etigram Fragments Store}"
  local discovery_base_url="https://discoveryengine.googleapis.com/v1beta/projects/${PROJECT_ID}/locations/global/collections/default_collection/dataStores"
  local access_token
  access_token=$(gcloud auth print-access-token --project="$PROJECT_ID" 2>/dev/null || echo "")

  ensure_vertex_datastore() {
    local ds_id="$1"
    local ds_display_name="$2"
    local ds_get_url="${discovery_base_url}/${ds_id}"
    local ds_create_url="${discovery_base_url}?dataStoreId=${ds_id}"

    if [[ -z "$access_token" ]]; then
      echo -e "${YELLOW}[infra] Warning: cannot ensure Data Store ${ds_id} (no access token).${NC}"
      return 1
    fi

    local get_http
    get_http=$(curl -sS -o /dev/null -w "%{http_code}" \
      -H "Authorization: Bearer ${access_token}" \
      -H "X-Goog-User-Project: ${PROJECT_ID}" \
      "$ds_get_url" 2>/dev/null || echo "000")

    if [[ "$get_http" == "200" ]]; then
      echo -e "${GREEN}[infra] Data Store exists:${NC} ${ds_id}"
      return 0
    fi

    echo -e "${BLUE}[infra] Creating Data Store:${NC} ${ds_id}"
    local create_response
    create_response=$(curl -sS -X POST \
      -H "Authorization: Bearer ${access_token}" \
      -H "X-Goog-User-Project: ${PROJECT_ID}" \
      -H "Content-Type: application/json" \
      "$ds_create_url" \
      -d "{
        \"displayName\": \"${ds_display_name}\",
        \"industryVertical\": \"GENERIC\",
        \"solutionTypes\": [\"SOLUTION_TYPE_SEARCH\"],
        \"contentConfig\": \"CONTENT_REQUIRED\"
      }" 2>/dev/null || echo "")

    # Success path: operation/resource name present and no explicit error.
    if echo "$create_response" | grep -q "\"name\"" && ! echo "$create_response" | grep -q "\"error\""; then
      echo -e "${GREEN}[infra] Created Data Store:${NC} ${ds_id}"
      return 0
    fi

    # Idempotent path: already exists.
    if echo "$create_response" | grep -qi "already exists"; then
      echo -e "${GREEN}[infra] Data Store already exists:${NC} ${ds_id}"
      return 0
    fi

    echo -e "${YELLOW}[infra] Failed to create Data Store:${NC} ${ds_id}"
    echo "$create_response" | grep -o '"message":"[^"]*"' | head -1 | sed 's/"message":"\(.*\)"/\1/' || echo "Unknown error"
    echo -e "${YELLOW}[infra] Create manually: https://console.cloud.google.com/gen-app-builder/data-stores?project=${PROJECT_ID}${NC}"
    return 1
  }

  if ensure_vertex_datastore "$rag_datastore_id" "$rag_datastore_display_name"; then
    datastore_id="$rag_datastore_id"
  fi
  ensure_vertex_datastore "$etigram_fragments_datastore_id" "$etigram_fragments_display_name" || true

  # Import documents from GCS into RAG Data Store (best-effort).
  if [[ -n "$datastore_id" && -n "$access_token" ]]; then
    echo -e "${BLUE}[infra] Importing documents from GCS bucket to ${datastore_id}...${NC}"
    local import_response
    import_response=$(curl -sS -X POST \
      -H "Authorization: Bearer ${access_token}" \
      -H "X-Goog-User-Project: ${PROJECT_ID}" \
      -H "Content-Type: application/json" \
      "https://discoveryengine.googleapis.com/v1beta/projects/${PROJECT_ID}/locations/global/collections/default_collection/dataStores/${datastore_id}/branches/default_branch/documents:import" \
      -d "{
        \"gcsSource\": {
          \"inputUris\": [\"gs://${rag_docs_bucket}/**\"],
          \"dataSchema\": \"document\"
        },
        \"reconciliationMode\": \"INCREMENTAL\"
      }" 2>/dev/null || echo "")

    if echo "$import_response" | grep -q "\"name\"" && ! echo "$import_response" | grep -q "\"error\""; then
      echo -e "${GREEN}[infra] GCS import initiated${NC}"
      local operation_name
      operation_name=$(echo "$import_response" | python3 -c "import sys, json; data=json.load(sys.stdin); print(data.get('name', ''))" 2>/dev/null || echo "")
      if [[ -n "$operation_name" ]]; then
        echo -e "${BLUE}[infra] Import operation:${NC} $operation_name"
      fi
    else
      echo -e "${YELLOW}[infra] Note: GCS import may require manual configuration${NC}"
      echo -e "${YELLOW}[infra] Configure in console: https://console.cloud.google.com/gen-app-builder/data-stores?project=${PROJECT_ID}${NC}"
    fi
  fi
  
  # Update Cloud Run service with Data Store ID if we have one
  if [[ -n "$datastore_id" ]]; then
    echo -e "${BLUE}[infra] Updating Cloud Run service with Data Store ID...${NC}"
    if gcloud run services describe etigram-api --region="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
      gcloud run services update etigram-api --region="$REGION" --project="$PROJECT_ID" \
        --update-env-vars "VERTEX_SEARCH_DATA_STORE_ID=$datastore_id" \
        --quiet >/dev/null 2>&1 && \
        echo -e "${GREEN}[infra] Updated Cloud Run service with VERTEX_SEARCH_DATA_STORE_ID=$datastore_id${NC}" || \
        echo -e "${YELLOW}[infra] Warning: Failed to update Cloud Run service (may need manual update)${NC}"
    else
      echo -e "${YELLOW}[infra] Cloud Run service not found, set manually: VERTEX_SEARCH_DATA_STORE_ID=$datastore_id${NC}"
    fi
    
    # Optional: Create Cloud Scheduler job for automatic sync (if enabled)
    # Note: This creates a scheduled job that runs import API call periodically
    if [[ "${ENABLE_VERTEX_SEARCH_SYNC:-}" == "true" ]]; then
      echo -e "${BLUE}[infra] Setting up Cloud Scheduler for automatic sync...${NC}"
      local scheduler_job="vertex-search-sync-${datastore_id}"
      local schedule_cron="${VERTEX_SEARCH_SYNC_SCHEDULE:-0 2 * * *}"  # Default: daily at 2 AM
      
      # Create Cloud Scheduler job that calls import API via HTTP
      # Note: This requires creating a Cloud Function or using Workflows
      echo -e "${YELLOW}[infra] Automatic sync via Cloud Scheduler requires Cloud Function/Workflows setup${NC}"
      echo -e "${YELLOW}[infra] For now, use console to configure sync schedule:${NC}"
      echo -e "${YELLOW}[infra] https://console.cloud.google.com/gen-app-builder/data-stores?project=${PROJECT_ID}${NC}"
    fi
  fi
  
  # 3.8 Setup BigQuery for documents analytics
  echo -e "${BLUE}[infra] Setting up BigQuery for documents analytics...${NC}"
  # Replace hyphens with underscores for BigQuery dataset ID (hyphens not allowed)
  local dataset=$(echo "${PROJECT_ID}_documents" | tr '-' '_')
  local dataset_ref="${PROJECT_ID}:${dataset}"
  
  # Check if dataset exists using REST API (works on Windows too)
  local access_token=$(gcloud auth print-access-token 2>/dev/null)
  if [[ -z "$access_token" ]]; then
    echo -e "${YELLOW}[infra] Warning: Cannot get access token, skipping BigQuery setup${NC}"
    return
  fi
  
  local dataset_exists=$(curl -s -H "Authorization: Bearer $access_token" \
    "https://bigquery.googleapis.com/bigquery/v2/projects/${PROJECT_ID}/datasets/${dataset}" \
    2>/dev/null | grep -q '"datasetId"' && echo "yes" || echo "no")
  
  if [[ "$dataset_exists" == "yes" ]]; then
    echo -e "${GREEN}[infra] BigQuery dataset exists:${NC} ${dataset_ref}"
  else
    echo -e "${BLUE}[infra] Creating BigQuery dataset...${NC}"
    local create_response=$(curl -s -X POST \
      -H "Authorization: Bearer $access_token" \
      -H "Content-Type: application/json" \
      "https://bigquery.googleapis.com/bigquery/v2/projects/${PROJECT_ID}/datasets" \
      -d "{\"datasetReference\":{\"datasetId\":\"${dataset}\",\"projectId\":\"${PROJECT_ID}\"},\"location\":\"US\"}" \
      2>/dev/null)
    
    if echo "$create_response" | grep -q '"datasetId"'; then
      echo -e "${GREEN}[infra] Created BigQuery dataset:${NC} ${dataset_ref}"
    else
      echo -e "${YELLOW}[infra] Warning: Failed to create BigQuery dataset${NC}"
      echo -e "${YELLOW}[infra] Response: ${create_response}${NC}"
      return
    fi
  fi
  
  # Check and create documents_metadata table if not exists
  local table_id="documents_metadata"
  local table_exists=$(curl -s -H "Authorization: Bearer $access_token" \
    "https://bigquery.googleapis.com/bigquery/v2/projects/${PROJECT_ID}/datasets/${dataset}/tables/${table_id}" \
    2>/dev/null | grep -q '"tableId"' && echo "yes" || echo "no")
  
  if [[ "$table_exists" == "yes" ]]; then
    echo -e "${GREEN}[infra] BigQuery table exists:${NC} ${dataset_ref}.${table_id}"
  else
    echo -e "${BLUE}[infra] Creating BigQuery table:${NC} ${table_id}"
    local table_schema='{
      "tableReference": {
        "projectId": "'"${PROJECT_ID}"'",
        "datasetId": "'"${dataset}"'",
        "tableId": "'"${table_id}"'"
      },
      "schema": {
        "fields": [
          {"name": "id", "type": "STRING", "mode": "REQUIRED"},
          {"name": "tenantId", "type": "STRING"},
          {"name": "sourceId", "type": "STRING"},
          {"name": "externalId", "type": "STRING"},
          {"name": "title", "type": "STRING"},
          {"name": "url", "type": "STRING"},
          {"name": "documentPath", "type": "STRING"},
          {"name": "storagePath", "type": "STRING"},
          {"name": "status", "type": "STRING"},
          {"name": "contentType", "type": "STRING"},
          {"name": "documentType", "type": "STRING"},
          {"name": "language", "type": "STRING"},
          {"name": "contentHash", "type": "STRING"},
          {"name": "ingestedAt", "type": "TIMESTAMP"},
          {"name": "createdAt", "type": "TIMESTAMP"},
          {"name": "updatedAt", "type": "TIMESTAMP"}
        ]
      }
    }'
    
    local create_table_response=$(curl -s -X POST \
      -H "Authorization: Bearer $access_token" \
      -H "Content-Type: application/json" \
      "https://bigquery.googleapis.com/bigquery/v2/projects/${PROJECT_ID}/datasets/${dataset}/tables" \
      -d "$table_schema" \
      2>/dev/null)
    
    if echo "$create_table_response" | grep -q '"tableId"'; then
      echo -e "${GREEN}[infra] Created BigQuery table:${NC} ${dataset_ref}.${table_id}"
    else
      echo -e "${YELLOW}[infra] Warning: Failed to create table ${table_id}${NC}"
      echo -e "${YELLOW}[infra] Response: ${create_table_response}${NC}"
    fi
  fi
  
  # Check and create core_docs_metadata table if not exists
  local core_table_id="core_docs_metadata"
  local core_table_exists=$(curl -s -H "Authorization: Bearer $access_token" \
    "https://bigquery.googleapis.com/bigquery/v2/projects/${PROJECT_ID}/datasets/${dataset}/tables/${core_table_id}" \
    2>/dev/null | grep -q '"tableId"' && echo "yes" || echo "no")
  
  if [[ "$core_table_exists" == "yes" ]]; then
    echo -e "${GREEN}[infra] BigQuery table exists:${NC} ${dataset_ref}.${core_table_id}"
  else
    echo -e "${BLUE}[infra] Creating BigQuery table:${NC} ${core_table_id}"
    local core_table_schema='{
      "tableReference": {
        "projectId": "'"${PROJECT_ID}"'",
        "datasetId": "'"${dataset}"'",
        "tableId": "'"${core_table_id}"'"
      },
      "schema": {
        "fields": [
          {"name": "id", "type": "STRING", "mode": "REQUIRED"},
          {"name": "tenantId", "type": "STRING"},
          {"name": "projectId", "type": "STRING"},
          {"name": "filename", "type": "STRING"},
          {"name": "contentType", "type": "STRING"},
          {"name": "description", "type": "STRING"},
          {"name": "sizeBytes", "type": "INTEGER"},
          {"name": "storagePath", "type": "STRING"},
          {"name": "extractedText", "type": "STRING"},
          {"name": "parseStatus", "type": "STRING"},
          {"name": "parseMeta", "type": "JSON"},
          {"name": "pageCount", "type": "INTEGER"},
          {"name": "docType", "type": "STRING"},
          {"name": "createdBy", "type": "STRING"},
          {"name": "createdAt", "type": "TIMESTAMP"},
          {"name": "updatedAt", "type": "TIMESTAMP"}
        ]
      }
    }'
    
    local create_core_table_response=$(curl -s -X POST \
      -H "Authorization: Bearer $access_token" \
      -H "Content-Type: application/json" \
      "https://bigquery.googleapis.com/bigquery/v2/projects/${PROJECT_ID}/datasets/${dataset}/tables" \
      -d "$core_table_schema" \
      2>/dev/null)
    
    if echo "$create_core_table_response" | grep -q '"tableId"'; then
      echo -e "${GREEN}[infra] Created BigQuery table:${NC} ${dataset_ref}.${core_table_id}"
    else
      echo -e "${YELLOW}[infra] Warning: Failed to create table ${core_table_id}${NC}"
      echo -e "${YELLOW}[infra] Response: ${create_core_table_response}${NC}"
    fi
  fi
  
  # 3.9 Setup Redis (Memorystore)
  echo -e "${BLUE}[infra] Setting up Redis (Memorystore)...${NC}"
  local redis_instance="etigram-redis"
  local redis_tier="BASIC"
  local redis_size="1"
  # Use lowercase value expected by gcloud: redis_7_0
  local redis_version="redis_7_0"
  
  # Check if Redis instance already exists
  if gcloud redis instances describe "$redis_instance" --region="$REGION" >/dev/null 2>&1; then
    local redis_host=$(gcloud redis instances describe "$redis_instance" --region="$REGION" --format='value(host)' 2>/dev/null || echo "")
    local redis_port=$(gcloud redis instances describe "$redis_instance" --region="$REGION" --format='value(port)' 2>/dev/null || echo "6379")
    echo -e "${GREEN}[infra] Redis instance exists:${NC} $redis_instance"
    echo -e "${BLUE}[infra] Redis host:${NC} $redis_host:$redis_port"
    
    # Update Cloud Run services with Redis connection info if they exist
    if gcloud run services describe etigram-api --region="$REGION" >/dev/null 2>&1; then
      gcloud run services update etigram-api --region="$REGION" \
        --update-env-vars "REDIS_HOST=$redis_host,REDIS_PORT=$redis_port,REDIS_ADDR=$redis_host:$redis_port" \
        --quiet >/dev/null 2>&1 && \
        echo -e "${GREEN}[infra] Updated etigram-api with Redis connection info${NC}" || \
        echo -e "${YELLOW}[infra] Warning: Failed to update etigram-api with Redis info${NC}"
    fi
    # Note: etigram-ws does NOT use Redis, so skip Redis env vars update
  else
    echo -e "${BLUE}[infra] Creating Redis instance (this may take 10-20 minutes)...${NC}"
    
    # Ensure VPC network exists (use default if available, or create one)
    local vpc_network="default"
    if ! gcloud compute networks describe "$vpc_network" >/dev/null 2>&1; then
      echo -e "${BLUE}[infra] Creating VPC network: $vpc_network${NC}"
      gcloud compute networks create "$vpc_network" --subnet-mode=auto --quiet || {
        echo -e "${YELLOW}[infra] Warning: Failed to create VPC network, using existing${NC}"
        # Try to find an existing network
        vpc_network=$(gcloud compute networks list --format='value(name)' --limit=1 2>/dev/null | head -1 || echo "default")
        echo -e "${BLUE}[infra] Using VPC network: $vpc_network${NC}"
      }
    fi
    
    # Create Redis instance
    # Note: Memorystore requires a specific IP range that doesn't conflict with VPC
    # Try to find an available IP range by checking existing subnets
    local redis_reserved_range=""
    # Get all existing subnet ranges
    local existing_ranges=$(gcloud compute networks subnets list --network="$vpc_network" --format='value(ipCidrRange)' 2>/dev/null || echo "")
    
    # Try different IP ranges until we find one that doesn't conflict
    local candidate_ranges=("10.1.0.0/29" "10.2.0.0/29" "10.3.0.0/29" "10.4.0.0/29" "10.5.0.0/29")
    redis_reserved_range=""
    
    for candidate in "${candidate_ranges[@]}"; do
      local conflicts=false
      for existing in $existing_ranges; do
        # Simple check: if candidate range overlaps with existing (simplified check)
        # In production, should use proper IP range calculation
        if [[ -n "$existing" ]]; then
          # Extract base IP from ranges (simplified - just check if they're different)
          local candidate_base=$(echo "$candidate" | cut -d'/' -f1)
          local existing_base=$(echo "$existing" | cut -d'/' -f1)
          # If they're the same base network, might conflict
          if [[ "$candidate_base" == "$existing_base" ]]; then
            conflicts=true
            break
          fi
        fi
      done
      if [[ "$conflicts" == false ]]; then
        redis_reserved_range="$candidate"
        break
      fi
    done
    
    # Fallback to first candidate if no non-conflicting range found
    if [[ -z "$redis_reserved_range" ]]; then
      redis_reserved_range="${candidate_ranges[0]}"
      echo -e "${YELLOW}[infra] Warning: Could not verify IP range availability, using: $redis_reserved_range${NC}"
      echo -e "${YELLOW}[infra] If creation fails due to IP conflict, manually specify a different range${NC}"
    fi
    
    echo -e "${BLUE}[infra] Creating Redis instance with reserved IP range: $redis_reserved_range${NC}"
    if gcloud redis instances create "$redis_instance" \
      --region="$REGION" \
      --tier="$redis_tier" \
      --size="$redis_size" \
      --network="projects/$PROJECT_ID/global/networks/$vpc_network" \
      --redis-version="$redis_version" \
      --reserved-ip-range="$redis_reserved_range" \
      --quiet; then
      echo -e "${GREEN}[infra] Redis instance created successfully${NC}"
      echo -e "${BLUE}[infra] Waiting for Redis to be ready (this may take a few minutes)...${NC}"
      
      # Wait for Redis to be ready
      local max_wait=600  # 10 minutes
      local waited=0
      while [[ $waited -lt $max_wait ]]; do
        local redis_state=$(gcloud redis instances describe "$redis_instance" --region="$REGION" --format='value(state)' 2>/dev/null || echo "")
        if [[ "$redis_state" == "READY" ]]; then
          break
        fi
        echo -e "${BLUE}[infra] Redis state: $redis_state, waiting...${NC}"
        sleep 10
        waited=$((waited + 10))
      done
      
      local redis_host=$(gcloud redis instances describe "$redis_instance" --region="$REGION" --format='value(host)' 2>/dev/null || echo "")
      local redis_port=$(gcloud redis instances describe "$redis_instance" --region="$REGION" --format='value(port)' 2>/dev/null || echo "6379")
      
      if [[ -n "$redis_host" ]]; then
        echo -e "${GREEN}[infra] Redis is ready${NC}"
        echo -e "${BLUE}[infra] Redis host:${NC} $redis_host:$redis_port"
        
        # Update Cloud Run API service с новыми env (VPC не используем)
        if gcloud run services describe etigram-api --region="$REGION" >/dev/null 2>&1; then
          gcloud run services update etigram-api --region="$REGION" \
            --update-env-vars "REDIS_HOST=$redis_host,REDIS_PORT=$redis_port,REDIS_ADDR=$redis_host:$redis_port" \
            --quiet >/dev/null 2>&1 && \
            echo -e "${GREEN}[infra] Updated etigram-api with Redis connection info${NC}" || \
            echo -e "${YELLOW}[infra] Warning: Failed to update etigram-api (may need manual update)${NC}"
        fi
        # Note: etigram-ws does NOT use Redis, so no VPC connector needed
        
        echo -e "${GREEN}[infra] Redis setup completed successfully${NC}"
        echo -e "${BLUE}[infra] Connection string:${NC} $redis_host:$redis_port"
        echo -e "${BLUE}[infra] Use REDIS_HOST and REDIS_PORT environment variables in your services${NC}"
      else
        echo -e "${YELLOW}[infra] Warning: Redis created but host not available yet${NC}"
        echo -e "${YELLOW}[infra] Check status: gcloud redis instances describe $redis_instance --region=$REGION${NC}"
      fi
    else
      echo -e "${RED}[infra] Failed to create Redis instance${NC}"
      echo -e "${YELLOW}[infra] Common issues:${NC}"
      echo -e "${YELLOW}  - IP range conflicts with existing VPC subnets${NC}"
      echo -e "${YELLOW}  - Insufficient permissions${NC}"
      echo -e "${YELLOW}  - Quota limits${NC}"
      echo -e "${YELLOW}[infra] Create manually:${NC}"
      echo -e "${YELLOW}  gcloud redis instances create $redis_instance --region=$REGION --tier=$redis_tier --size=$redis_size --network=projects/$PROJECT_ID/global/networks/$vpc_network${NC}"
    fi
  fi
  
  # 4. Ensure Pub/Sub topics exist
  echo -e "${BLUE}[infra] Ensuring Pub/Sub topics...${NC}"
  for topic in \
    discovery.status discovery.profile discovery.answer discovery.project \
    document.process ground.refresh chat.ontology.process \
    genai.stream genai.stream.error genai.stream.tool_call genai.stream.tool_result \
    artifact.generation.started artifact.section.generating artifact.section.chunk artifact.section.completed \
    artifact.assembly.started artifact.assembly.chunk artifact.assembly.completed \
    artifact.generation.completed artifact.generation.error \
    analysis.status \
    agent.update \
    interaction.created interaction.updated \
    verified.stream; do
    if ! gcloud pubsub topics describe "$topic" >/dev/null 2>&1; then
      gcloud pubsub topics create "$topic" --quiet
      echo -e "${GREEN}  ✓${NC} Created topic: $topic"
    else
      echo -e "${GREEN}  ✓${NC} $topic exists"
    fi
  done

  # 4.1 Ensure aggregated topics used by etigram-ws exist (Etigram realtime depends on etigram.horizon.events)
  echo -e "${BLUE}[infra] Ensuring Pub/Sub aggregated topics for etigram-ws...${NC}"
  agg_topics=(
    "etigram.genai.streams"
    "etigram.discovery.events"
    "etigram.artifact.events"
    "etigram.interaction.events"
    "etigram.analysis.events"
    "etigram.verified.streams"
    "etigram.horizon.events"
    "etigram.operations.events"
  )
  for topic in "${agg_topics[@]}"; do
    if ! gcloud pubsub topics describe "$topic" --project="$PROJECT_ID" >/dev/null 2>&1; then
      gcloud pubsub topics create "$topic" --project="$PROJECT_ID" --quiet || true
      echo -e "${GREEN}  ✓${NC} Created topic: $topic"
    else
      echo -e "${GREEN}  ✓${NC} $topic exists"
    fi
  done

  # 4.2 Ensure etigram-ws subscriptions exist for aggregated topics (Subscriber uses <topic>-ws-broker)
  echo -e "${BLUE}[infra] Ensuring Pub/Sub subscriptions for etigram-ws...${NC}"
  for topic in "${agg_topics[@]}"; do
    sub_id="${topic}-ws-broker"
    if gcloud pubsub subscriptions describe "$sub_id" --project="$PROJECT_ID" >/dev/null 2>&1; then
      # Ensure message ordering is enabled (recreate if needed)
      ordering=$(gcloud pubsub subscriptions describe "$sub_id" --project="$PROJECT_ID" --format="value(enableMessageOrdering)" 2>/dev/null || echo "False")
      if [[ "$ordering" != "True" ]]; then
        echo -e "${YELLOW}[infra] Recreating subscription with ordering enabled:${NC} $sub_id"
        gcloud pubsub subscriptions delete "$sub_id" --project="$PROJECT_ID" --quiet >/dev/null 2>&1 || true
        gcloud pubsub subscriptions create "$sub_id" \
          --project="$PROJECT_ID" \
          --topic="$topic" \
          --enable-message-ordering \
          --quiet >/dev/null 2>&1 || true
      fi
      echo -e "${GREEN}  ✓${NC} $sub_id exists"
    else
      gcloud pubsub subscriptions create "$sub_id" \
        --project="$PROJECT_ID" \
        --topic="$topic" \
        --enable-message-ordering \
        --quiet >/dev/null 2>&1 || true
      echo -e "${GREEN}  ✓${NC} Created subscription: $sub_id"
    fi
  done

  # 4.5 Ensure Pub/Sub worker subscriptions (grounding, document processor, chat ontology)
  echo -e "${BLUE}[infra] Ensuring Pub/Sub worker subscriptions...${NC}"
  local worker_subs=(
    "ground.refresh:ground.refresh.worker"
    "etigram.operations.events:etigram.operations.events.worker"
    "etigram.artifact.events:etigram.artifact.events.document-processor.worker"
    "chat.ontology.process:chat.ontology.process.worker"
  )
  for pair in "${worker_subs[@]}"; do
    local topic="${pair%%:*}"
    local sub_id="${pair#*:}"
    if gcloud pubsub subscriptions describe "$sub_id" --project="$PROJECT_ID" >/dev/null 2>&1; then
      echo -e "${GREEN}  ✓${NC} $sub_id exists"
    else
      if gcloud pubsub topics describe "$topic" --project="$PROJECT_ID" >/dev/null 2>&1; then
        gcloud pubsub subscriptions create "$sub_id" \
          --project="$PROJECT_ID" \
          --topic="$topic" \
          --quiet >/dev/null 2>&1 || true
        echo -e "${GREEN}  ✓${NC} Created subscription: $sub_id"
      fi
    fi
  done

  # 5. Ensure Cloud Scheduler jobs when deploying API OR when explicitly asked (e.g. --etigram-watchdog-only)
  if [[ "$TARGET_API" -eq 1 || "${TARGET_ETIGRAM_WATCHDOG:-0}" -eq 1 ]]; then
    echo -e "${BLUE}[infra] Ensuring Cloud Scheduler jobs (optional)...${NC}"
    if gcloud services list --enabled --filter="config.name: cloudscheduler.googleapis.com" --format="value(config.name)" | grep -q cloudscheduler.googleapis.com; then
      SVC_URL=$(gcloud run services describe etigram-api --region "$REGION" --format='value(status.url)' 2>/dev/null || true)
      
      if [[ -n "$SVC_URL" ]]; then
        # Resolve the stable admin job token from Secret Manager (single source of truth).
        ADMIN_TOKEN=$(gcloud secrets versions access latest --secret="$SECRET_ADMIN_JOB_TOKEN" 2>/dev/null || true)
        if [[ -z "$ADMIN_TOKEN" ]]; then
          # Best effort: create a new version if access failed for some reason.
          ADMIN_TOKEN=$(openssl rand -hex 12 2>/dev/null || echo dev-admin-token)
          echo -n "$ADMIN_TOKEN" | gcloud secrets versions add "$SECRET_ADMIN_JOB_TOKEN" --data-file=- >/dev/null 2>&1 || true
        fi

        # 5a. Source coordinator job
        JOB_NAME="etigram-source-poller"
        # Create or update a job that calls admin source coordination with header X-Job-Token
        if gcloud scheduler jobs describe "$JOB_NAME" --location="$REGION" >/dev/null 2>&1; then
          gcloud scheduler jobs update http "$JOB_NAME" \
            --location="$REGION" \
            --schedule="*/15 * * * *" \
            --uri="$SVC_URL/api/v1/admin/sources/coordinate" \
            --http-method=POST \
            --oidc-service-account-email="$SA_BACKEND" \
            --oidc-token-audience="$SVC_URL" \
            --update-headers="X-Job-Token=$ADMIN_TOKEN" \
            --attempt-deadline=60s \
            --quiet || true
        else
          gcloud scheduler jobs create http "$JOB_NAME" \
            --location="$REGION" \
            --schedule="*/15 * * * *" \
            --uri="$SVC_URL/api/v1/admin/sources/coordinate" \
            --http-method=POST \
            --oidc-service-account-email="$SA_BACKEND" \
            --oidc-token-audience="$SVC_URL" \
            --headers="X-Job-Token=$ADMIN_TOKEN" \
            --attempt-deadline=60s \
            --quiet || true
        fi
        echo -e "${GREEN}[infra] ✓${NC} Source coordinator scheduler job ensured"
        
        # 5b. Artifact scheduler job (checks for scheduled artifact updates)
        JOB_NAME="etigram-artifact-scheduler"
        # Schedule: every hour at minute 0 (e.g., 00:00, 01:00, 02:00, ...)
        # This checks all artifacts and triggers updates for those with daily/weekly schedules
        if gcloud scheduler jobs describe "$JOB_NAME" --location="$REGION" >/dev/null 2>&1; then
          gcloud scheduler jobs update http "$JOB_NAME" \
            --location="$REGION" \
            --schedule="0 * * * *" \
            --uri="$SVC_URL/api/v1/artifacts/scheduled-update" \
            --http-method=POST \
            --update-headers="User-Agent=Google-Cloud-Scheduler" \
            --attempt-deadline=300s \
            --quiet || true
        else
          gcloud scheduler jobs create http "$JOB_NAME" \
            --location="$REGION" \
            --schedule="0 * * * *" \
            --uri="$SVC_URL/api/v1/artifacts/scheduled-update" \
            --http-method=POST \
            --headers="User-Agent=Google-Cloud-Scheduler" \
            --attempt-deadline=300s \
            --quiet || true
        fi
        echo -e "${GREEN}[infra] ✓${NC} Artifact scheduler job ensured (runs hourly)"

        # 5c. Subscription billing job (daily billing cycle)
        JOB_NAME="subscription-billing-daily"
        if gcloud scheduler jobs describe "$JOB_NAME" --location="$REGION" >/dev/null 2>&1; then
          gcloud scheduler jobs update http "$JOB_NAME" \
            --location="$REGION" \
            --schedule="0 2 * * *" \
            --uri="$SVC_URL/api/v1/subscriptions/billing" \
            --http-method=POST \
            --update-headers="User-Agent=Google-Cloud-Scheduler" \
            --attempt-deadline=300s \
            --time-zone="UTC" \
            --quiet || true
        else
          gcloud scheduler jobs create http "$JOB_NAME" \
            --location="$REGION" \
            --schedule="0 2 * * *" \
            --uri="$SVC_URL/api/v1/subscriptions/billing" \
            --http-method=POST \
            --headers="User-Agent=Google-Cloud-Scheduler" \
            --attempt-deadline=300s \
            --time-zone="UTC" \
            --quiet || true
        fi
        echo -e "${GREEN}[infra] ✓${NC} Subscription billing scheduler job ensured (runs daily at 02:00 UTC)"

        # 5d. Etigram Watchdog job (optional; enabled via --etigram-watchdog)
        if [[ "${TARGET_ETIGRAM_WATCHDOG}" -eq 1 ]]; then
          echo -e "${BLUE}[infra] Ensuring Horizon Watchdog scheduler job...${NC}"

          # Ensure API env vars aligned with Cloud Scheduler mode
          # (disable any internal ticker if introduced later; keep knobs explicit)
          gcloud run services update etigram-api --region "$REGION" \
            --update-env-vars "ENABLE_ETIGRAM_WATCHDOG=1,DISABLE_ETIGRAM_WATCHDOG_TICKER=true,ETIGRAM_WATCHDOG_CRON_LIMIT=200,ETIGRAM_WATCHDOG_CRON_LOCK_TTL=9m" \
            --quiet || true

          JOB_NAME="etigram-watchdog"
          WATCHDOG_LIMIT="${ETIGRAM_WATCHDOG_CRON_LIMIT:-200}"
          WATCHDOG_SCHEDULE="${ETIGRAM_WATCHDOG_CRON_SCHEDULE:-*/5 * * * *}"
          WATCHDOG_URI="$SVC_URL/api/v1/admin/etigram/watchdog/run?limit=$WATCHDOG_LIMIT"

          if gcloud scheduler jobs describe "$JOB_NAME" --location="$REGION" >/dev/null 2>&1; then
            gcloud scheduler jobs update http "$JOB_NAME" \
              --location="$REGION" \
              --schedule="$WATCHDOG_SCHEDULE" \
              --uri="$WATCHDOG_URI" \
              --http-method=POST \
              --oidc-service-account-email="$SA_BACKEND" \
              --oidc-token-audience="$SVC_URL" \
              --update-headers="X-Job-Token=$ADMIN_TOKEN" \
              --attempt-deadline=540s \
              --quiet || true
          else
            gcloud scheduler jobs create http "$JOB_NAME" \
              --location="$REGION" \
              --schedule="$WATCHDOG_SCHEDULE" \
              --uri="$WATCHDOG_URI" \
              --http-method=POST \
              --oidc-service-account-email="$SA_BACKEND" \
              --oidc-token-audience="$SVC_URL" \
              --headers="X-Job-Token=$ADMIN_TOKEN" \
              --attempt-deadline=540s \
              --quiet || true
          fi
          echo -e "${GREEN}[infra] ✓${NC} Etigram Watchdog scheduler job ensured ($WATCHDOG_SCHEDULE)"
        fi
      else
        echo -e "${YELLOW}[infra] Skipping scheduler jobs (api url not resolved).${NC}"
      fi
    else
      echo -e "${YELLOW}[infra] Cloud Scheduler API not enabled or not available; skipping job creation.${NC}"
    fi
  fi
}

# Clean up old Cloud Run revisions, keeping only the last N
# Usage: cleanup_old_revisions <service-name> <region> <keep-count>
cleanup_old_revisions() {
  local service="$1"
  local region="$2"
  local keep_count="${3:-10}"
  
  echo -e "${BLUE}[cleanup] Cleaning up old revisions for $service (keeping last $keep_count)...${NC}"
  
  # Get active revision (the one receiving traffic)
  local active_revision=$(gcloud run services describe "$service" --region "$region" \
    --format='value(status.traffic[0].revisionName)' 2>/dev/null || echo "")
  
  # Get all revisions sorted by creation time (newest first)
  # Format: REVISION_NAME
  local all_revisions=$(gcloud run revisions list --service="$service" --region="$region" \
    --format='value(metadata.name)' --sort-by='~metadata.creationTimestamp' 2>/dev/null || echo "")
  
  if [[ -z "$all_revisions" ]]; then
    echo -e "${YELLOW}[cleanup] No revisions found for $service${NC}"
    return 0
  fi
  
  # Count total revisions
  local total=$(echo "$all_revisions" | grep -c . || echo "0")
  
  if [[ "$total" -le "$keep_count" ]]; then
    echo -e "${GREEN}[cleanup] Only $total revisions exist (keeping all)${NC}"
    return 0
  fi
  
  # Get revisions to delete (all except the last N, but skip active one)
  local deleted=0
  local skipped_active=0
  
  # Skip first N revisions (the ones to keep) and process the rest
  echo "$all_revisions" | tail -n +$((keep_count + 1)) | while read -r revision_name; do
    if [[ -z "$revision_name" ]]; then
      continue
    fi
    
    if [[ "$revision_name" == "$active_revision" ]]; then
      echo -e "${YELLOW}[cleanup] Skipping active revision: $revision_name${NC}" >&2
      continue
    fi
    
    # Check if revision is retired (safe to delete)
    local revision_status=$(gcloud run revisions describe "$revision_name" --region="$region" \
      --format='value(status.conditions[?type=="Active"].status)' 2>/dev/null || echo "")
    
    # Only delete if revision is retired or status check failed (retry later)
    if [[ "$revision_status" == "False" ]] || [[ -z "$revision_status" ]]; then
      echo -e "${BLUE}[cleanup] Deleting revision: $revision_name${NC}" >&2
      if gcloud run revisions delete "$revision_name" --region="$region" --quiet 2>/dev/null; then
        echo "deleted" >&2
      else
        echo -e "${YELLOW}[cleanup] Failed to delete $revision_name (may still be retiring, will retry next deploy)${NC}" >&2
      fi
    else
      echo -e "${YELLOW}[cleanup] Skipping $revision_name (still active, will retry next deploy)${NC}" >&2
    fi
  done
  
  echo -e "${GREEN}[cleanup] Cleanup completed for $service${NC}"
}

deploy_api() {
  echo -e "${BLUE}[api] Pre-deployment: validating Go build...${NC}"
  (cd "$API_DIR" && go build -o /dev/null ./cmd/server) || {
    echo -e "${RED}[api] Go build failed! Fix errors before deploying.${NC}"
    exit 1
  }
  echo -e "${GREEN}[api] Go build successful locally${NC}"

  # Ensure Etigram fragments dedicated bucket exists (even on --api deploys that skip infra).
  local etigram_fragments_bucket="${ETIGRAM_FRAGMENTS_BUCKET:-${PROJECT_ID}-etigram-fragments}"
  if gcloud storage buckets describe "gs://${etigram_fragments_bucket}" --project="$PROJECT_ID" >/dev/null 2>&1; then
    echo -e "${GREEN}[api] Etigram fragments bucket exists:${NC} gs://${etigram_fragments_bucket}"
  else
    echo -e "${BLUE}[api] Creating Etigram fragments bucket:${NC} gs://${etigram_fragments_bucket}"
    gcloud storage buckets create "gs://${etigram_fragments_bucket}" --location=US --uniform-bucket-level-access --project="$PROJECT_ID" || true
  fi

  # Ensure dedicated Vertex AI Search Data Store for Etigram fragments exists (store isolation; no filters).
  local etigram_fragments_datastore="${VERTEX_SEARCH_ETIGRAM_DATA_STORE_ID:-etigram-fragments-store}"
  local access_token
  access_token=$(gcloud auth print-access-token --project="$PROJECT_ID" 2>/dev/null || true)
  if [[ -n "$access_token" ]]; then
    local ds_get_url="https://discoveryengine.googleapis.com/v1beta/projects/${PROJECT_ID}/locations/global/collections/default_collection/dataStores/${etigram_fragments_datastore}"
    local ds_create_url="https://discoveryengine.googleapis.com/v1beta/projects/${PROJECT_ID}/locations/global/collections/default_collection/dataStores?dataStoreId=${etigram_fragments_datastore}"
    local ds_http
    ds_http=$(curl -sS -o /dev/null -w "%{http_code}" \
      -H "Authorization: Bearer ${access_token}" \
      -H "X-Goog-User-Project: ${PROJECT_ID}" \
      "$ds_get_url" 2>/dev/null || echo "000")
    if [[ "$ds_http" == "200" ]]; then
      echo -e "${GREEN}[api] Etigram fragments Data Store exists:${NC} ${etigram_fragments_datastore}"
    else
      echo -e "${BLUE}[api] Creating Etigram fragments Data Store:${NC} ${etigram_fragments_datastore}"
      curl -sS -X POST \
        -H "Authorization: Bearer ${access_token}" \
        -H "X-Goog-User-Project: ${PROJECT_ID}" \
        -H "Content-Type: application/json" \
        "$ds_create_url" \
        -d "{
          \"displayName\": \"Etigram Fragments Store\",
          \"industryVertical\": \"GENERIC\",
          \"solutionTypes\": [\"SOLUTION_TYPE_SEARCH\"],
          \"contentConfig\": \"CONTENT_REQUIRED\"
        }" >/dev/null 2>&1 || true
    fi
  else
    echo -e "${YELLOW}[api] Warning: cannot ensure Etigram fragments Data Store (no access token).${NC}"
  fi

  # Ensure Cloud Tasks queue exists even for --api-only deploys (managed Scout execution).
  # NOTE: default queue is v2 to avoid the "recently deleted queue" lockout.
  local scout_queue="${CLOUD_TASKS_SCOUT_QUEUE:-etigram-scout}"
  local scout_background_queue="${CLOUD_TASKS_SCOUT_BACKGROUND_QUEUE:-etigram-scout-bg}"
  if ! gcloud tasks queues describe "$scout_queue" --location="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
    echo -e "${BLUE}[api] Creating Cloud Tasks queue:${NC} $scout_queue"
    gcloud tasks queues create "$scout_queue" --location="$REGION" --project="$PROJECT_ID" --quiet >/dev/null 2>&1 || true
  fi
  if ! gcloud tasks queues describe "$scout_background_queue" --location="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
    echo -e "${BLUE}[api] Creating Cloud Tasks background queue:${NC} $scout_background_queue"
    gcloud tasks queues create "$scout_background_queue" --location="$REGION" --project="$PROJECT_ID" --quiet >/dev/null 2>&1 || true
  fi
  gcloud tasks queues update "$scout_queue" \
    --location="$REGION" \
    --project="$PROJECT_ID" \
    --max-attempts=5 \
    --min-backoff=10s \
    --max-backoff=600s \
    --max-retry-duration=3600s \
    --max-dispatches-per-second="${CLOUD_TASKS_SCOUT_MAX_DISPATCHES_PER_SECOND:-6}" \
    --max-concurrent-dispatches="${CLOUD_TASKS_SCOUT_MAX_CONCURRENT_DISPATCHES:-12}" \
    --quiet >/dev/null 2>&1 || true
  gcloud tasks queues update "$scout_background_queue" \
    --location="$REGION" \
    --project="$PROJECT_ID" \
    --max-attempts=5 \
    --min-backoff=20s \
    --max-backoff=900s \
    --max-retry-duration=3600s \
    --max-dispatches-per-second="${CLOUD_TASKS_SCOUT_BACKGROUND_MAX_DISPATCHES_PER_SECOND:-3}" \
    --max-concurrent-dispatches="${CLOUD_TASKS_SCOUT_BACKGROUND_MAX_CONCURRENT_DISPATCHES:-8}" \
    --quiet >/dev/null 2>&1 || true

  # Ensure Cloud Tasks queue exists for per-source polling execution.
  local source_queue="${CLOUD_TASKS_SOURCE_QUEUE:-etigram-source-poll}"
  if ! gcloud tasks queues describe "$source_queue" --location="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
    echo -e "${BLUE}[api] Creating Cloud Tasks queue:${NC} $source_queue"
    gcloud tasks queues create "$source_queue" --location="$REGION" --project="$PROJECT_ID" --quiet >/dev/null 2>&1 || true
  fi
  gcloud tasks queues update "$source_queue" \
    --location="$REGION" \
    --project="$PROJECT_ID" \
    --max-attempts=5 \
    --min-backoff=30s \
    --max-backoff=1800s \
    --max-retry-duration=7200s \
    --max-dispatches-per-second=5 \
    --max-concurrent-dispatches=25 \
    --quiet >/dev/null 2>&1 || true

  # Ensure Cloud Tasks queue exists for risk pipeline as well.
  local risk_queue="${CLOUD_TASKS_RISK_QUEUE:-etigram-risk}"
  if ! gcloud tasks queues describe "$risk_queue" --location="$REGION" --project="$PROJECT_ID" >/dev/null 2>&1; then
    echo -e "${BLUE}[api] Creating Cloud Tasks queue:${NC} $risk_queue"
    gcloud tasks queues create "$risk_queue" --location="$REGION" --project="$PROJECT_ID" --quiet >/dev/null 2>&1 || true
  fi
  gcloud tasks queues update "$risk_queue" \
    --location="$REGION" \
    --project="$PROJECT_ID" \
    --max-attempts=5 \
    --min-backoff=10s \
    --max-backoff=600s \
    --max-retry-duration=3600s \
    --max-dispatches-per-second=20 \
    --max-concurrent-dispatches=100 \
    --quiet >/dev/null 2>&1 || true

  # Ensure backend service account can enqueue tasks (idempotent; safe to call on --api-only).
  gcloud projects add-iam-policy-binding "$PROJECT_ID" \
    --member="serviceAccount:$SA_BACKEND" \
    --role="roles/cloudtasks.enqueuer" \
    --condition=None \
    --quiet >/dev/null 2>&1 || true

  # Cloud Tasks HTTP tasks with OIDC require the creator principal to have iam.serviceAccounts.actAs
  # on the service account used for OIDC token minting (here we use the backend SA itself).
  gcloud iam service-accounts add-iam-policy-binding "$SA_BACKEND" \
    --member="serviceAccount:$SA_BACKEND" \
    --role="roles/iam.serviceAccountUser" \
    --quiet >/dev/null 2>&1 || true

  # Clean up any local binaries before Cloud Build (they're not needed, built in Docker)
  echo -e "${BLUE}[api] Cleaning up local build artifacts...${NC}"
  (cd "$API_DIR" && rm -f server verified-proxy etigram-ws main test-agent-orchestrator cmd/*/server cmd/*/verified-proxy cmd/*/etigram-ws cmd/*/main 2>/dev/null || true)
  (cd "$API_DIR" && rm -f etigram_* add_* check_* check-* seed_* migrate_* inspect_* purge_* geonames_* loc_* watchdog_* test_* test-* sync-* reindex-* update-* clear_* run_* find_* gemini_* openai_* 2>/dev/null || true)

  echo -e "${BLUE}[api] Building container image (Artifact Registry)...${NC}"
  local service="etigram-api"
  local image="us-central1-docker.pkg.dev/$PROJECT_ID/cloud-run-source-deploy/$service:$(date +%s)"

  # PayPal secrets (optional - PayPal integration will be disabled if not set)
  local paypal_secrets="GEMINI_API_KEY=gemini_api_key:latest,OPENAI_API_KEY=openai_api_key:latest,ANTHROPIC_API_KEY=anthropic_api_key:latest,DEEPSEEK_API_KEY=deepseek_api_key:latest,GROK_API_KEY=grok_api_key:latest,TAVILY_API_KEY=tavily_api_key:latest,ADMIN_JOB_TOKEN=${SECRET_ADMIN_JOB_TOKEN}:latest"
  
  # ACLED secrets (optional)
  if gcloud secrets describe ACLED_ACCESS_TOKEN >/dev/null 2>&1; then
    paypal_secrets="$paypal_secrets,ACLED_ACCESS_TOKEN=ACLED_ACCESS_TOKEN:latest"
  fi

  # Google Maps API key (optional - for geocoding org/facility addresses)
  if gcloud secrets describe google_maps_api_key --project="$PROJECT_ID" >/dev/null 2>&1; then
    paypal_secrets="$paypal_secrets,GOOGLE_MAPS_API_KEY=google_maps_api_key:latest"
  fi

  # OpenCorporates API token (optional - for org enrichment; API returns 401 without it)
  if gcloud secrets describe open_corporates_api_token --project="$PROJECT_ID" >/dev/null 2>&1; then
    paypal_secrets="$paypal_secrets,OPEN_CORPORATES_API_TOKEN=open_corporates_api_token:latest"
  fi

  if gcloud secrets describe paypal_client_id >/dev/null 2>&1 && gcloud secrets describe paypal_secret >/dev/null 2>&1; then
    paypal_secrets="$paypal_secrets,PAYPAL_CLIENT_ID=paypal_client_id:latest,PAYPAL_SECRET=paypal_secret:latest"
    if gcloud secrets describe paypal_webhook_id >/dev/null 2>&1; then
      paypal_secrets="$paypal_secrets,PAYPAL_WEBHOOK_ID=paypal_webhook_id:latest"
    fi
  fi

  # AISStream API key (optional - for vessel AIS layer on map)
  if gcloud secrets describe aisstream_api_key --project="$PROJECT_ID" >/dev/null 2>&1; then
    paypal_secrets="$paypal_secrets,AISSTREAM_API_KEY=aisstream_api_key:latest"
  fi

  # Build and push to Artifact Registry
  local cloud_build_args=()
  if [[ -n "${CLOUD_BUILD_TIMEOUT:-}" ]]; then
    cloud_build_args+=(--timeout "$CLOUD_BUILD_TIMEOUT")
  fi
  if [[ -n "${CLOUD_BUILD_MACHINE_TYPE:-}" ]]; then
    cloud_build_args+=(--machine-type "$CLOUD_BUILD_MACHINE_TYPE")
  fi
  if [[ ${#cloud_build_args[@]} -gt 0 ]]; then
    gcloud builds submit "$API_DIR" \
      --project "$PROJECT_ID" \
      "${cloud_build_args[@]}" \
      --tag "$image" \
      --quiet
  else
    gcloud builds submit "$API_DIR" \
      --project "$PROJECT_ID" \
      --tag "$image" \
      --quiet
  fi

  # Check if Redis exists and get connection info
  local redis_host=""
  local redis_port="6379"
  local redis_instance="etigram-redis"
  if gcloud redis instances describe "$redis_instance" --region="$REGION" >/dev/null 2>&1; then
    redis_host=$(gcloud redis instances describe "$redis_instance" --region="$REGION" --format='value(host)' 2>/dev/null || echo "")
    redis_port=$(gcloud redis instances describe "$redis_instance" --region="$REGION" --format='value(port)' 2>/dev/null || echo "6379")
  fi
  
  # Get Telegram service URL if it exists
  local telegram_url=""
  local telegram_service="etigram-telegram"
  if gcloud run services describe "$telegram_service" --region="$REGION" >/dev/null 2>&1; then
    telegram_url=$(gcloud run services describe "$telegram_service" --region="$REGION" --format='value(status.url)' 2>/dev/null || echo "")
    if [[ -n "$telegram_url" ]]; then
      echo -e "${BLUE}[api] Found Telegram service:${NC} $telegram_url"
    fi
  fi

  local event_gate_url="${EVENT_GATE_SERVICE_URL:-}"
  local event_gate_service="etigram-event-gate"
  if [[ -z "$event_gate_url" ]] && gcloud run services describe "$event_gate_service" --region="$REGION" >/dev/null 2>&1; then
    event_gate_url=$(gcloud run services describe "$event_gate_service" --region="$REGION" --format='value(status.url)' 2>/dev/null || echo "")
  fi
  if [[ -n "$event_gate_url" ]]; then
    echo -e "${BLUE}[api] Found Event Gate service:${NC} $event_gate_url"
  fi

  local entity_extract_url="${ENTITY_EXTRACT_SERVICE_URL:-}"
  local entity_extract_service="etigram-entity-extract"
  if [[ -z "$entity_extract_url" ]] && gcloud run services describe "$entity_extract_service" --region="$REGION" >/dev/null 2>&1; then
    entity_extract_url=$(gcloud run services describe "$entity_extract_service" --region="$REGION" --format='value(status.url)' 2>/dev/null || echo "")
  fi
  if [[ -n "$entity_extract_url" ]]; then
    echo -e "${BLUE}[api] Found Entity Extract service:${NC} $entity_extract_url"
  fi
  
  # Build env vars string
  # Note: VERTEX_SEARCH_LOCATION must be "global" for Discovery Engine Data Stores
  # Data Stores are created in "global" region, but search API uses the same location
  local vertex_search_ds_id="${VERTEX_SEARCH_DATA_STORE_ID_VALUE:-rag-documents-store}"
  # Best-effort: resolve service URL (stable per service) to construct Cloud Tasks target URL.
  local existing_api_url=""
  local existing_nlp_env_json=""
  local existing_event_gate_mode=""
  local existing_entity_extract_mode=""
  if gcloud run services describe "$service" --region "$REGION" --project "$PROJECT_ID" >/dev/null 2>&1; then
    existing_api_url=$(gcloud run services describe "$service" --region "$REGION" --project "$PROJECT_ID" --format='value(status.url)' 2>/dev/null || echo "")
    existing_nlp_env_json=$(gcloud run services describe "$service" --region "$REGION" --project "$PROJECT_ID" --format='json(spec.template.spec.containers[0].env)' 2>/dev/null || echo "")
    if [[ -n "$existing_nlp_env_json" ]]; then
      existing_event_gate_mode=$(printf '%s' "$existing_nlp_env_json" | python3 -c 'import json,sys; env=json.load(sys.stdin); print(next((item.get("value","") for item in env if item.get("name")=="EVENT_GATE_MODE"), ""))' 2>/dev/null || echo "")
      existing_entity_extract_mode=$(printf '%s' "$existing_nlp_env_json" | python3 -c 'import json,sys; env=json.load(sys.stdin); print(next((item.get("value","") for item in env if item.get("name")=="ENTITY_EXTRACT_MODE"), ""))' 2>/dev/null || echo "")
    fi
  fi
  local resolved_event_gate_mode="${EVENT_GATE_MODE:-$existing_event_gate_mode}"
  local resolved_entity_extract_mode="${ENTITY_EXTRACT_MODE:-$existing_entity_extract_mode}"
  [[ -z "$resolved_event_gate_mode" ]] && resolved_event_gate_mode="shadow"
  [[ -z "$resolved_entity_extract_mode" ]] && resolved_entity_extract_mode="shadow"

  local enable_etigram_watchdog="${ENABLE_ETIGRAM_WATCHDOG:-0}"
  if [[ "${TARGET_ETIGRAM_WATCHDOG:-0}" -eq 1 ]]; then
    enable_etigram_watchdog="1"
  fi
  local env_vars="GCP_PROJECT_ID=$PROJECT_ID,GOOGLE_CLOUD_PROJECT=$PROJECT_ID,FIREBASE_AUTH_PROJECT_ID=$FIREBASE_PROJECT_ID,FRONTEND_ORIGINS=https://etigram.one|https://www.etigram.one|https://*.etigram.one|https://etigram.web.app|https://etigram.firebaseapp.com|http://localhost:5173|http://localhost:3000,CORE_DOCS_BUCKET=${PROJECT_ID}-core-docs,RAG_DOCUMENTS_BUCKET=${PROJECT_ID}-rag-documents,VERTEX_SEARCH_LOCATION=global,VERTEX_SEARCH_DATA_STORE_ID=${vertex_search_ds_id},ENABLE_INTERNAL_WS_SUBSCRIBER=0,DISABLE_POLLER_TICKER=true,ENABLE_SCOUT_FIRESTORE_POLLER=0,ENABLE_CLOUD_TASKS_SCOUT=1,ENABLE_CLOUD_TASKS_RISK=1,CLOUD_TASKS_LOCATION=$REGION,CLOUD_TASKS_SCOUT_QUEUE=${scout_queue},CLOUD_TASKS_SCOUT_BACKGROUND_QUEUE=${scout_background_queue},CLOUD_TASKS_SCOUT_BACKGROUND_DELAY=${CLOUD_TASKS_SCOUT_BACKGROUND_DELAY:-15s},CLOUD_TASKS_RISK_QUEUE=${risk_queue},CLOUD_TASKS_OIDC_SERVICE_ACCOUNT=$SA_BACKEND,CLOUD_TASKS_OIDC_AUDIENCE=$existing_api_url,CLOUD_TASKS_TARGET_BASE_URL=$existing_api_url,ENABLE_ETIGRAM_WATCHDOG=${enable_etigram_watchdog},PAYPAL_MODE=live,PAYPAL_RETURN_URL=https://etigram.one/subscription/success,PAYPAL_CANCEL_URL=https://etigram.one/subscription/cancel,PAYPAL_CURRENCY=USD,PAYPAL_LOCALE=ru-KZ,PAYPAL_TAX_PERCENTAGE=12,PAYPAL_TAX_INCLUSIVE=false,SIGNAL_MIN_RELEVANCE_SCORE=0.6,SIGNAL_MIN_CONFIDENCE=0.5,SIGNAL_MONITORING_INTERVAL=6h,GEONAMES_USERNAME=${GEONAMES_USERNAME:-kirisyuk}"
  # Etigram Fragments: dedicated bucket + dedicated Vertex AI Search Data Store
  # Store isolation is used instead of filters (filters on structData.* are not supported in our current schema).
  local etigram_fragments_bucket="${ETIGRAM_FRAGMENTS_BUCKET:-${PROJECT_ID}-etigram-fragments}"
  local etigram_fragments_datastore="${VERTEX_SEARCH_ETIGRAM_DATA_STORE_ID:-etigram-fragments-store}"
  env_vars="$env_vars,ETIGRAM_FRAGMENTS_BUCKET=${etigram_fragments_bucket},VERTEX_SEARCH_ETIGRAM_DATA_STORE_ID=${etigram_fragments_datastore}"

  # NOTE: ADMIN_JOB_TOKEN is provided via Secret Manager (see --set-secrets) to avoid rotation/desync.

  # If deploying Etigram Watchdog scheduler mode, keep related env vars in sync (also replaced by deploy).
  if [[ "${TARGET_ETIGRAM_WATCHDOG:-0}" -eq 1 ]]; then
    env_vars="$env_vars,DISABLE_ETIGRAM_WATCHDOG_TICKER=true,ETIGRAM_WATCHDOG_CRON_LIMIT=${ETIGRAM_WATCHDOG_CRON_LIMIT:-200},ETIGRAM_WATCHDOG_CRON_LOCK_TTL=${ETIGRAM_WATCHDOG_CRON_LOCK_TTL:-9m}"
  fi
  
  # Add Redis env vars if available (REDIS_HOST/PORT for cache package, REDIS_ADDR for legacy applicability_evaluator)
  if [[ -n "$redis_host" ]]; then
    env_vars="$env_vars,REDIS_HOST=$redis_host,REDIS_PORT=$redis_port,REDIS_ADDR=$redis_host:$redis_port"
    echo -e "${BLUE}[api] Using Redis:${NC} $redis_host:$redis_port"
  fi
  
  # Add Telegram service URL if available
  if [[ -n "$telegram_url" ]]; then
    env_vars="$env_vars,TELEGRAM_SERVICE_URL=$telegram_url"
    echo -e "${BLUE}[api] Setting TELEGRAM_SERVICE_URL:${NC} $telegram_url"
  else
    echo -e "${YELLOW}[api] Telegram service not found - TELEGRAM_SERVICE_URL will not be set${NC}"
  fi
  if [[ -n "$event_gate_url" ]]; then
    env_vars="$env_vars,EVENT_GATE_SERVICE_URL=$event_gate_url,EVENT_GATE_MODE=${resolved_event_gate_mode}"
  fi
  if [[ -n "$entity_extract_url" ]]; then
    env_vars="$env_vars,ENTITY_EXTRACT_SERVICE_URL=$entity_extract_url,ENTITY_EXTRACT_MODE=${resolved_entity_extract_mode}"
  fi

  local api_cpu="${API_CLOUD_RUN_CPU:-2}"
  local api_memory="${API_CLOUD_RUN_MEMORY:-2Gi}"
  local api_concurrency="${API_CLOUD_RUN_CONCURRENCY:-16}"
  local api_min_instances="${API_CLOUD_RUN_MIN_INSTANCES:-1}"
  local api_max_instances="${API_CLOUD_RUN_MAX_INSTANCES:-6}"

  echo -e "${BLUE}[api] Runtime profile:${NC} cpu=${api_cpu} memory=${api_memory} concurrency=${api_concurrency} min=${api_min_instances} max=${api_max_instances}"
  
  echo -e "${BLUE}[api] Deploying to Cloud Run from image...${NC}"
  # Direct VPC egress for Redis Memorystore access (private IP).
  # --network/--subnet replaces the old --clear-vpc-connector approach.
  gcloud run deploy "$service" \
    --image "$image" \
    --region "$REGION" \
    --no-invoker-iam-check \
    --service-account "$SA_BACKEND" \
    --min-instances="${api_min_instances}" \
    --max-instances="${api_max_instances}" \
    --concurrency="${api_concurrency}" \
    --cpu="${api_cpu}" \
    --memory="${api_memory}" \
    --timeout=3600 \
    --set-env-vars "$env_vars" \
    --set-secrets "$paypal_secrets" \
    --network=default \
    --subnet=default \
    --vpc-egress=private-ranges-only \
    --project "$PROJECT_ID" \
    --quiet

  # Force traffic to latest revision
  echo -e "${BLUE}[api] Routing 100% traffic to latest revision...${NC}"
  gcloud run services update-traffic "$service" \
    --region "$REGION" \
    --to-latest \
    --quiet
  
  local current_revision=$(gcloud run services describe "$service" --region "$REGION" --format="value(status.traffic[0].revisionName)")
  echo -e "${GREEN}[api] Traffic routed to:${NC} $current_revision"

  API_URL=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)')
  echo -e "${GREEN}[api] Deployed successfully${NC}"
  echo -e "${BLUE}[api] URL:${NC} $API_URL"

  # Best-effort: keep Cloud Scheduler job headers in sync with Secret Manager admin job token.
  local admin_token
  admin_token=$(gcloud secrets versions access latest --secret="$SECRET_ADMIN_JOB_TOKEN" 2>/dev/null || true)
  if [[ -z "$admin_token" ]]; then
    admin_token=$(openssl rand -hex 12 2>/dev/null || echo dev-admin-token)
  fi
  if gcloud scheduler jobs describe "etigram-watchdog" --location="$REGION" >/dev/null 2>&1; then
    gcloud scheduler jobs update http "etigram-watchdog" \
      --location="$REGION" \
      --update-headers="X-Job-Token=$admin_token" \
      --quiet >/dev/null 2>&1 || true
    echo -e "${GREEN}[api] ✓${NC} Updated Cloud Scheduler header for etigram-watchdog"
  fi
  if gcloud scheduler jobs describe "etigram-source-poller" --location="$REGION" >/dev/null 2>&1; then
    gcloud scheduler jobs update http "etigram-source-poller" \
      --location="$REGION" \
      --update-headers="X-Job-Token=$admin_token" \
      --quiet >/dev/null 2>&1 || true
    echo -e "${GREEN}[api] ✓${NC} Updated Cloud Scheduler header for etigram-source-poller"
  fi
}

deploy_verified_proxy() {
  echo -e "${BLUE}[verified-proxy] Pre-deployment: validating Go build...${NC}"
  (cd "$API_DIR" && go build -o /dev/null ./cmd/verified-proxy) || {
    echo -e "${RED}[verified-proxy] Go build failed! Fix errors before deploying.${NC}"
    exit 1
  }
  echo -e "${GREEN}[verified-proxy] Go build successful locally${NC}"
  
  echo -e "${BLUE}[verified-proxy] Building container image...${NC}"
  local service="verified-proxy"
  
  # Get backend URL and functions key
  local backend_url="${API_URL:-}"
  if [[ -z "$backend_url" ]]; then
    backend_url=$(gcloud run services describe etigram-api --region "$REGION" --format='value(status.url)' 2>/dev/null || true)
  fi
  
  if [[ -z "$backend_url" ]]; then
    echo -e "${YELLOW}[verified-proxy] Skipping deployment: backend API URL not available${NC}"
    return
  fi
  
  # Get or create functions key secret
  local functions_key_secret="functions-key"
  if ! gcloud secrets describe "$functions_key_secret" >/dev/null 2>&1; then
    echo -e "${YELLOW}[verified-proxy] Creating placeholder functions-key secret (update with real value!)${NC}"
    echo -n "PLACEHOLDER_UPDATE_ME" | gcloud secrets create "$functions_key_secret" --data-file=-
  fi
  
  # Get allowed origins (same logic as main API)
  # Support FRONTEND_ORIGINS (comma-separated) or FRONTEND_ORIGIN (single)
  local allowed_origins="${FRONTEND_ORIGINS:-}"
  if [[ -z "$allowed_origins" ]]; then
    local single_origin="${FRONTEND_ORIGIN:-https://etigram.one}"
    # Add localhost if not already in the list
    if [[ "$single_origin" != *"localhost"* ]]; then
      allowed_origins="${single_origin},http://localhost:5173"
    else
      allowed_origins="$single_origin"
    fi
  fi
  
  # Generate image tag (timestamp for uniqueness)
  local image_tag=$(date +%s)
  
  # Build and deploy using cloudbuild.yaml
  # Use JSON format for substitutions to handle comma in ALLOWED_ORIGINS
  # Escape the JSON properly for shell
  local allowed_origins_json=$(echo "$allowed_origins" | sed 's/"/\\"/g')
  
  echo -e "${BLUE}[verified-proxy] Starting Cloud Build (this may take a few minutes)...${NC}"
  # Don't pass ALLOWED_ORIGINS in substitutions (comma causes issues), will set after deploy
  gcloud builds submit "$API_DIR" \
    --project "$PROJECT_ID" \
    --config="$API_DIR/cmd/verified-proxy/cloudbuild.yaml" \
    --substitutions=_BACKEND_URL="$backend_url",_FUNCTIONS_KEY="${functions_key_secret}:latest",_IMAGE_TAG="$image_tag" || {
    echo -e "${YELLOW}[verified-proxy] Cloud Build failed, trying direct deploy...${NC}"
    # Fallback: deploy directly from source
    # Note: --source doesn't support --env-vars-file, so use update after deploy
    gcloud run deploy "$service" \
      --source "$API_DIR/cmd/verified-proxy" \
      --region "$REGION" \
      --service-account "$SA_BACKEND" \
      --min-instances=0 \
      --max-instances=10 \
      --memory=256Mi \
      --timeout=60 \
      --set-secrets "FUNCTIONS_KEY=${functions_key_secret}:latest" \
      --project "$PROJECT_ID" \
      --quiet
    # Update env vars separately (using update-env-vars to preserve existing)
    local env_file=$(mktemp)
    echo "BACKEND_URL=$backend_url" > "$env_file"
    echo "ALLOWED_ORIGINS=$allowed_origins" >> "$env_file"
    gcloud run services update "$service" \
      --region "$REGION" \
      --env-vars-file="$env_file" \
      --project "$PROJECT_ID" \
      --quiet 2>/dev/null || true
    rm -f "$env_file"
  }
  
  # Update env vars after deployment (to set ALLOWED_ORIGINS with comma)
  echo -e "${BLUE}[verified-proxy] Updating environment variables...${NC}"
  local env_file=$(mktemp)
  echo "BACKEND_URL=$backend_url" > "$env_file"
  echo "ALLOWED_ORIGINS=$allowed_origins" >> "$env_file"
  gcloud run services update "$service" \
    --region "$REGION" \
    --env-vars-file="$env_file" \
    --project "$PROJECT_ID" \
    --quiet 2>/dev/null || echo -e "${YELLOW}[verified-proxy] Warning: Failed to update env vars (may need manual update)${NC}"
  rm -f "$env_file"
  
  # Get proxy URL
  echo -e "${BLUE}[verified-proxy] Waiting for service to be ready...${NC}"
  sleep 3
  VERIFIED_PROXY_URL=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)' 2>/dev/null || true)
  if [[ -n "$VERIFIED_PROXY_URL" ]]; then
    echo -e "${GREEN}[verified-proxy] ✓ Deployed successfully${NC}"
    echo -e "${BLUE}[verified-proxy] URL:${NC} $VERIFIED_PROXY_URL"
    echo -e "${YELLOW}[verified-proxy] Note: Update VITE_VERIFIED_PROXY_URL in frontend env: $VERIFIED_PROXY_URL${NC}"
  else
    echo -e "${YELLOW}[verified-proxy] Deployment completed but URL not available (check Cloud Run console)${NC}"
  fi
}

deploy_etigram_ws() {
  echo -e "${BLUE}[etigram-ws] Building image...${NC}"
  local service="etigram-ws"
  local image="us-central1-docker.pkg.dev/$PROJECT_ID/cloud-run-source-deploy/etigram-ws:latest"

  gcloud builds submit "$API_DIR" \
    --config="$API_DIR/cloudbuild.etigram-ws.yaml" \
    --project "$PROJECT_ID" \
    --quiet

  if [[ "$FIREBASE_PROJECT_ID" != "$PROJECT_ID" ]]; then
    echo -e "${YELLOW}[etigram-ws] FIREBASE_PROJECT_ID ($FIREBASE_PROJECT_ID) differs from project ($PROJECT_ID). Forcing FIREBASE_AUTH_PROJECT_ID=$PROJECT_ID.${NC}"
  fi
  # etigram-ws must verify tokens issued by the active project for this deployment.
  local env_vars="GCP_PROJECT_ID=$PROJECT_ID,GOOGLE_CLOUD_PROJECT=$PROJECT_ID,FIREBASE_AUTH_PROJECT_ID=$PROJECT_ID"

  echo -e "${BLUE}[etigram-ws] Deploying to Cloud Run...${NC}"
  gcloud run deploy "$service" \
    --image "$image" \
    --region "$REGION" \
    --no-invoker-iam-check \
    --service-account "$SA_BACKEND" \
    --min-instances=1 \
    --max-instances=2 \
    --cpu=1 \
    --memory=256Mi \
    --timeout=3600s \
    --set-env-vars "$env_vars" \
    --clear-vpc-connector \
    --project "$PROJECT_ID" \
    --quiet

  gcloud run services update-traffic "$service" --region "$REGION" --to-latest --quiet

  ETIGRAM_WS_URL=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)')
  echo -e "${GREEN}[etigram-ws] Deployed successfully${NC}"
  echo -e "${BLUE}[etigram-ws] URL:${NC} $ETIGRAM_WS_URL"
}

deploy_py() {
  echo -e "${BLUE}[py] Deploying Telegram service to Cloud Run...${NC}"
  local service="etigram-telegram"
  local SRC_DIR="$ROOT_DIR/python/telegram_service"
  gcloud run deploy "$service" \
    --source "$SRC_DIR" \
    --region "$REGION" \
    --service-account "$SA_BACKEND" \
    --no-invoker-iam-check \
    --min-instances=1 \
    --max-instances=3 \
    --cpu=1 \
    --memory=256Mi \
    --set-secrets "TELEGRAM_API_ID=TELEGRAM_API_ID:latest,TELEGRAM_API_HASH=TELEGRAM_API_HASH:latest,TELEGRAM_SESSION_STRING=TELEGRAM_SESSION_STRING:latest,TELEGRAM_BOT_TOKEN=TELEGRAM_BOT_TOKEN:latest" \
    --project "$PROJECT_ID" \
    --quiet
  
  # Route traffic to latest revision (if not already)
  gcloud run services update-traffic "$service" --region "$REGION" --to-latest --quiet 2>/dev/null || true
  
  echo -e "${GREEN}[py] Deployed successfully${NC}"
  TG_URL=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)')
  echo -e "${BLUE}[py] URL:${NC} $TG_URL"
  
  # Update backend with TELEGRAM_SERVICE_URL if we have it (only if API was not just deployed)
  # If API was deployed, TELEGRAM_SERVICE_URL is already set in env_vars during deploy
  if [[ -n "$TG_URL" ]] && [[ "$TARGET_API" -eq 0 ]] && gcloud run services describe etigram-api --region "$REGION" >/dev/null 2>&1; then
    echo -e "${BLUE}[api] Updating existing backend with TELEGRAM_SERVICE_URL=$TG_URL...${NC}"
    gcloud run services update etigram-api \
      --region "$REGION" \
      --update-env-vars "TELEGRAM_SERVICE_URL=$TG_URL" \
      --quiet || {
      echo -e "${YELLOW}[api] WARNING: Failed to update TELEGRAM_SERVICE_URL${NC}" >&2
    }
  fi
}

deploy_python_cloud_run_service() {
  local service="$1"
  local src_dir="$2"
  local min_instances="${3:-0}"
  local max_instances="${4:-2}"
  local cpu="${5:-1}"
  local memory="${6:-512Mi}"
  local env_vars="${7:-}"
  if [[ ! -d "$src_dir" ]]; then
    echo -e "${RED}[${service}] Source directory not found:${NC} $src_dir" >&2
    exit 1
  fi
  gcloud run deploy "$service" \
    --source "$src_dir" \
    --region "$REGION" \
    --service-account "$SA_BACKEND" \
    --no-invoker-iam-check \
    --min-instances="$min_instances" \
    --max-instances="$max_instances" \
    --cpu="$cpu" \
    --memory="$memory" \
    ${env_vars:+--set-env-vars "$env_vars"} \
    --project "$PROJECT_ID" \
    --quiet
  gcloud run services update-traffic "$service" --region "$REGION" --to-latest --quiet 2>/dev/null || true
}

deploy_event_gate() {
  echo -e "${BLUE}[event-gate] Deploying Event Gate NLP service to Cloud Run...${NC}"
  local service="etigram-event-gate"
  local SRC_DIR="$ROOT_DIR/python/event_gate_service"
  local local_model="$SRC_DIR/model/event_gate.joblib"
  local model_backend="${EVENT_GATE_MODEL_BACKEND:-rules}"
  local model_path="${EVENT_GATE_MODEL_PATH:-}"
  local model_gcs_uri="${EVENT_GATE_MODEL_GCS_URI:-}"
  if [[ -z "$model_path" && -f "$local_model" ]]; then
    model_backend="${EVENT_GATE_MODEL_BACKEND:-sklearn}"
    model_path="/app/model/event_gate.joblib"
  fi
  local env_vars="MODEL_BACKEND=${model_backend},MODEL_PATH=${model_path},MODEL_GCS_URI=${model_gcs_uri},LABEL_SCHEMA_VERSION=${EVENT_GATE_LABEL_SCHEMA_VERSION:-v1}"
  deploy_python_cloud_run_service "$service" "$SRC_DIR" 0 3 1 512Mi "$env_vars"
  EVENT_GATE_URL=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)')
  echo -e "${GREEN}[event-gate] Deployed successfully${NC}"
  echo -e "${BLUE}[event-gate] URL:${NC} $EVENT_GATE_URL"
  if [[ -n "$EVENT_GATE_URL" ]] && [[ "$TARGET_API" -eq 0 ]] && gcloud run services describe etigram-api --region "$REGION" >/dev/null 2>&1; then
    local current_event_gate_mode=""
    current_event_gate_mode=$(gcloud run services describe etigram-api --region "$REGION" --format='json(spec.template.spec.containers[0].env)' 2>/dev/null | python3 -c 'import json,sys; env=json.load(sys.stdin); print(next((item.get("value","") for item in env if item.get("name")=="EVENT_GATE_MODE"), ""))' 2>/dev/null || echo "")
    [[ -z "$current_event_gate_mode" ]] && current_event_gate_mode="${EVENT_GATE_MODE:-shadow}"
    echo -e "${BLUE}[api] Updating existing backend with EVENT_GATE_SERVICE_URL=${EVENT_GATE_URL}${NC}"
    gcloud run services update etigram-api \
      --region "$REGION" \
      --update-env-vars "EVENT_GATE_SERVICE_URL=$EVENT_GATE_URL,EVENT_GATE_MODE=${EVENT_GATE_MODE:-$current_event_gate_mode}" \
      --quiet || {
      echo -e "${YELLOW}[api] WARNING: Failed to update EVENT_GATE_SERVICE_URL${NC}" >&2
    }
  fi
}

deploy_entity_extract() {
  echo -e "${BLUE}[entity-extract] Deploying Entity Extract NLP service to Cloud Run...${NC}"
  local service="etigram-entity-extract"
  local SRC_DIR="$ROOT_DIR/python/entity_extract_service"
  local env_vars="MODEL_BACKEND=${ENTITY_EXTRACT_MODEL_BACKEND:-rules},GLINER_MODEL_NAME=${ENTITY_EXTRACT_GLINER_MODEL_NAME:-},LABEL_SCHEMA_VERSION=${ENTITY_EXTRACT_LABEL_SCHEMA_VERSION:-v1}"
  deploy_python_cloud_run_service "$service" "$SRC_DIR" 0 3 1 768Mi "$env_vars"
  ENTITY_EXTRACT_URL=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)')
  echo -e "${GREEN}[entity-extract] Deployed successfully${NC}"
  echo -e "${BLUE}[entity-extract] URL:${NC} $ENTITY_EXTRACT_URL"
  if [[ -n "$ENTITY_EXTRACT_URL" ]] && [[ "$TARGET_API" -eq 0 ]] && gcloud run services describe etigram-api --region "$REGION" >/dev/null 2>&1; then
    local current_entity_extract_mode=""
    current_entity_extract_mode=$(gcloud run services describe etigram-api --region "$REGION" --format='json(spec.template.spec.containers[0].env)' 2>/dev/null | python3 -c 'import json,sys; env=json.load(sys.stdin); print(next((item.get("value","") for item in env if item.get("name")=="ENTITY_EXTRACT_MODE"), ""))' 2>/dev/null || echo "")
    [[ -z "$current_entity_extract_mode" ]] && current_entity_extract_mode="${ENTITY_EXTRACT_MODE:-shadow}"
    echo -e "${BLUE}[api] Updating existing backend with ENTITY_EXTRACT_SERVICE_URL=${ENTITY_EXTRACT_URL}${NC}"
    gcloud run services update etigram-api \
      --region "$REGION" \
      --update-env-vars "ENTITY_EXTRACT_SERVICE_URL=$ENTITY_EXTRACT_URL,ENTITY_EXTRACT_MODE=${ENTITY_EXTRACT_MODE:-$current_entity_extract_mode}" \
      --quiet || {
      echo -e "${YELLOW}[api] WARNING: Failed to update ENTITY_EXTRACT_SERVICE_URL${NC}" >&2
    }
  fi
}

create_indexes() {
  echo -e "${BLUE}[firestore] Creating composite indexes (idempotent)...${NC}"
  # Projects: tenantId + view + lastInteractionAt desc
  gcloud firestore indexes composite create --async \
    --collection-group=core_projects \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=view,order=ASCENDING \
    --field-config field-path=lastInteractionAt,order=DESCENDING \
    --quiet || true
  # DataSources suggestions (uri canonical, channel username)
  gcloud firestore indexes composite create --async \
    --collection-group=core_datasources \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=sourceDetails.uri,order=ASCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=core_datasources \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=sourceDetails.channelUsername,order=ASCENDING \
    --quiet || true
  # Interactions: projectId + createdAt asc (for listing by project with ordering)
  gcloud firestore indexes composite create --async \
    --collection-group=core_interactions \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=createdAt,order=ASCENDING \
    --quiet || true

  # Core docs: tenant+project for quick listing within project, newest first
  gcloud firestore indexes composite create --async \
    --collection-group=core_docs \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true

  # Core docs: lookup by external provider+resource id (optional future use)
  gcloud firestore indexes composite create --async \
    --collection-group=core_docs \
    --field-config field-path=external.provider,order=ASCENDING \
    --field-config field-path=external.resourceId,order=ASCENDING \
    --quiet || true

  # RAG: sourceProjects composites
  gcloud firestore indexes composite create --async \
    --collection-group=rag_source_projects \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=rag_source_projects \
    --field-config field-path=sourceId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --quiet || true

  # RAG: documents lookups
  gcloud firestore indexes composite create --async \
    --collection-group=rag_documents \
    --field-config field-path=sourceId,order=ASCENDING \
    --field-config field-path=originPublishedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=rag_documents \
    --field-config field-path=sourceId,order=ASCENDING \
    --field-config field-path=externalId,order=ASCENDING \
    --quiet || true

  # Meta analyses: events by project (latest first)
  gcloud firestore indexes composite create --async \
    --collection-group=meta_analyses \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true
  # Meta analyses: events by user within tenant (latest first)
  gcloud firestore indexes composite create --async \
    --collection-group=meta_analyses \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=userId,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true

  # Subscriptions: status + currentPeriodEnd for billing queries
  gcloud firestore indexes composite create --async \
    --collection-group=subscriptions \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=currentPeriodEnd,order=ASCENDING \
    --quiet || true

  # Vouchers: tier + isActive + createdAt for admin filtering
  gcloud firestore indexes composite create --async \
    --collection-group=vouchers \
    --field-config field-path=tier,order=ASCENDING \
    --field-config field-path=isActive,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true

  # Horizon strategic recommendations inbox/filtering
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=lensId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=lensId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=lensId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create --async \
    --collection-group=horizon_strategic_recommendations \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=lensId,order=ASCENDING \
    --field-config field-path=updatedAt,order=DESCENDING \
    --quiet || true

  # Vector index for rag_chunks.embedding (dimension=1536)
  # Vector fields are created as composite indexes with vector-config
  echo -e "${BLUE}[firestore] Ensuring vector index for rag_chunks.embedding...${NC}"
  # Check if vector index already exists (check for any index with vectorConfig in fields for rag_chunks)
  local has_vector_index=false
  if command -v jq >/dev/null 2>&1; then
    # Get all indexes and filter for rag_chunks with vectorConfig
    local vector_index_count
    vector_index_count=$(gcloud firestore indexes composite list --format=json 2>/dev/null | jq '[.[] | select(.fields[]?.vectorConfig != null and (.name | contains("rag_chunks")))] | length' 2>/dev/null || echo "0")
    if [ "$vector_index_count" -gt 0 ] 2>/dev/null; then
      has_vector_index=true
    fi
  else
    # Fallback: check if any index contains "rag_chunks", "embedding" and "vectorConfig" in JSON
    if gcloud firestore indexes composite list --format=json 2>/dev/null | grep -q 'rag_chunks.*embedding.*vectorConfig' 2>/dev/null; then
      has_vector_index=true
    fi
  fi
  
  if [ "$has_vector_index" = true ]; then
    echo -e "${GREEN}  ✓${NC} Vector index already exists for rag_chunks.embedding"
  else
    echo -e "${BLUE}  Creating vector index...${NC}"
    if gcloud firestore indexes composite create --async \
      --collection-group=rag_chunks \
      --query-scope=COLLECTION \
      --field-config='field-path=embedding,vector-config={"dimension":"1536", "flat": "{}"}' \
      --database="(default)" \
      --project="$PROJECT_ID" \
      --quiet 2>/dev/null; then
      echo -e "${GREEN}  ✓${NC} Vector index created successfully"
      echo -e "${YELLOW}  ⚠${NC} Note: Vector index propagation may take several minutes"
    else
      echo -e "${YELLOW}  ⚠${NC} Failed to create vector index (may require permissions)"
      echo -e "${YELLOW}  ⚠${NC} Create manually: gcloud firestore indexes composite create \\"
      echo -e "${YELLOW}     --collection-group=rag_chunks --query-scope=COLLECTION \\"
      echo -e "${YELLOW}     --field-config='field-path=embedding,vector-config={\"dimension\":\"1536\", \"flat\": \"{}\"}' \\"
      echo -e "${YELLOW}     --database=\"(default)\" --project=$PROJECT_ID"
    fi
  fi
  
  # Deploy firestore rules and indexes via Firebase CLI
  # Note: Vector indexes are created separately via gcloud (see above)
  echo -e "${BLUE}[firestore] Deploying rules and indexes (firestore)...${NC}"
  if [[ -f "$WEB_DIR/firestore.indexes.json" ]] && [[ -f "$API_DIR/firestore.rules" ]]; then
    if command -v firebase >/dev/null 2>&1 && [[ -f "$WEB_DIR/firebase.json" ]]; then
      cd "$WEB_DIR"
      if firebase deploy --only firestore --project "$PROJECT_ID" --non-interactive --force 2>/dev/null; then
        echo -e "${GREEN}  ✓${NC} Firestore rules and indexes deployed via Firebase CLI"
        cd "$ROOT_DIR"
      else
        cd "$ROOT_DIR"
        echo -e "${YELLOW}  ⚠${NC} Firebase CLI deploy failed (this is normal if indexes already exist)"
        echo -e "${BLUE}  To deploy manually:${NC} cd web && firebase deploy --only firestore --project $PROJECT_ID"
      fi
    else
      echo -e "${YELLOW}  ⚠${NC} Firebase CLI not found or firebase.json missing"
      echo -e "${YELLOW}  ⚠${NC} Deploy manually: cd web && firebase deploy --only firestore --project $PROJECT_ID"
    fi
    echo -e "${BLUE}  Rules:${NC} $API_DIR/firestore.rules"
    echo -e "${BLUE}  Indexes:${NC} $WEB_DIR/firestore.indexes.json"
  else
    [[ ! -f "$API_DIR/firestore.rules" ]] && echo -e "${YELLOW}  ⚠${NC} firestore.rules not found at $API_DIR/firestore.rules"
    [[ ! -f "$WEB_DIR/firestore.indexes.json" ]] && echo -e "${YELLOW}  ⚠${NC} firestore.indexes.json not found at $WEB_DIR/firestore.indexes.json"
  fi

  # Verify meta_analyses indexes presence (best-effort)
  echo -e "${BLUE}[firestore] Verifying meta_analyses composite indexes...${NC}"
  local meta_list_json
  if meta_list_json=$(gcloud firestore indexes composite list --collection-group=meta_analyses --format=json 2>/dev/null); then
    local has_proj
    local has_user
    has_proj=$(echo "$meta_list_json" | grep -c '"projectId"' || true)
    has_user=$(echo "$meta_list_json" | grep -c '"userId"' || true)
    if [[ "$has_proj" -gt 0 && "$has_user" -gt 0 ]]; then
      echo -e "${GREEN}  ✓${NC} meta_analyses indexes detected"
    else
      echo -e "${YELLOW}  ⚠${NC} meta_analyses indexes not fully visible yet (Firestorm propagation may take minutes)."
    fi
  else
    echo -e "${YELLOW}  ⚠${NC} Unable to list composite indexes for meta_analyses (insufficient permissions or API)."
  fi
}

# Setup infrastructure only on full deploy or explicit check.
# Individual service deploys (--api, --ws, --verified-proxy, --py) usually skip infra checks for speed,
# BUT some flags (e.g. --etigram-watchdog) require infra steps (Cloud Scheduler jobs, env vars).
if [[ "$TARGET_CHECK_INFRA" -eq 1 ]]; then
  setup_infrastructure
  create_indexes
  echo -e "${GREEN}[infra] Infrastructure checks completed${NC}"
  exit 0
elif [[ "$TARGET_ETIGRAM_WATCHDOG" -eq 1 ]]; then
  # Minimal infra needed for watchdog Cloud Scheduler job creation/update.
  setup_infrastructure
elif [[ "$TARGET_WEB" -eq 1 && "$TARGET_API" -eq 1 && "$TARGET_PY" -eq 0 && "$TARGET_VERIFIED_PROXY" -eq 0 ]]; then
  # Full deploy: run infrastructure checks
  setup_infrastructure
elif [[ "$TARGET_SETUP_ETIGRAM_INFRA" -eq 1 ]]; then
  # Deploy etigram-ws: ensure Pub/Sub topics and subscriptions exist
  # Call the same setup function but only for etigram-ws infrastructure
  echo -e "${BLUE}[infra] Setting up infrastructure for etigram-ws...${NC}"
  # Ensure aggregated topics and subscriptions (reuse logic from setup_infrastructure)
  agg_topics=(
    "etigram.genai.streams"
    "etigram.discovery.events"
    "etigram.artifact.events"
    "etigram.interaction.events"
    "etigram.analysis.events"
    "etigram.verified.streams"
    "etigram.horizon.events"
    "etigram.operations.events"
  )
  # 4.1 Ensure aggregated topics
  echo -e "${BLUE}[infra] Ensuring Pub/Sub aggregated topics for etigram-ws...${NC}"
  for topic in "${agg_topics[@]}"; do
    if ! gcloud pubsub topics describe "$topic" --project="$PROJECT_ID" >/dev/null 2>&1; then
      gcloud pubsub topics create "$topic" --project="$PROJECT_ID" --quiet || true
      echo -e "${GREEN}  ✓${NC} Created topic: $topic"
    else
      echo -e "${GREEN}  ✓${NC} $topic exists"
    fi
  done
  # 4.2 Ensure etigram-ws subscriptions
  echo -e "${BLUE}[infra] Ensuring Pub/Sub subscriptions for etigram-ws...${NC}"
  for topic in "${agg_topics[@]}"; do
    sub_id="${topic}-ws-broker"
    if gcloud pubsub subscriptions describe "$sub_id" --project="$PROJECT_ID" >/dev/null 2>&1; then
      ordering=$(gcloud pubsub subscriptions describe "$sub_id" --project="$PROJECT_ID" --format="value(enableMessageOrdering)" 2>/dev/null || echo "False")
      if [[ "$ordering" != "True" ]]; then
        echo -e "${YELLOW}[infra] Recreating subscription with ordering enabled:${NC} $sub_id"
        gcloud pubsub subscriptions delete "$sub_id" --project="$PROJECT_ID" --quiet >/dev/null 2>&1 || true
        gcloud pubsub subscriptions create "$sub_id" \
          --project="$PROJECT_ID" \
          --topic="$topic" \
          --enable-message-ordering \
          --quiet >/dev/null 2>&1 || true
      fi
      echo -e "${GREEN}  ✓${NC} $sub_id exists"
    else
      gcloud pubsub subscriptions create "$sub_id" \
        --project="$PROJECT_ID" \
        --topic="$topic" \
        --enable-message-ordering \
        --quiet >/dev/null 2>&1 || true
      echo -e "${GREEN}  ✓${NC} Created subscription: $sub_id"
    fi
  done
fi

if [[ "$TARGET_API" -eq 1 ]]; then
  deploy_api
fi

if [[ "$TARGET_ETIGRAM_WS" -eq 1 ]]; then
  deploy_etigram_ws
fi

if [[ "$TARGET_VERIFIED_PROXY" -eq 1 ]]; then
  deploy_verified_proxy
fi

if [[ "$TARGET_WEB" -eq 1 ]]; then
  # Build web last so it can pick up freshly deployed API/WS/proxy URLs.
  deploy_web
fi

if [[ "$TARGET_PY" -eq 1 ]]; then
  deploy_py
fi

if [[ "$TARGET_EVENT_GATE" -eq 1 ]]; then
  deploy_event_gate
fi

if [[ "$TARGET_ENTITY_EXTRACT" -eq 1 ]]; then
  deploy_entity_extract
fi

# Firestore indexes are only relevant for backend; skip for web-only
# Create indexes only on full deploy (already handled in --check-infra path above)
if [[ "$TARGET_WEB" -eq 1 && "$TARGET_API" -eq 1 && "$TARGET_PY" -eq 0 && "$TARGET_VERIFIED_PROXY" -eq 0 ]]; then
  if [[ "$TARGET_API" -eq 1 || "$TARGET_PY" -eq 1 ]]; then
    create_indexes
  fi
fi

# Cleanup old revisions (manual operation, separate from deployment)
if [[ "$TARGET_CLEANUP_REVISIONS" -eq 1 ]]; then
  echo ""
  echo -e "${BLUE}═══════════════════════════════════════════════════════${NC}"
  echo -e "${BLUE}Cleaning up old Cloud Run revisions...${NC}"
  echo -e "${BLUE}═══════════════════════════════════════════════════════${NC}"
  
  # Clean up revisions for all services (keep last 10 per service)
  services=("etigram-api" "etigram-telegram" "etigram-event-gate" "etigram-entity-extract" "etigram-ws" "verified-proxy")
  for service in "${services[@]}"; do
    if gcloud run services describe "$service" --region "$REGION" --project "$PROJECT_ID" >/dev/null 2>&1; then
      cleanup_old_revisions "$service" "$REGION" 10
    else
      echo -e "${YELLOW}[cleanup] Service $service not found, skipping${NC}"
    fi
  done
  
  echo ""
  echo -e "${GREEN}✓ Cleanup Complete${NC}"
fi

echo ""
echo -e "${GREEN}═══════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}✓ Deployment Complete${NC}"
echo -e "${GREEN}═══════════════════════════════════════════════════════${NC}"

# Summary
if [[ "$TARGET_API" -eq 1 ]] && [[ -n "${API_URL:-}" ]]; then
  echo -e "${BLUE}Backend API:${NC} $API_URL"
fi
if [[ "$TARGET_VERIFIED_PROXY" -eq 1 ]] && [[ -n "${VERIFIED_PROXY_URL:-}" ]]; then
  echo -e "${BLUE}Verified Proxy:${NC} $VERIFIED_PROXY_URL"
fi
if [[ "$TARGET_ETIGRAM_WS" -eq 1 ]] && [[ -n "${ETIGRAM_WS_URL:-}" ]]; then
  echo -e "${BLUE}WS Broker:${NC} $ETIGRAM_WS_URL"
fi
if [[ "$TARGET_PY" -eq 1 ]] && [[ -n "${TG_URL:-}" ]]; then
  echo -e "${BLUE}Telegram Service:${NC} $TG_URL"
fi
if [[ "$TARGET_EVENT_GATE" -eq 1 ]] && [[ -n "${EVENT_GATE_URL:-}" ]]; then
  echo -e "${BLUE}Event Gate Service:${NC} $EVENT_GATE_URL"
fi
if [[ "$TARGET_ENTITY_EXTRACT" -eq 1 ]] && [[ -n "${ENTITY_EXTRACT_URL:-}" ]]; then
  echo -e "${BLUE}Entity Extract Service:${NC} $ENTITY_EXTRACT_URL"
fi
if [[ "$TARGET_WEB" -eq 1 ]]; then
  echo -e "${BLUE}Web Static:${NC} gs://${PROJECT_ID}-web-static"
fi

echo ""
echo -e "${YELLOW}Post-deployment checklist:${NC}"
echo -e "  ☐ Verify secrets have real API keys (not placeholders)"
if [[ "$TARGET_API" -eq 1 ]]; then
  echo -e "  ☐ Update functions-key secret with real value: gcloud secrets versions add functions-key --data-file=-"
fi
if [[ "$TARGET_VERIFIED_PROXY" -eq 1 ]]; then
  if [[ -n "${VERIFIED_PROXY_URL:-}" ]]; then
    echo -e "  ☐ Update VITE_VERIFIED_PROXY_URL in frontend: $VERIFIED_PROXY_URL"
  fi
fi
echo -e "  ☐ Test API health: curl \$API_URL/api/v1/healthz"
if [[ "$TARGET_EVENT_GATE" -eq 1 ]] && [[ -n "${EVENT_GATE_URL:-}" ]]; then
  echo -e "  ☐ Test Event Gate health: curl ${EVENT_GATE_URL}/api/v1/healthz"
fi
if [[ "$TARGET_ENTITY_EXTRACT" -eq 1 ]] && [[ -n "${ENTITY_EXTRACT_URL:-}" ]]; then
  echo -e "  ☐ Test Entity Extract health: curl ${ENTITY_EXTRACT_URL}/api/v1/healthz"
fi
echo -e "  ☐ Check Cloud Run logs for errors"
echo -e "  ☐ Verify traffic is on latest revision"
echo ""
