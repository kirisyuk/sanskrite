#!/usr/bin/env bash
set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)
WEB_DIR="$ROOT_DIR/web"
API_DIR="$ROOT_DIR/backend"

TARGET_WEB=1
TARGET_API=1
TARGET_WS=0
TARGET_VERIFIED_PROXY=0
TARGET_CHECK_INFRA=0

REGION=${REGION:-us-central1}
PROJECT_ID=$(gcloud config get-value project 2>/dev/null || true)
if [[ -z "$PROJECT_ID" || "$PROJECT_ID" == "(unset)" ]]; then
  echo -e "${RED}GCP project is not set. Run: gcloud config set project <ID>${NC}" >&2
  exit 1
fi

# Service account for backend
SA_BACKEND="backend@${PROJECT_ID}.iam.gserviceaccount.com"

usage() {
  echo "Usage: scripts/deploy [--web] [--api] [--py] [--ws] [--verified-proxy] [--check-infra]"
  echo "If none specified, deploy web+api. REGION env var supported (default: us-central1)."
  echo ""
  echo "Flags:"
  echo "  --web           Deploy frontend only"
  echo "  --api           Deploy backend API only (skips infra checks)"
  echo "  --py            Deploy Telegram service only (skips infra checks)"
  echo "  --ws            Deploy WS broker only (skips infra checks)"
  echo "  --verified-proxy Deploy verified-proxy only (skips infra checks)"
  echo "  --check-infra   Run infrastructure checks only (no deployments)"
}

TARGET_PY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --web) TARGET_API=0 ;;
    --api) TARGET_WEB=0; TARGET_CHECK_INFRA=0 ;;
    --py) TARGET_WEB=0; TARGET_API=0; TARGET_CHECK_INFRA=0 ;;
    --ws) TARGET_WEB=0; TARGET_API=0; TARGET_PY=0; TARGET_WS=1; TARGET_CHECK_INFRA=0 ;;
    --verified-proxy) TARGET_WEB=0; TARGET_API=0; TARGET_PY=0; TARGET_WS=0; TARGET_VERIFIED_PROXY=1; TARGET_CHECK_INFRA=0 ;;
    --check-infra) TARGET_WEB=0; TARGET_API=0; TARGET_PY=0; TARGET_WS=0; TARGET_VERIFIED_PROXY=0; TARGET_CHECK_INFRA=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo -e "${YELLOW}Unknown arg: $1${NC}"; usage; exit 1 ;;
  esac
  shift
done

echo -e "${BLUE}Project:${NC} $PROJECT_ID\n${BLUE}Region:${NC} $REGION"

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo -e "${RED}Missing required command: $1${NC}" >&2
    exit 1
  fi
}

require gcloud
## gsutil not required; use gcloud storage to avoid Python dependency

# Ensure APIs
enable_api() {
  local api=$1
  gcloud services enable "$api" >/dev/null && echo -e "${GREEN}API enabled:${NC} $api" || true
}

echo -e "${BLUE}Ensuring required APIs...${NC}"
enable_api firestore.googleapis.com
enable_api run.googleapis.com
enable_api cloudbuild.googleapis.com
enable_api iam.googleapis.com
enable_api secretmanager.googleapis.com
enable_api pubsub.googleapis.com
# Optional but recommended for future features
enable_api aiplatform.googleapis.com
enable_api generativelanguage.googleapis.com
enable_api apikeys.googleapis.com
enable_api cloudscheduler.googleapis.com
enable_api cloudresourcemanager.googleapis.com

deploy_web() {
  echo -e "${BLUE}[web] Starting frontend deployment...${NC}"
  require firebase
  require npm
  
  # Check if web directory exists
  if [[ ! -d "$WEB_DIR" ]]; then
    echo -e "${RED}[web] Error: Web directory not found at $WEB_DIR${NC}" >&2
    exit 1
  fi
  
  # Try to resolve ws-broker URL for Vite env
  local WS_URL="${WS_URL:-}"
  if [[ -z "$WS_URL" ]]; then
    if gcloud run services describe sanskrite-ws --region "$REGION" >/dev/null 2>&1; then
      WS_URL=$(gcloud run services describe sanskrite-ws --region "$REGION" --format='value(status.url)')
      echo -e "${GREEN}[web] Found ws-broker URL:${NC} $WS_URL"
    else
      echo -e "${YELLOW}[web] ws-broker service not found (will use default from env if set)${NC}"
    fi
  fi
  
  # Try to resolve verified-proxy URL for Vite env
  local VERIFIED_PROXY_URL="${VERIFIED_PROXY_URL:-}"
  if [[ -z "$VERIFIED_PROXY_URL" ]]; then
    if gcloud run services describe verified-proxy --region "$REGION" >/dev/null 2>&1; then
      VERIFIED_PROXY_URL=$(gcloud run services describe verified-proxy --region "$REGION" --format='value(status.url)')
      echo -e "${GREEN}[web] Found verified-proxy URL:${NC} $VERIFIED_PROXY_URL"
    else
      echo -e "${YELLOW}[web] verified-proxy service not found (will use default from env if set)${NC}"
    fi
  fi
  
  # Build with environment variables
  echo -e "${BLUE}[web] Installing dependencies...${NC}"
  cd "$WEB_DIR"
  
  # Install dependencies
  if ! npm ci --no-audit --no-fund; then
    echo -e "${RED}[web] Error: npm ci failed${NC}" >&2
    exit 1
  fi
  
  # Build with environment variables
  echo -e "${BLUE}[web] Building Vite app...${NC}"
  local build_env_vars=()
  if [[ -n "$WS_URL" ]]; then
    build_env_vars+=("VITE_WS_BROKER_URL=$WS_URL")
    echo -e "${BLUE}[web] Using ws-broker URL for build:${NC} $WS_URL"
  fi
  if [[ -n "$VERIFIED_PROXY_URL" ]]; then
    build_env_vars+=("VITE_VERIFIED_PROXY_URL=$VERIFIED_PROXY_URL")
    echo -e "${BLUE}[web] Using verified-proxy URL for build:${NC} $VERIFIED_PROXY_URL"
  fi
  
  # Build with env vars if any are set
  if [[ ${#build_env_vars[@]} -gt 0 ]]; then
    export "${build_env_vars[@]}"
    if ! npm run build; then
      echo -e "${RED}[web] Error: npm run build failed${NC}" >&2
      exit 1
    fi
    # Unset variables (extract variable names only)
    for env_var in "${build_env_vars[@]}"; do
      var_name="${env_var%%=*}"
      unset "$var_name"
    done
  else
    if ! npm run build; then
      echo -e "${RED}[web] Error: npm run build failed${NC}" >&2
      exit 1
    fi
  fi
  
  # Verify build output exists
  if [[ ! -d "$WEB_DIR/dist" ]]; then
    echo -e "${RED}[web] Error: Build output directory 'dist' not found${NC}" >&2
    exit 1
  fi
  
  echo -e "${GREEN}[web] Build completed successfully${NC}"

  # Deploy to Firebase Hosting
  echo -e "${BLUE}[web] Deploying to Firebase Hosting...${NC}"
  local FB_ARGS=("--only" "hosting" "--project" "$PROJECT_ID" "--non-interactive" "--force")
  if [[ -n "${FIREBASE_TOKEN:-}" ]]; then
    FB_ARGS+=("--token" "$FIREBASE_TOKEN")
    echo -e "${BLUE}[web] Using Firebase token from environment${NC}"
  else
    echo -e "${YELLOW}[web] No FIREBASE_TOKEN found, will use interactive authentication${NC}"
  fi
  
  if ! firebase deploy "${FB_ARGS[@]}"; then
    echo -e "${RED}[web] Error: Firebase deployment failed${NC}" >&2
    exit 1
  fi

  echo -e "${GREEN}[web] ✓ Firebase Hosting deploy completed successfully${NC}"
  
  # Get hosting URL
  local hosting_url=$(firebase hosting:sites:list --project "$PROJECT_ID" --json 2>/dev/null | grep -o '"defaultHostingSite": "[^"]*' | cut -d'"' -f4 || echo "")
  if [[ -n "$hosting_url" ]]; then
    echo -e "${BLUE}[web] Frontend URL:${NC} https://$hosting_url"
  fi
}

setup_infrastructure() {
  echo -e "${BLUE}[infra] Setting up service accounts and permissions...${NC}"
  
  # 1. Ensure SA exists
  if ! gcloud iam service-accounts describe "$SA_BACKEND" >/dev/null 2>&1; then
    gcloud iam service-accounts create backend --display-name "Sanskrite Backend"
    echo -e "${GREEN}[infra] Created service account:${NC} $SA_BACKEND"
  fi
  
  # 2. Grant required roles (idempotent)
  echo -e "${BLUE}[infra] Ensuring IAM permissions...${NC}"
  for role in \
    roles/datastore.user \
    roles/secretmanager.secretAccessor \
    roles/pubsub.admin \
    roles/pubsub.publisher \
    roles/pubsub.subscriber \
    roles/logging.logWriter; do
    gcloud projects add-iam-policy-binding "$PROJECT_ID" \
      --member="serviceAccount:$SA_BACKEND" \
      --role="$role" \
      --condition=None \
      --quiet >/dev/null 2>&1 || true
    echo -e "${GREEN}  ✓${NC} $role"
  done
  
  # 3. Ensure secrets exist (create if missing with placeholder)
  echo -e "${BLUE}[infra] Ensuring secrets exist...${NC}"
  for secret in VERTEX_API_KEY openai_api_key anthropic_api_key deepseek_api_key grok_api_key; do
    if ! gcloud secrets describe "$secret" >/dev/null 2>&1; then
      echo "PLACEHOLDER_UPDATE_ME" | gcloud secrets create "$secret" --data-file=-
      echo -e "${YELLOW}  ⚠${NC} Created placeholder for: $secret (update with real value!)"
    else
      echo -e "${GREEN}  ✓${NC} $secret exists"
    fi
  done

  # 3.5 Ensure GCS bucket for core docs exists
  local docs_bucket="gs://${PROJECT_ID}-core-docs"
  if gcloud storage buckets describe "$docs_bucket" >/dev/null 2>&1; then
    echo -e "${GREEN}[infra] Core docs bucket exists:${NC} $docs_bucket"
  else
    gcloud storage buckets create "$docs_bucket" --location=US --uniform-bucket-level-access
    echo -e "${GREEN}[infra] Created core docs bucket:${NC} $docs_bucket"
  fi
  
  # 4. Ensure Pub/Sub topics exist
  echo -e "${BLUE}[infra] Ensuring Pub/Sub topics...${NC}"
  for topic in \
    discovery.status discovery.profile discovery.answer discovery.project \
    document.process ground.refresh source.poll source.poll.due \
    genai.stream \
    artifact.generation.started artifact.section.generating artifact.section.chunk artifact.section.completed \
    artifact.assembly.started artifact.assembly.chunk artifact.assembly.completed \
    artifact.generation.completed artifact.generation.error \
    analysis.status \
    agent.update \
    verified.stream; do
    if ! gcloud pubsub topics describe "$topic" >/dev/null 2>&1; then
      gcloud pubsub topics create "$topic" --quiet
      echo -e "${GREEN}  ✓${NC} Created topic: $topic"
    else
      echo -e "${GREEN}  ✓${NC} $topic exists"
    fi
  done

  # 5. Ensure Cloud Scheduler job only when deploying API
  if [[ "$TARGET_API" -eq 1 ]]; then
    echo -e "${BLUE}[infra] Ensuring Cloud Scheduler job (optional)...${NC}"
    if gcloud services list --enabled --filter="config.name: cloudscheduler.googleapis.com" --format="value(config.name)" | grep -q cloudscheduler.googleapis.com; then
      JOB_NAME="sanskrite-source-poller"
      SVC_URL=$(gcloud run services describe sanskrite-api --region "$REGION" --format='value(status.url)' 2>/dev/null || true)
      # Ensure admin token env on API (if not set, generate ephemeral weak token for dev; recommend overriding in CI/prod)
      ADMIN_TOKEN=${ADMIN_JOB_TOKEN:-}
      if [[ -z "$ADMIN_TOKEN" ]]; then
        ADMIN_TOKEN=$(openssl rand -hex 12 2>/dev/null || echo dev-admin-token)
        gcloud run services update sanskrite-api --region "$REGION" --update-env-vars "ADMIN_JOB_TOKEN=$ADMIN_TOKEN" --quiet || true
      fi
      if [[ -n "$SVC_URL" ]]; then
        # Create or update a job that calls admin publish-due with header X-Job-Token
        if gcloud scheduler jobs describe "$JOB_NAME" --location="$REGION" >/dev/null 2>&1; then
          gcloud scheduler jobs update http "$JOB_NAME" \
            --location="$REGION" \
            --schedule="*/5 * * * *" \
            --uri="$SVC_URL/api/v1/admin/sources/publish-due" \
            --http-method=POST \
            --update-headers="X-Job-Token=$ADMIN_TOKEN" \
            --attempt-deadline=60s \
            --quiet || true
        else
          gcloud scheduler jobs create http "$JOB_NAME" \
            --location="$REGION" \
            --schedule="*/5 * * * *" \
            --uri="$SVC_URL/api/v1/admin/sources/publish-due" \
            --http-method=POST \
            --headers="X-Job-Token=$ADMIN_TOKEN" \
            --attempt-deadline=60s \
            --quiet || true
        fi
      else
        echo -e "${YELLOW}[infra] Skipping scheduler job (api url not resolved).${NC}"
      fi
    else
      echo -e "${YELLOW}[infra] Cloud Scheduler API not enabled or not available; skipping job creation.${NC}"
    fi
  fi
}

# Clean up old Cloud Run revisions, keeping only the last N
# Usage: cleanup_old_revisions <service-name> <region> <keep-count>
cleanup_old_revisions() {
  local service="$1"
  local region="$2"
  local keep_count="${3:-10}"
  
  echo -e "${BLUE}[cleanup] Cleaning up old revisions for $service (keeping last $keep_count)...${NC}"
  
  # Get active revision (the one receiving traffic)
  local active_revision=$(gcloud run services describe "$service" --region "$region" \
    --format='value(status.traffic[0].revisionName)' 2>/dev/null || echo "")
  
  # Get all revisions sorted by creation time (newest first)
  # Format: REVISION_NAME
  local all_revisions=$(gcloud run revisions list --service="$service" --region="$region" \
    --format='value(metadata.name)' --sort-by='~metadata.creationTimestamp' 2>/dev/null || echo "")
  
  if [[ -z "$all_revisions" ]]; then
    echo -e "${YELLOW}[cleanup] No revisions found for $service${NC}"
    return 0
  fi
  
  # Count total revisions
  local total=$(echo "$all_revisions" | grep -c . || echo "0")
  
  if [[ "$total" -le "$keep_count" ]]; then
    echo -e "${GREEN}[cleanup] Only $total revisions exist (keeping all)${NC}"
    return 0
  fi
  
  # Get revisions to delete (all except the last N, but skip active one)
  local deleted=0
  local skipped_active=0
  
  # Skip first N revisions (the ones to keep) and process the rest
  echo "$all_revisions" | tail -n +$((keep_count + 1)) | while read -r revision_name; do
    if [[ -z "$revision_name" ]]; then
      continue
    fi
    
    if [[ "$revision_name" == "$active_revision" ]]; then
      echo -e "${YELLOW}[cleanup] Skipping active revision: $revision_name${NC}" >&2
      continue
    fi
    
    echo -e "${BLUE}[cleanup] Deleting revision: $revision_name${NC}" >&2
    if gcloud run revisions delete "$revision_name" --region="$region" --quiet 2>/dev/null; then
      echo "deleted" >&2
    else
      echo -e "${YELLOW}[cleanup] Failed to delete $revision_name (may be in use)${NC}" >&2
    fi
  done
  
  echo -e "${GREEN}[cleanup] Cleanup completed for $service${NC}"
}

deploy_api() {
  echo -e "${BLUE}[api] Pre-deployment: validating Go build...${NC}"
  (cd "$API_DIR" && go build -o /dev/null ./cmd/server) || {
    echo -e "${RED}[api] Go build failed! Fix errors before deploying.${NC}"
    exit 1
  }
  echo -e "${GREEN}[api] Go build successful locally${NC}"

  echo -e "${BLUE}[api] Running migration: sourceProjects backfill...${NC}"
  (cd "$API_DIR" && GCP_PROJECT_ID="$PROJECT_ID" GOOGLE_CLOUD_PROJECT="$PROJECT_ID" go run ./cmd/migrate_sources) || echo -e "${YELLOW}[api] Migration skipped/failed (non-fatal).${NC}"
  
  echo -e "${BLUE}[api] Building container image (Artifact Registry)...${NC}"
  local service="sanskrite-api"
  local image="us-central1-docker.pkg.dev/$PROJECT_ID/cloud-run-source-deploy/$service:$(date +%s)"

  # PayPal secrets (optional - PayPal integration will be disabled if not set)
  local paypal_secrets="VERTEX_API_KEY=VERTEX_API_KEY:latest,OPENAI_API_KEY=openai_api_key:latest,ANTHROPIC_API_KEY=anthropic_api_key:latest,DEEPSEEK_API_KEY=deepseek_api_key:latest,GROK_API_KEY=grok_api_key:latest"
  if gcloud secrets describe paypal_client_id >/dev/null 2>&1 && gcloud secrets describe paypal_secret >/dev/null 2>&1; then
    paypal_secrets="$paypal_secrets,PAYPAL_CLIENT_ID=paypal_client_id:latest,PAYPAL_SECRET=paypal_secret:latest"
    if gcloud secrets describe paypal_webhook_id >/dev/null 2>&1; then
      paypal_secrets="$paypal_secrets,PAYPAL_WEBHOOK_ID=paypal_webhook_id:latest"
    fi
  fi

  # Build and push to Artifact Registry
  gcloud builds submit "$API_DIR" \
    --project "$PROJECT_ID" \
    --tag "$image" \
    --quiet

  echo -e "${BLUE}[api] Deploying to Cloud Run from image...${NC}"
  gcloud run deploy "$service" \
    --image "$image" \
    --region "$REGION" \
    --allow-unauthenticated \
    --service-account "$SA_BACKEND" \
    --min-instances=1 \
    --max-instances=3 \
    --cpu=1 \
    --memory=512Mi \
    --set-env-vars "GCP_PROJECT_ID=$PROJECT_ID,GOOGLE_CLOUD_PROJECT=$PROJECT_ID,FRONTEND_ORIGINS=https://hatl.one|https://www.hatl.one|https://*.hatl.one|http://localhost:5173|http://localhost:3000,CORE_DOCS_BUCKET=${PROJECT_ID}-core-docs,ENABLE_INTERNAL_WS_SUBSCRIBER=0,DISABLE_POLLER_TICKER=true,PAYPAL_MODE=live,PAYPAL_RETURN_URL=https://hatl.one/subscription/success,PAYPAL_CANCEL_URL=https://hatl.one/subscription/cancel,PAYPAL_CURRENCY=USD,PAYPAL_LOCALE=ru-KZ,PAYPAL_TAX_PERCENTAGE=12,PAYPAL_TAX_INCLUSIVE=false" \
    --set-secrets "$paypal_secrets" \
    --project "$PROJECT_ID" \
    --quiet

  # Force traffic to latest revision
  echo -e "${BLUE}[api] Routing 100% traffic to latest revision...${NC}"
  gcloud run services update-traffic "$service" \
    --region "$REGION" \
    --to-latest \
    --quiet
  
  # Clean up old revisions (keep last 10)
  cleanup_old_revisions "$service" "$REGION" 10
  
  local current_revision=$(gcloud run services describe "$service" --region "$REGION" --format="value(status.traffic[0].revisionName)")
  echo -e "${GREEN}[api] Traffic routed to:${NC} $current_revision"

  API_URL=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)')
  echo -e "${GREEN}[api] Deployed successfully${NC}"
  echo -e "${BLUE}[api] URL:${NC} $API_URL"
}

deploy_verified_proxy() {
  echo -e "${BLUE}[verified-proxy] Pre-deployment: validating Go build...${NC}"
  (cd "$API_DIR" && go build -o /dev/null ./cmd/verified-proxy) || {
    echo -e "${RED}[verified-proxy] Go build failed! Fix errors before deploying.${NC}"
    exit 1
  }
  echo -e "${GREEN}[verified-proxy] Go build successful locally${NC}"
  
  echo -e "${BLUE}[verified-proxy] Building container image...${NC}"
  local service="verified-proxy"
  
  # Get backend URL and functions key
  local backend_url="${API_URL:-}"
  if [[ -z "$backend_url" ]]; then
    backend_url=$(gcloud run services describe sanskrite-api --region "$REGION" --format='value(status.url)' 2>/dev/null || true)
  fi
  
  if [[ -z "$backend_url" ]]; then
    echo -e "${YELLOW}[verified-proxy] Skipping deployment: backend API URL not available${NC}"
    return
  fi
  
  # Get or create functions key secret
  local functions_key_secret="functions-key"
  if ! gcloud secrets describe "$functions_key_secret" >/dev/null 2>&1; then
    echo -e "${YELLOW}[verified-proxy] Creating placeholder functions-key secret (update with real value!)${NC}"
    echo -n "PLACEHOLDER_UPDATE_ME" | gcloud secrets create "$functions_key_secret" --data-file=-
  fi
  
  # Get allowed origins (same logic as main API)
  # Support FRONTEND_ORIGINS (comma-separated) or FRONTEND_ORIGIN (single)
  local allowed_origins="${FRONTEND_ORIGINS:-}"
  if [[ -z "$allowed_origins" ]]; then
    local single_origin="${FRONTEND_ORIGIN:-https://hatl.one}"
    # Add localhost if not already in the list
    if [[ "$single_origin" != *"localhost"* ]]; then
      allowed_origins="${single_origin},http://localhost:5173"
    else
      allowed_origins="$single_origin"
    fi
  fi
  
  # Generate image tag (timestamp for uniqueness)
  local image_tag=$(date +%s)
  
  # Build and deploy using cloudbuild.yaml
  # Use JSON format for substitutions to handle comma in ALLOWED_ORIGINS
  # Escape the JSON properly for shell
  local allowed_origins_json=$(echo "$allowed_origins" | sed 's/"/\\"/g')
  
  echo -e "${BLUE}[verified-proxy] Starting Cloud Build (this may take a few minutes)...${NC}"
  # Don't pass ALLOWED_ORIGINS in substitutions (comma causes issues), will set after deploy
  gcloud builds submit "$API_DIR" \
    --project "$PROJECT_ID" \
    --config="$API_DIR/cmd/verified-proxy/cloudbuild.yaml" \
    --substitutions=_BACKEND_URL="$backend_url",_FUNCTIONS_KEY="${functions_key_secret}:latest",_IMAGE_TAG="$image_tag" || {
    echo -e "${YELLOW}[verified-proxy] Cloud Build failed, trying direct deploy...${NC}"
    # Fallback: deploy directly from source
    # Note: --source doesn't support --env-vars-file, so use update after deploy
    gcloud run deploy "$service" \
      --source "$API_DIR/cmd/verified-proxy" \
      --region "$REGION" \
      --allow-unauthenticated \
      --service-account "$SA_BACKEND" \
      --min-instances=0 \
      --max-instances=10 \
      --memory=256Mi \
      --timeout=60 \
      --set-secrets "FUNCTIONS_KEY=${functions_key_secret}:latest" \
      --project "$PROJECT_ID" \
      --quiet
    # Update env vars separately (using update-env-vars to preserve existing)
    local env_file=$(mktemp)
    echo "BACKEND_URL=$backend_url" > "$env_file"
    echo "ALLOWED_ORIGINS=$allowed_origins" >> "$env_file"
    gcloud run services update "$service" \
      --region "$REGION" \
      --env-vars-file="$env_file" \
      --project "$PROJECT_ID" \
      --quiet 2>/dev/null || true
    rm -f "$env_file"
  }
  
  # Update env vars after deployment (to set ALLOWED_ORIGINS with comma)
  echo -e "${BLUE}[verified-proxy] Updating environment variables...${NC}"
  local env_file=$(mktemp)
  echo "BACKEND_URL=$backend_url" > "$env_file"
  echo "ALLOWED_ORIGINS=$allowed_origins" >> "$env_file"
  gcloud run services update "$service" \
    --region "$REGION" \
    --env-vars-file="$env_file" \
    --project "$PROJECT_ID" \
    --quiet 2>/dev/null || echo -e "${YELLOW}[verified-proxy] Warning: Failed to update env vars (may need manual update)${NC}"
  rm -f "$env_file"
  
  # Get proxy URL
  echo -e "${BLUE}[verified-proxy] Waiting for service to be ready...${NC}"
  sleep 3
  VERIFIED_PROXY_URL=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)' 2>/dev/null || true)
  if [[ -n "$VERIFIED_PROXY_URL" ]]; then
    echo -e "${GREEN}[verified-proxy] ✓ Deployed successfully${NC}"
    echo -e "${BLUE}[verified-proxy] URL:${NC} $VERIFIED_PROXY_URL"
    echo -e "${YELLOW}[verified-proxy] Note: Update VITE_VERIFIED_PROXY_URL in frontend env: $VERIFIED_PROXY_URL${NC}"
  else
    echo -e "${YELLOW}[verified-proxy] Deployment completed but URL not available (check Cloud Run console)${NC}"
  fi
}

deploy_ws() {
  echo -e "${BLUE}[ws] Pre-deployment: validating Go build...${NC}"
  (cd "$API_DIR" && go build -o /dev/null ./cmd/ws-broker) || {
    echo -e "${RED}[ws] Go build failed! Fix errors before deploying.${NC}"
    exit 1
  }
  echo -e "${GREEN}[ws] Go build successful locally${NC}"

  echo -e "${BLUE}[ws] Building ws-broker image...${NC}"
  local service="sanskrite-ws"
  # Must match cloudbuild.ws.yaml output image
  local image="us-central1-docker.pkg.dev/$PROJECT_ID/sanskrite/sanskrite-ws:latest"

  # Build using cloudbuild with explicit Dockerfile
  gcloud builds submit "$API_DIR" \
    --config="$API_DIR/cloudbuild.ws.yaml" \
    --project "$PROJECT_ID" \
    --quiet

  echo -e "${BLUE}[ws] Deploying ws-broker to Cloud Run...${NC}"
  gcloud run deploy "$service" \
    --image "$image" \
    --region "$REGION" \
    --allow-unauthenticated \
    --service-account "$SA_BACKEND" \
    --min-instances=1 \
    --max-instances=2 \
    --cpu=1 \
    --memory=256Mi \
    --timeout=3600s \
    --set-env-vars "GCP_PROJECT_ID=$PROJECT_ID,GOOGLE_CLOUD_PROJECT=$PROJECT_ID" \
    --project "$PROJECT_ID" \
    --quiet

  # Route traffic to latest revision
  gcloud run services update-traffic "$service" --region "$REGION" --to-latest --quiet
  
  # Clean up old revisions (keep last 10)
  cleanup_old_revisions "$service" "$REGION" 10

  WS_URL=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)')
  echo -e "${GREEN}[ws] Deployed successfully${NC}"
  echo -e "${BLUE}[ws] URL:${NC} $WS_URL"
}

deploy_py() {
  echo -e "${BLUE}[py] Deploying Telegram service to Cloud Run...${NC}"
  local service="sanskrite-telegram"
  local SRC_DIR="$ROOT_DIR/python/telegram_service"
  gcloud run deploy "$service" \
    --source "$SRC_DIR" \
    --region "$REGION" \
    --allow-unauthenticated \
    --min-instances=0 \
    --max-instances=3 \
    --cpu=1 \
    --memory=256Mi \
    --set-secrets "TELEGRAM_API_ID=TELEGRAM_API_ID:latest,TELEGRAM_API_HASH=TELEGRAM_API_HASH:latest,TELEGRAM_SESSION_STRING=TELEGRAM_SESSION_STRING:latest,TELEGRAM_BOT_TOKEN=TELEGRAM_BOT_TOKEN:latest" \
    --project "$PROJECT_ID" \
    --quiet
  
  # Route traffic to latest revision (if not already)
  gcloud run services update-traffic "$service" --region "$REGION" --to-latest --quiet 2>/dev/null || true
  
  # Clean up old revisions (keep last 10)
  cleanup_old_revisions "$service" "$REGION" 10
  
  echo -e "${GREEN}[py] Deployed successfully${NC}"
  TG_URL=$(gcloud run services describe "$service" --region "$REGION" --format='value(status.url)')
  echo -e "${BLUE}[py] URL:${NC} $TG_URL"
  
  # Update backend with TELEGRAM_SERVICE_URL
  if [[ "$TARGET_API" -eq 1 ]] || gcloud run services describe sanskrite-api --region "$REGION" >/dev/null 2>&1; then
    echo -e "${BLUE}[api] Updating backend with TELEGRAM_SERVICE_URL...${NC}"
    gcloud run services update sanskrite-api \
      --region "$REGION" \
      --update-env-vars "TELEGRAM_SERVICE_URL=$TG_URL" \
      --quiet || true
  fi
}

create_indexes() {
  echo -e "${BLUE}[firestore] Creating composite indexes (idempotent)...${NC}"
  # Projects: tenantId + view + lastInteractionAt desc
  gcloud firestore indexes composite create \
    --collection-group=core_projects \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=view,order=ASCENDING \
    --field-config field-path=lastInteractionAt,order=DESCENDING \
    --quiet || true
  # DataSources suggestions (uri canonical, channel username)
  gcloud firestore indexes composite create \
    --collection-group=core_datasources \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=sourceDetails.uri,order=ASCENDING \
    --quiet || true
  gcloud firestore indexes composite create \
    --collection-group=core_datasources \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=sourceDetails.channelUsername,order=ASCENDING \
    --quiet || true
  # Interactions: projectId + createdAt asc (for listing by project with ordering)
  gcloud firestore indexes composite create \
    --collection-group=core_interactions \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=createdAt,order=ASCENDING \
    --quiet || true

  # Core docs: tenant+project for quick listing within project, newest first
  gcloud firestore indexes composite create \
    --collection-group=core_docs \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true

  # Core docs: lookup by external provider+resource id (optional future use)
  gcloud firestore indexes composite create \
    --collection-group=core_docs \
    --field-config field-path=external.provider,order=ASCENDING \
    --field-config field-path=external.resourceId,order=ASCENDING \
    --quiet || true

  # RAG: sourceProjects composites
  gcloud firestore indexes composite create \
    --collection-group=rag_source_projects \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --quiet || true
  gcloud firestore indexes composite create \
    --collection-group=rag_source_projects \
    --field-config field-path=sourceId,order=ASCENDING \
    --field-config field-path=status,order=ASCENDING \
    --quiet || true

  # RAG: documents lookups
  gcloud firestore indexes composite create \
    --collection-group=rag_documents \
    --field-config field-path=sourceId,order=ASCENDING \
    --field-config field-path=originPublishedAt,order=DESCENDING \
    --quiet || true
  gcloud firestore indexes composite create \
    --collection-group=rag_documents \
    --field-config field-path=sourceId,order=ASCENDING \
    --field-config field-path=externalId,order=ASCENDING \
    --quiet || true

  # Meta analyses: events by project (latest first)
  gcloud firestore indexes composite create \
    --collection-group=meta_analyses \
    --field-config field-path=projectId,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true
  # Meta analyses: events by user within tenant (latest first)
  gcloud firestore indexes composite create \
    --collection-group=meta_analyses \
    --field-config field-path=tenantId,order=ASCENDING \
    --field-config field-path=userId,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true

  # Subscriptions: status + currentPeriodEnd for billing queries
  gcloud firestore indexes composite create \
    --collection-group=subscriptions \
    --field-config field-path=status,order=ASCENDING \
    --field-config field-path=currentPeriodEnd,order=ASCENDING \
    --quiet || true

  # Vouchers: tier + isActive + createdAt for admin filtering
  gcloud firestore indexes composite create \
    --collection-group=vouchers \
    --field-config field-path=tier,order=ASCENDING \
    --field-config field-path=isActive,order=ASCENDING \
    --field-config field-path=createdAt,order=DESCENDING \
    --quiet || true

  # Vector field for rag_chunks.embedding (dimension=1536, COSINE)
  # Requires gcloud alpha (as of now). If not available, skip with a notice.
  if gcloud alpha --help >/dev/null 2>&1; then
    echo -e "${BLUE}[firestore] Ensuring vector field config for rag_chunks.embedding...${NC}"
    gcloud alpha firestore indexes fields create \
      --collection-group=rag_chunks \
      --field-path=embedding \
      --vector-config=dimension=1536,distance-measure=COSINE \
      --quiet || true
  else
    echo -e "${YELLOW}[firestore] Skipping vector field create (gcloud alpha not available). Index present in backend/firestore.indexes.json${NC}"
  fi

  # Verify meta_analyses indexes presence (best-effort)
  echo -e "${BLUE}[firestore] Verifying meta_analyses composite indexes...${NC}"
  local meta_list_json
  if meta_list_json=$(gcloud firestore indexes composite list --collection-group=meta_analyses --format=json 2>/dev/null); then
    local has_proj
    local has_user
    has_proj=$(echo "$meta_list_json" | grep -c '"projectId"' || true)
    has_user=$(echo "$meta_list_json" | grep -c '"userId"' || true)
    if [[ "$has_proj" -gt 0 && "$has_user" -gt 0 ]]; then
      echo -e "${GREEN}  ✓${NC} meta_analyses indexes detected"
    else
      echo -e "${YELLOW}  ⚠${NC} meta_analyses indexes not fully visible yet (Firestorm propagation may take minutes)."
    fi
  else
    echo -e "${YELLOW}  ⚠${NC} Unable to list composite indexes for meta_analyses (insufficient permissions or API)."
  fi
}

# Setup infrastructure only on full deploy or explicit check
# Individual service deploys (--api, --ws, --verified-proxy, --py) skip infra checks for speed
if [[ "$TARGET_CHECK_INFRA" -eq 1 ]]; then
  setup_infrastructure
  create_indexes
  echo -e "${GREEN}[infra] Infrastructure checks completed${NC}"
  exit 0
elif [[ "$TARGET_WEB" -eq 1 && "$TARGET_API" -eq 1 && "$TARGET_PY" -eq 0 && "$TARGET_WS" -eq 0 && "$TARGET_VERIFIED_PROXY" -eq 0 ]]; then
  # Full deploy: run infrastructure checks
  setup_infrastructure
fi

if [[ "$TARGET_WEB" -eq 1 ]]; then
  deploy_web
fi

if [[ "$TARGET_API" -eq 1 ]]; then
  deploy_api
fi

if [[ "$TARGET_WS" -eq 1 ]]; then
  deploy_ws
fi

if [[ "$TARGET_PY" -eq 1 ]]; then
  deploy_py
fi

if [[ "$TARGET_VERIFIED_PROXY" -eq 1 ]]; then
  deploy_verified_proxy
fi

# Firestore indexes are only relevant for backend; skip for web-only
# Create indexes only on full deploy (already handled in --check-infra path above)
if [[ "$TARGET_WEB" -eq 1 && "$TARGET_API" -eq 1 && "$TARGET_PY" -eq 0 && "$TARGET_WS" -eq 0 && "$TARGET_VERIFIED_PROXY" -eq 0 ]]; then
  if [[ "$TARGET_API" -eq 1 || "$TARGET_PY" -eq 1 ]]; then
    create_indexes
  fi
fi

echo ""
echo -e "${GREEN}═══════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}✓ Deployment Complete${NC}"
echo -e "${GREEN}═══════════════════════════════════════════════════════${NC}"

# Summary
if [[ "$TARGET_API" -eq 1 ]] && [[ -n "${API_URL:-}" ]]; then
  echo -e "${BLUE}Backend API:${NC} $API_URL"
fi
if [[ "$TARGET_VERIFIED_PROXY" -eq 1 ]] && [[ -n "${VERIFIED_PROXY_URL:-}" ]]; then
  echo -e "${BLUE}Verified Proxy:${NC} $VERIFIED_PROXY_URL"
fi
if [[ "$TARGET_WS" -eq 1 ]] && [[ -n "${WS_URL:-}" ]]; then
  echo -e "${BLUE}WS Broker:${NC} $WS_URL"
fi
if [[ "$TARGET_PY" -eq 1 ]] && [[ -n "${TG_URL:-}" ]]; then
  echo -e "${BLUE}Telegram Service:${NC} $TG_URL"
fi
if [[ "$TARGET_WEB" -eq 1 ]]; then
  echo -e "${BLUE}Web Static:${NC} gs://${PROJECT_ID}-web-static"
fi

echo ""
echo -e "${YELLOW}Post-deployment checklist:${NC}"
echo -e "  ☐ Verify secrets have real API keys (not placeholders)"
if [[ "$TARGET_API" -eq 1 ]]; then
  echo -e "  ☐ Update functions-key secret with real value: gcloud secrets versions add functions-key --data-file=-"
fi
if [[ "$TARGET_VERIFIED_PROXY" -eq 1 ]]; then
  if [[ -n "${VERIFIED_PROXY_URL:-}" ]]; then
    echo -e "  ☐ Update VITE_VERIFIED_PROXY_URL in frontend: $VERIFIED_PROXY_URL"
  fi
fi
echo -e "  ☐ Test API health: curl \$API_URL/health"
echo -e "  ☐ Check Cloud Run logs for errors"
echo -e "  ☐ Verify traffic is on latest revision"
echo ""

