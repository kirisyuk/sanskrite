rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /core_users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /core_projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /core_datasources/{dsId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // RAG collections (server-side access; rules permissive for backend)
    match /rag_source_projects/{id} {
      allow read, write: if isSignedIn();
    }
    match /rag_documents/{id} {
      allow read, write: if isSignedIn();
    }
    match /rag_chunks/{id} {
      allow read, write: if isSignedIn();
    }
    match /rag_rules/{id} {
      allow read, write: if isSignedIn();
    }
    match /rag_jobs/{id} {
      allow read, write: if isSignedIn();
    }
    match /rag_search_events/{id} {
      allow read, write: if isSignedIn();
    }

    // Horizon collections (server-side access; rules permissive for backend)
    match /horizon_fragments/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Backend creates/updates via service account
    }
    match /horizon_frames/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Backend creates via Scout Engine
    }
    match /horizon_lenses/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Users create/update via API
    }
    match /horizon_dependency_edges/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Backend creates/updates via Propagation Engine
    }
    match /horizon_watchdog_configs/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Backend manages via Watchdog Service
    }
    match /horizon_fragment_versions/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Backend creates versions automatically
    }
  }
}


