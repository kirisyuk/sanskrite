# Go build artifacts
bin/
build/
server
main
verified-proxy
hatlone-ws
test-agent-orchestrator
*.exe
*.dll
*.dylib
*.test
*.out
# All Go binaries (catch-all)
cmd/*/main
cmd/*/server
cmd/*/verified-proxy
cmd/*/hatlone-ws

# Local tool binaries produced by `go build` / `go install` for cmd/tools (often 40-80MB each)
horizon_*
add_*
check_*
check-*
seed_*
migrate_*
inspect_*
purge_*
geonames_*
loc_*
watchdog_*
test_*
test-*
sync-*
reindex-*
update-*
clear_*
run_*
find_*
gemini_*
openai_*

# Log files
*.log

# Local data dumps / experiments (can be huge; never needed for container builds)
*.jsonl
*.duration.txt
*.csv

# Temp
tmp/
temp/

# Git
.git/
.gitignore
# OS/editor
.DS_Store
Thumbs.db
# Local env
.env
# Node leftovers
node_modules/
**/node_modules/
backend/
# Tests & cache
coverage/
**/*_test.go
# Service account keys should not be uploaded by default
*.json
# Keep sources
!go.mod
!go.sum
!cmd/**
!internal/**
