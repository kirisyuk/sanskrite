*.test
*.out
*.bin
*.prof
*.pprof
**/*.test
**/*.out
**/*.bin
**/*.prof
**/*.pprof
internal/**/*.test
# Temporary local command packages that should never be shipped
cmd/tmp_*/
cmd/tmp_*/**

# Local tool binaries produced by `go build` / `go install` for cmd/tools (often 40-80MB each)
/horizon_*
/supply_chain_*
/unstuck_*
/add_*
/check_*
/check-*
/seed_*
/migrate_*
/inspect_*
/purge_*
/geonames_*
/loc_*
/watchdog_*
/test_*
/test-*
/sync-*
/reindex-*
/update-*
/clear_*
/run_*
/find_*
/gemini_*
/openai_*

# Log files
*.log
firebase-debug.log

# Local data dumps / experiments (can be huge; never needed for container builds)
*.jsonl
*.duration.txt
*.csv

# Temp
tmp/
temp/

# Git
.git/
.gitignore
# OS/editor
.DS_Store
Thumbs.db
# Local env
.env
# Node leftovers
node_modules/
**/node_modules/
# Tests & cache
coverage/
**/*_test.go
# Root-level JSON dumps and service account keys should not be uploaded by default.
# Runtime package data lives under internal/** and must remain available for go:embed.
/*.json
!internal/horizon/mapactivity/data/*.json
