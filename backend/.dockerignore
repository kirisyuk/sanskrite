# Ignore build artifacts and service binaries
/server
/verified-proxy
/nv_horizon_ws
/main
*.exe
*.dll
*.dylib
*.test
*.out

# Local tool binaries (can be very large; not needed for Docker builds)
# Go build outputs from cmd/tools/* and cmd/* - exclude all known patterns
/horizon_*
/supply_chain_*
/unstuck_*
/add_*
/check_*
/check-*
/seed_*
/migrate_*
/inspect_*
/purge_*
/geonames_*
/loc_*
/watchdog_*
/test_*
/test-*
/sync-*
/reindex-*
/update_*
/clear_*
/run_*
/find_*
/gemini_*
/openai_*

# Local build artifacts and caches
bin/
build/

# Local data dumps / experiments
*.jsonl
*.duration.txt
*.csv
*.log

# Ignore vendor if exists
vendor/

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore temp files
tmp/
temp/
